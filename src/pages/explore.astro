---
import { asset } from '../lib/paths';

// /explore/ was the corridor map; it is part of /map/ now. Kept as a way
// through for links and bookmarks that still point here, carrying ?at along.
const to = asset('/map/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>EcoScapes map</title>
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <script is:inline define:vars={{ to }}>location.replace(to + location.search + location.hash);</script>
  </head>
  <body><a href={to}>The map</a></body>
</html>
