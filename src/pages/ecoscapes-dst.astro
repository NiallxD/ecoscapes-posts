---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import 'maplibre-gl/dist/maplibre-gl.css';
import Shell from '../layouts/Shell.astro';
import { asset, tile } from '../lib/paths';
import layersData from '../data/dst-layers.json';
// The longer text behind each layer's (i), kept as Markdown for the team to
// edit: a `## Layer name` heading, paragraphs, then a `Source:` line.
import descriptionsMd from '../data/layer-descriptions.md?raw';

/** The Data Sandbox (DST): the RRN demo's weighted, fuzzy scoring, on this
 *  region's own layers. Where /map/ shows each layer as it is, this page asks
 *  what matters and how much, and colours the whole area by how well each
 *  place fits. Every layer is a file of real values (tools/prepare-value-
 *  layer.py) scored on the GPU as the sliders move -- no server. A demo: the
 *  presets are examples, not anyone's recommendation. */
const entry = await getEntry('ecoscapes', 'sea-to-sky');
if (!entry) throw new Error('src/content/ecoscapes/sea-to-sky.md is missing');
const { data } = entry;

type Detail = { text: string[]; source: string; href: string };
function readDescriptions(md: string) {
  const idOf = new Map(layersData.map((l) => [l.name, l.id]));
  const out: Record<string, Detail> = {};
  for (const part of md.split(/^## /m).slice(1)) {
    const [head, ...rest] = part.split('\n');
    const id = idOf.get(head.trim());
    if (!id) throw new Error(`src/data/layer-descriptions.md: "${head.trim()}" is not the name of a layer in the Data Sandbox`);
    // Up to the next group heading, if there is one.
    const body = rest.join('\n').split(/^# /m)[0];
    const src = body.match(/^Source:\s*(.+)$/m)?.[1].trim() ?? '';
    const link = src.match(/^\[(.+?)\]\((.+?)\)$/);
    out[id] = {
      text: body
        .replace(/^Source:.*$/m, '')
        .split(/\n\s*\n/)
        .map((p) => p.replace(/\s*\n\s*/g, ' ').trim())
        .filter(Boolean),
      source: link ? link[1] : src,
      href: link ? link[2] : '',
    };
  }
  return out;
}
const details = readDescriptions(descriptionsMd);

// The cards shown while a flyover is made into a video: a `## Title`, then
// `Image:` and `Seconds:` lines, then text (src/data/flyover-cards/cards.md,
// with its pictures beside it).
import cardsMd from '../data/flyover-cards/cards.md?raw';
const cardImages = import.meta.glob<ImageMetadata>('../data/flyover-cards/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true, import: 'default' });
async function readCards(md: string) {
  const cards = [];
  for (const part of md.split(/^## /m).slice(1)) {
    const [head, ...rest] = part.split('\n');
    let body = rest.join('\n');
    const file = body.match(/^Image:\s*(.+)$/im)?.[1].trim();
    const seconds = Number(body.match(/^Seconds:\s*(.+)$/im)?.[1]) || 8;
    body = body.replace(/^(Image|Seconds):.*$/gim, '');
    let image = '';
    let tall = false;
    if (file) {
      const meta = cardImages[`../data/flyover-cards/${file}`];
      if (!meta) throw new Error(`src/data/flyover-cards/cards.md: "${head.trim()}" wants ${file}, which is not in src/data/flyover-cards/`);
      // Landscape pictures across the top, portrait ones beside the text.
      tall = meta.height > meta.width;
      image = (await getImage({ src: meta, width: Math.min(tall ? 900 : 1600, meta.width), format: 'webp', quality: 80 })).src;
    }
    cards.push({
      title: head.trim(),
      image,
      tall,
      seconds,
      text: body
        .split(/\n\s*\n/)
        .map((t) => t.replace(/\s*\n\s*/g, ' ').trim())
        .filter(Boolean),
    });
  }
  return cards;
}
const cards = await readCards(cardsMd);

const config = {
  bounds: data.bounds,
  limit: data.limit,
  basemap: tile(data.basemap),
  terrain: tile('/tiles/terrain.pmtiles'),
  glyphs: asset('/tiles/fonts/{fontstack}/{range}.pbf'),
  logo: asset('/img/ecoscapes-logo-white.png'),
  emblem: asset('/img/ecoscapes-emblem.png'),
  cards,
  layers: layersData.map((l) => ({
    ...l,
    src: tile(l.src),
    sampleSrc: tile(l.sampleSrc),
    detail: details[l.id],
  })),
};
---
<Shell title="EcoScapes Data Sandbox" description="Choose what matters and how much, and see where across the Sea-to-Sky fits best.">
  <!-- On a phone: not the tool, which needs the room, but a way to send
       yourself the link for later, and the map to look at now. iPads and
       computers never see this. -->
  <section class="phone-gate" aria-labelledby="gate-title">
    <img class="gate-logo" src={asset('/img/ecoscapes-logo-white.png')} alt="EcoScapes" width="800" height="184" />
    <p class="eyebrow">Data Sandbox</p>
    <h1 id="gate-title">This one needs a bigger screen</h1>
    <p>The Data Sandbox is designed for a computer or a tablet. Send yourself the link and open it there, or take a look at our map explorer on your phone now.</p>
    <a class="gate-btn gate-main" id="gate-mail" href="mailto:">Email me the link</a>
    <!-- A shared model (a link or a scanned code) can be seen here as a
         picture: the full map image, drawn on the phone when asked. -->
    <button class="gate-btn" id="gate-see" type="button" hidden>See this map on your phone</button>
    <p class="gate-busy" id="gate-busy" role="status" hidden>Drawing the map… this takes a few seconds.</p>
    <a class="gate-btn" href={asset('/map/')}>Open the map</a>
    <a class="gate-home" href={asset('/')}>All the posts</a>
    <!-- The email's address filled in here, on its own: the page's main
         script has the whole map library to load first, and the button must
         work whether or not that ever runs. -->
    <script is:inline>
      document.getElementById('gate-mail').href =
        'mailto:?subject=' + encodeURIComponent('EcoScapes Data Sandbox') +
        '&body=' + encodeURIComponent('Open the EcoScapes Data Sandbox on a computer or tablet:\n\n' + location.href + '\n');
      if (/^#[mz]=/.test(location.hash)) document.getElementById('gate-see').hidden = false;
    </script>
  </section>
  <!-- The picture, once drawn: the page itself pinches to zoom it. -->
  <section class="phone-view" id="phone-view" hidden>
    <div class="view-bar">
      <button type="button" class="gate-btn" id="view-back">Back</button>
      <a class="gate-btn gate-main" id="view-save" href="#">Save image</a>
    </div>
    <p class="view-hint">Pinch to zoom in. Open the link on a computer or tablet to change it.</p>
    <img id="view-img" alt="The map for this sandbox, with its key and layers" />
  </section>
  <main class="dst-page">
    <div class="map" id="map" data-config={JSON.stringify(config)}></div>
    <!-- A flyover made into a video, played over the map. -->
    <video class="fly-video" id="fly-video" muted playsinline hidden></video>

    <!-- Down the left on a wider screen: the panel, and the legend under it. -->
    <div class="left-col">
    <section class="dst-panel" id="panel" aria-labelledby="panel-title">
      <header class="panel-head">
        <div>
          <img class="panel-logo" src={asset('/img/ecoscapes-logo-white.png')} alt="EcoScapes" width="800" height="184" />
          <p class="eyebrow">Data Sandbox · demo</p>
          <h1 id="panel-title">What matters here?</h1>
        </div>
        <button class="fold" id="share" type="button" aria-label="Copy a link to this sandbox" title="Copy a link to this sandbox">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1" /></svg>
        </button>
        <button class="fold" id="fold" type="button" aria-expanded="true" aria-controls="panel-body" aria-label="Fold the panel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>
      </header>
      <div class="panel-body" id="panel-body">
        <p class="lede">Choose the layers which you are interested in analysing. Configure how much you value each layers contribution to the analysis. The map lights up in response to your configuration. Click any location on the map to read how each layer contributes.</p>

        <!-- The three settings folded to a line each until opened, what is
             chosen in each shown beside its name. -->
        <details class="block fold-block" name="settings">
          <summary><h2>Start from an example</h2><span class="sum-val" id="preset-val"></span><svg class="sum-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></summary>
          <p class="sec-desc">Load a preconfigured map based around key themes.</p>
          <div class="chips" id="presets"></div>
          <p class="op-note" id="preset-note"></p>
        </details>

        <details class="block fold-block" name="settings">
          <summary><h2>Bivariate</h2><span class="sum-val" id="mode-val"></span><svg class="sum-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></summary>
          <p class="sec-desc">Enable bivariate grouping to split the data into two groups, then plot them together into a bivariate map. This shows how much two variables agree or disagree about an area.</p>
          <div class="seg seg-2" id="mode" role="radiogroup" aria-label="Single or bivariate">
            <button type="button" role="radio" data-mode="one">Single</button>
            <button type="button" role="radio" data-mode="two">Bivariate</button>
          </div>
          <p class="op-note" id="mode-note"></p>
        </details>

        <details class="block fold-block" name="settings">
          <summary><h2>Calculation type</h2><span class="sum-val" id="op-val"></span><svg class="sum-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></summary>
          <p class="sec-desc">When showing multiple data layers, you can choose how those layers are combined. Hover over each to learn more.</p>
          <div class="seg" id="op" role="radiogroup" aria-label="How the layers combine">
            <button type="button" role="radio" data-op="mean">Weigh up</button>
            <button type="button" role="radio" data-op="and">All must pass</button>
            <button type="button" role="radio" data-op="or">Any one</button>
          </div>
          <p class="op-note" id="op-note"></p>
        </details>

        <div class="block">
          <h2>Layers</h2>
          <div id="criteria"></div>
        </div>
      </div>
    </section>

      <!-- What the map's colours and marks mean, folded to its title when
           not wanted. -->
      <details class="legend" id="legend" open>
        <summary><h2>Legend</h2><svg class="sum-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></summary>
        <div class="lg-one">
          <i class="lg-ramp"></i>
          <div class="lg-ends"><span>Poor fit</span><span>Best fit</span></div>
        </div>
        <div class="lg-two">
          <div class="lg-bi">
            <div class="lg-bi-grid" id="lg-bi-grid" aria-hidden="true"></div>
            <div class="lg-bi-axes"><span id="lg-bi-y"></span><span id="lg-bi-x"></span></div>
          </div>
        </div>
        <ul class="lg-list">
          <li><i class="sw sw-none"></i>No data for these layers</li>
          <li><i class="sw sw-pin">1</i>Best places</li>
          <li><i class="sw sw-drawn"></i>An area you have drawn</li>
          <li><i class="sw sw-town">Aa</i>Towns</li>
          <li><i class="sw sw-road"></i>Roads</li>
          <li><i class="sw sw-edge"></i>Edge of the study area</li>
        </ul>
      </details>
    </div>

    <!-- The result in numbers, and the key to the map's colours: the spread
         of scores is drawn in the map's own ramp, so it is both. -->
    <aside class="key" aria-labelledby="key-title">
      <div class="key-head">
        <div class="key-title">
          <h2 id="key-title">How much fits</h2>
          <!-- Minimised to its title, out of the way of the map. -->
          <button class="fold key-fold" id="key-fold" type="button" aria-expanded="true" aria-label="Minimise">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
          </button>
        </div>
        <div class="seg seg-sm" id="scope" role="radiogroup" aria-label="Count across">
          <button type="button" role="radio" data-scope="region" aria-checked="true">Whole area</button>
          <button type="button" role="radio" data-scope="view" aria-checked="false">This view</button>
          <button type="button" role="radio" data-scope="area" aria-checked="false" title="Draw an area on the map and count inside it">Draw</button>
        </div>
      </div>
      <p class="key-solo" id="key-solo" hidden></p>
      <div class="key-one">
        <p class="big"><b id="pct">–</b><span id="km"></span></p>
        <div class="spread" id="spread" aria-hidden="true"></div>
        <div class="key-ends"><span>Poor fit</span><span>Best fit</span></div>
        <label class="key-op"><span>Counts as a good fit from <output id="cut-out">70</output></span>
          <input id="cut" type="range" min="5" max="95" step="5" value="70" /></label>
        <label class="key-check"><input id="only" type="checkbox" /> Only show places above it</label>
        <label class="key-check" id="steady-label"><input id="steady-on" type="checkbox" /> Show how steady it is</label>
        <div class="steady" id="steady" hidden>
          <p>Every weight nudged up and down, sixteen times over. Brightest where a place stays a good fit however the weights shift; dim where it hinges on exactly how they were set.</p>
          <div class="steady-rows" id="steady-rows"></div>
        </div>
      </div>
      <!-- Two scores: the nine-cell key, which is also the numbers -- each
           cell's area on hover, and a click shows that cell alone. -->
      <div class="key-two">
        <p class="big"><b id="bi-pct">–</b><span id="bi-km"></span></p>
        <div class="bi">
          <span class="bi-y" id="bi-y"></span>
          <div class="bi-grid" id="bi-grid" role="group" aria-label="The nine combinations"></div>
          <span class="bi-x" id="bi-x"></span>
        </div>
        <p class="bi-hint">Hover a square for its area. Click to show it alone.</p>
        <div class="bi-brk" id="bi-brk"></div>
      </div>
      <label class="key-op">Strength <input id="opacity" type="range" min="0.2" max="1" step="0.05" value="0.85" /></label>
      <p class="key-foot" id="key-foot"></p>
    </aside>
    <!-- The flyover's views, in the numbers' place while it is open: views
         added one by one, then flown through in order, the panels out of
         the way. -->
    <div class="pop-menu fly-menu" id="fly-menu" hidden>
      <p class="pop-title">Flyover</p>
      <p class="best-note" id="fly-note"></p>
      <ol class="fly-list" id="fly-list"></ol>
      <button type="button" class="fly-add" id="fly-add">+ Add this view</button>
      <label class="fly-speed">Speed <input id="fly-speed" type="range" min="0.4" max="2" step="0.1" value="1" /></label>
      <div class="fly-row">
        <button type="button" class="fly-play" id="fly-play" title="Made into a video first, so it plays perfectly smoothly">Play</button>
        <button type="button" id="fly-live" title="Flown on the live map, straight away">Live</button>
        <button type="button" id="fly-clear">Clear</button>
      </div>
      <button type="button" class="fly-save" id="fly-save" hidden>Save the video</button>
    </div>

    <div class="map-side">
      <!-- Flat, or the scores laid over the ground's own shape. -->
      <!-- The tilt, sliding out of the button while 3D is on: a mouse's
           way to it (a right-drag also tilts). Not on a touch screen, where
           two fingers do it. -->
      <div class="tilt-wrap">
        <label class="tilt" id="tilt" aria-hidden="true">
          <span>Tilt</span>
          <input type="range" min="0" max="80" step="1" value="60" tabindex="-1" aria-label="Tilt" />
        </label>
        <button class="step" id="three-d" type="button" aria-pressed="false" aria-label="3D view" title="3D view"><span class="step-text">3D</span></button>
      </div>
      <!-- The colours the score is drawn in. -->
      <div class="pal-wrap" id="pal-wrap">
        <div class="pal-menu" id="pal-menu" role="radiogroup" aria-label="Colours" hidden></div>
        <button class="step" id="pal-btn" type="button" aria-expanded="false" aria-controls="pal-menu" aria-label="Colours" title="Colours">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a9 9 0 100 18c1 0 1.6-.8 1.6-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.7 1.7-1.7H16a5 5 0 005-5C21 6.6 17 3 12 3z" />
            <circle cx="7.5" cy="11" r="1.1" fill="currentColor" /><circle cx="10.5" cy="7.3" r="1.1" fill="currentColor" /><circle cx="15" cy="7.8" r="1.1" fill="currentColor" />
          </svg>
        </button>
      </div>
      <!-- The strongest places for the model as it stands: numbered on the
           map, named by the nearest town, and toured as soon as they open. -->
      <div class="pop-wrap">
        <div class="pop-menu best-menu" id="best-menu" hidden>
          <p class="pop-title">Best places</p>
          <ol class="best-list" id="best-list"></ol>
          <p class="best-note" id="best-note"></p>
        </div>
        <button class="step" id="best-btn" type="button" aria-expanded="false" aria-controls="best-menu" aria-label="Best places" title="Best places">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.8l-5.2 2.8 1-5.8-4.3-4.1 5.9-.9z" />
          </svg>
        </button>
      </div>
      <!-- A flyover: its views in the numbers' place (after .key). -->
      <div class="pop-wrap">
        <button class="step" id="fly-btn" type="button" aria-expanded="false" aria-controls="fly-menu" aria-label="Flyover" title="Flyover">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="5" cy="18" r="2" /><circle cx="19" cy="6" r="2" /><path d="M6.8 17c4-1 2.5-6 6-7.5 1.6-.7 3-1.3 4.4-2.3" stroke-dasharray="2.2 2.4" />
          </svg>
        </button>
      </div>
      <!-- Sharing it: the whole area as a finished map, the view as it is,
           the numbers, or a code that opens this model. -->
      <div class="pop-wrap" id="save-wrap">
        <div class="pop-menu" id="save-menu" hidden>
          <button type="button" data-save="full">Full map<small>The whole area, with its key</small></button>
          <button type="button" data-save="view">This view<small>The map as it is on screen</small></button>
          <button type="button" data-save="csv">Numbers (CSV)<small>The model and the areas</small></button>
          <button type="button" data-save="qr">QR code<small>Opens this sandbox on a phone or tablet</small></button>
        </div>
        <button class="step" id="save-btn" type="button" aria-expanded="false" aria-controls="save-menu" aria-label="Share" title="Share">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 15V3.5M8 7.5l4-4 4 4" /><path d="M8.5 10.5H6a1 1 0 00-1 1V20a1 1 0 001 1h12a1 1 0 001-1v-8.5a1 1 0 00-1-1h-2.5" />
          </svg>
        </button>
      </div>
      <button class="step" id="here" type="button" aria-label="Score where I am" title="Score where I am">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3" />
        </svg>
      </button>
      <a class="step" id="to-map" href={asset('/map/')} aria-label="Back to the map">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3.5l8.5 4.5-8.5 4.5L3.5 8z" /><path d="M3.5 12l8.5 4.5 8.5-4.5" /><path d="M3.5 16l8.5 4.5 8.5-4.5" />
        </svg>
      </a>
      <a class="step" id="home" href={asset('/')} aria-label="All the posts">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5L12 4l8 6.5V19a1 1 0 01-1 1h-4.5v-5.5h-5V20H5a1 1 0 01-1-1z" /></svg>
      </a>
    </div>

    <!-- Over the map while the flight's tiles load, its path flown once. -->
    <div class="fly-cover" id="fly-cover" hidden>
      <!-- Something to look at while it is made: the cards in turn. -->
      <figure class="fly-card" id="fly-card" hidden>
        <!-- Two pictures in a frame of fixed shape: the next decoded before
             it fades in over the last, so nothing moves or half-draws. -->
        <div class="fly-pics"><img alt="" /><img alt="" /></div>
        <figcaption><h2></h2><div></div></figcaption>
      </figure>
      <p><b>Getting the flight ready</b> <span>0%</span></p>
      <div class="fly-bar" aria-hidden="true"><i></i></div>
      <small></small>
    </div>
    <!-- A view's callout, pinned to its spot as the live flight passes it
         (a video has it drawn in). -->
    <div class="fly-callout" id="fly-callout" hidden><div><h3></h3><p></p></div></div>
    <button class="fly-stop" id="fly-stop" type="button" hidden>Stop the flyover</button>
    <div class="loading-bar" id="loading-bar" aria-hidden="true"></div>
    <p class="toast" id="toast" role="status" aria-live="polite" hidden></p>
  </main>
</Shell>

<style>
  .dst-page { position: relative; height: 100dvh; overflow: hidden; }
  /* A phone, upright or on its side: a touch screen under 600px either way.
     The same test is in the script, which then stops before the map. */
  .phone-gate { display: none; }
  @media (pointer: coarse) and (max-width: 599px), (pointer: coarse) and (max-height: 599px) {
    .dst-page { display: none; }
    .phone-gate {
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.9rem;
      max-width: 26rem;
      margin: 0 auto;
      padding: calc(var(--safe-t, 0px) + 2rem) 1.5rem 2rem;
      background: var(--bg);
    }
  }
  /* Drawing the picture: the map there to draw, but not seen. */
  :global(html.phone-render) .dst-page { display: block; position: fixed; inset: 0; opacity: 0; pointer-events: none; z-index: -1; }
  :global(html.phone-viewing) .phone-gate { display: none; }
  .gate-btn:disabled { opacity: 0.5; }
  button.gate-btn { width: 100%; appearance: none; background: none; font: inherit; cursor: pointer; }
  .gate-busy { font-size: 0.85rem; text-align: center; }
  .phone-view { padding: calc(var(--safe-t, 0px) + 0.8rem) 0.8rem 2rem; background: var(--bg); }
  .phone-view[hidden] { display: none; }
  .view-bar { display: flex; gap: 0.6rem; }
  .view-bar .gate-btn { flex: 1; margin: 0; }
  .view-hint { margin: 0.7rem 0.2rem; font-size: 0.8rem; line-height: 1.45; color: var(--ink-dim); }
  #view-img { display: block; width: 100%; height: auto; border-radius: 6px; }
  .gate-logo { width: 11rem; height: auto; margin-bottom: 1rem; }
  .phone-gate .eyebrow { margin: 0; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .phone-gate h1 { margin: 0; font-size: 1.6rem; line-height: 1.2; }
  .phone-gate p { margin: 0; line-height: 1.55; color: var(--ink-dim); }
  .gate-btn {
    display: block;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    color: var(--ink);
    text-align: center;
    text-decoration: none;
    font-weight: 600;
  }
  .gate-main { margin-top: 0.6rem; border-color: var(--accent); background: var(--accent); color: #0d1210; }
  .gate-home { align-self: center; margin-top: 0.4rem; font-size: 0.85rem; color: var(--ink-dim); }
  .map { position: absolute; inset: 0; background: var(--bg); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* ---- The panel ---------------------------------------------------------
     A phone: the lower half of the screen, foldable to its title. A wider
     screen: a card down the left. */
  .dst-panel {
    position: absolute;
    z-index: 6;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 56dvh;
    display: flex;
    flex-direction: column;
    border-radius: 20px 20px 0 0;
    border-top: 1px solid var(--line);
    background: rgba(13, 18, 16, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  /* A phone: the panel alone, as above. A wider screen: the panel and the
     legend in a column down the left, stopping short of the foot so the (i)
     has the corner; the two share the height when it runs short. */
  .left-col { display: contents; }
  .legend { display: none; }
  @media (min-width: 48rem) {
    .left-col {
      position: absolute;
      z-index: 6;
      left: 1rem;
      top: calc(var(--safe-t) + 1rem);
      width: 25rem;
      max-height: calc(100dvh - var(--safe-t) - 1rem - 3rem);
      display: flex;
      flex-direction: column;
      gap: 0.6rem;
    }
    .dst-panel {
      position: relative;
      left: auto;
      right: auto;
      top: auto;
      bottom: auto;
      flex: 0 1 auto;
      min-height: 0;
      max-height: none;
      border-radius: 18px;
      border: 1px solid var(--line);
    }
    .legend {
      display: block;
      flex: none;
      padding: 0.8rem 1.1rem;
      border-radius: 18px;
      border: 1px solid var(--line);
      background: rgba(13, 18, 16, 0.96);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }
  }
  .legend summary { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; list-style: none; cursor: pointer; }
  .legend summary::-webkit-details-marker { display: none; }
  .legend h2 { margin: 0; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-dim); }
  .legend summary:hover h2, .legend summary:hover .sum-chev { color: var(--ink); }
  .legend[open] .sum-chev { transform: rotate(180deg); }
  .legend[open] summary { margin-bottom: 0.65rem; }
  /* The score's colours, in the palette chosen, or the nine for two scores. */
  .lg-ramp { display: block; height: 10px; border-radius: 5px; background: var(--ramp, linear-gradient(90deg, #2d2318, #ffdd80)); }
  .lg-ends { display: flex; justify-content: space-between; margin-top: 0.25rem; font-size: 0.7rem; color: var(--ink-dim); }
  .lg-two { display: none; }
  .bi-on .lg-one { display: none; }
  .bi-on .lg-two { display: block; }
  .lg-bi { display: flex; align-items: center; gap: 0.8rem; }
  .lg-bi-axes { display: grid; gap: 0.3rem; min-width: 0; font-size: 0.72rem; color: var(--ink-dim); }
  .lg-bi-axes :global(i) { font-style: normal; font-weight: 600; color: var(--ink); }
  .lg-bi-grid { display: grid; grid-template-columns: repeat(3, 1.6rem); grid-auto-rows: 1.1rem; gap: 2px; }
  .lg-bi-grid :global(i) { border-radius: 3px; }
  .lg-list { list-style: none; margin: 0.75rem 0 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem 0.8rem; font-size: 0.74rem; color: var(--ink-dim); }
  .lg-list li { display: flex; align-items: center; gap: 0.5rem; min-width: 0; }
  .sw { flex: none; width: 22px; height: 14px; display: grid; place-items: center; font-style: normal; }
  .sw-none { border-radius: 3px; background: #141b17; box-shadow: inset 0 0 0 1px var(--line); }
  .sw-pin { width: 16px; height: 16px; margin: 0 3px; border-radius: 50%; background: var(--ramp-hi, #ffdd80); color: #1a140a; font: 700 9px/1 system-ui, sans-serif; box-shadow: 0 0 0 1.5px #0d1210; }
  .sw-drawn { border-radius: 2px; border: 1.5px dashed #eef2ee; background: rgba(238, 242, 238, 0.07); }
  .sw-town { font: 600 0.72rem/1 system-ui, sans-serif; color: #e6ece9; }
  .sw-road { height: 3px; border-radius: 2px; background: #b0b8b3; }
  .sw-edge { height: 0; border-top: 1.5px dashed #9aa79f; }
  .panel-head { display: flex; align-items: flex-start; gap: 0.8rem; padding: 1rem 1.1rem 0.6rem; }
  .panel-head > div { flex: 1; min-width: 0; }
  .panel-logo { display: block; width: 8.5rem; height: auto; margin: 0.1rem 0 0.7rem; }
  #share { margin-right: -0.4rem; }
  .eyebrow { margin: 0; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  h1 { font-size: 1.2rem; line-height: 1.2; margin: 0.25rem 0 0; }
  .fold {
    flex: none;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--bg-lift);
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .fold svg { width: 16px; height: 16px; transition: transform 0.18s; }
  .fold[aria-expanded='false'] svg { transform: rotate(180deg); }
  .panel-body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 1.1rem calc(1.2rem + var(--foot));
  }
  .panel-body[hidden] { display: none; }
  @media (min-width: 48rem) { .panel-body { padding-bottom: 1.2rem; } }
  .lede { margin: 0 0 0.9rem; font-size: 0.88rem; line-height: 1.5; color: var(--ink-dim); }
  .block { border-top: 1px solid var(--line); padding: 0.8rem 0; }
  .block h2 {
    margin: 0 0 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }
  .fold-block summary { display: flex; align-items: center; gap: 0.5rem; list-style: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .fold-block summary::-webkit-details-marker { display: none; }
  .fold-block summary h2 { margin: 0; }
  .fold-block[open] summary { margin-bottom: 0.55rem; }
  .sum-val { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; text-align: right; font-size: 0.74rem; color: var(--ink); }
  .fold-block[open] .sum-val { visibility: hidden; }
  .sum-chev { flex: none; width: 14px; height: 14px; color: var(--ink-dim); transition: transform 0.15s; }
  .fold-block[open] .sum-chev { transform: rotate(180deg); }
  .fold-block summary:hover h2, .fold-block summary:hover .sum-chev { color: var(--ink); }

  .chips :global(button), .seg button {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    font-size: 0.82rem;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* Examples: an even grid of equal buttons, however many there are. */
  .chips { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
  .chips :global(button) {
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--bg-lift);
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .chips :global(button:hover) { border-color: #3a4843; }
  .chips :global(button[aria-pressed='true']) { border-color: var(--accent); color: var(--accent); }
  /* How they combine: one control in three parts, the chosen part lifted. */
  .seg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 3px;
    border-radius: 11px;
    border: 1px solid var(--line);
    background: rgba(0, 0, 0, 0.25);
  }
  .seg-2 { grid-template-columns: 1fr 1fr; }
  .seg button { padding: 0.5rem 0.4rem; border: 0; border-radius: 8px; background: none; color: var(--ink-dim); }
  .seg button:hover { color: var(--ink); }
  .seg button[aria-checked='true'] { background: var(--bg-lift); color: var(--accent); box-shadow: 0 0 0 1px var(--line); }
  .sec-desc { margin: 0 0 0.6rem; font-size: 0.76rem; line-height: 1.45; color: var(--ink-dim); }
  /* The examples, the two modes and the calculation types explained on
     hover (and keyboard focus), in a tip under the button: kept inside the
     panel by lining it up with the button's outer edge at either side. */
  .fold-block :global([data-tip]) { position: relative; }
  .fold-block :global([data-tip])::after {
    content: attr(data-tip);
    position: absolute;
    z-index: 3;
    top: calc(100% + 8px);
    left: 50%;
    width: 14rem;
    padding: 0.5rem 0.65rem;
    border-radius: 9px;
    border: 1px solid var(--line);
    background: rgba(13, 18, 16, 0.97);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 400;
    line-height: 1.45;
    text-align: left;
    white-space: normal;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    --tx: -50%;
    transform: translate(var(--tx), -3px);
    transition: opacity 0.12s, transform 0.12s, visibility 0.12s;
    pointer-events: none;
  }
  .seg :global([data-tip]:first-child)::after, .chips :global([data-tip]:nth-child(odd))::after { left: 0; --tx: 0; }
  .seg :global([data-tip]:last-child)::after, .chips :global([data-tip]:nth-child(even))::after { left: auto; right: 0; --tx: 0; }
  @media (hover: hover) {
    .fold-block :global([data-tip]:hover)::after { opacity: 1; visibility: visible; transform: translate(var(--tx), 0); }
  }
  .fold-block :global([data-tip]:focus-visible)::after { opacity: 1; visibility: visible; transform: translate(var(--tx), 0); }
  .op-note { margin: 0.5rem 0 0; font-size: 0.76rem; line-height: 1.45; color: var(--ink-dim); }
  button:focus-visible, select:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* One criterion: its name, the spread of its values with the two
     thresholds on it, and its weight. */
  /* Two scores: the layers in two sections, one per axis, each named. */
  #criteria :global(.axis) { margin-top: 0.4rem; }
  #criteria :global(.axis + .axis) { margin-top: 1rem; padding-top: 0.8rem; border-top: 1px dashed var(--line); }
  #criteria :global(.axis-head) { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem; }
  #criteria :global(.axis-head i) { width: 12px; height: 12px; border-radius: 3px; flex: none; }
  #criteria :global(.axis-name) {
    flex: 1;
    min-width: 0;
    padding: 0.3rem 0.45rem;
    border-radius: 7px;
    border: 1px solid transparent;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
  }
  #criteria :global(.axis-name:hover), #criteria :global(.axis-name:focus) { border-color: var(--line); background: var(--bg-lift); outline: none; }
  #criteria :global(.axis-sub) { font-size: 0.7rem; color: var(--ink-dim); white-space: nowrap; }
  #criteria :global(.add select) {
    width: 100%;
    margin-top: 0.3rem;
    padding: 0.55rem 0.7rem;
    border-radius: 10px;
    border: 1px dashed var(--line);
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.85rem;
  }
  #criteria :global(.empty) { margin: 0; font-size: 0.85rem; line-height: 1.5; color: var(--ink-dim); }
  #criteria :global(.crit) { padding: 0.75rem 0; border-top: 1px solid var(--line); }
  #criteria :global(.crit:first-child) { border-top: 0; padding-top: 0.1rem; }
  #criteria :global(.crit-head) { display: flex; align-items: center; gap: 0.4rem; }
  #criteria :global(.crit-head b) { flex: 1; min-width: 0; font-size: 0.92rem; font-weight: 600; }
  #criteria :global(.icon) {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: none;
    color: var(--ink-dim);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  #criteria :global(.icon svg) { width: 14px; height: 14px; }
  #criteria :global(.icon[aria-expanded='true']) { color: var(--accent); border-color: var(--accent); }
  #criteria :global(.info) { margin: 0.45rem 0 0.4rem; padding: 0.55rem 0.7rem; border-radius: 10px; background: var(--bg-lift); font-size: 0.76rem; line-height: 1.5; }
  #criteria :global(.info p) { margin: 0; }
  #criteria :global(.info p + p) { margin-top: 0.4rem; }
  #criteria :global(.info .info-src) { margin-top: 0.4rem; font-size: 0.7rem; color: var(--ink-dim); }
  #criteria :global(.info a) { color: var(--accent); }
  /* Which way is good, as plainly as it can be put: a tag after the text. */
  #criteria :global(.way) { display: inline-block; margin-left: 0.2rem; padding: 0.05rem 0.45rem; border-radius: 6px; background: var(--bg-lift); color: var(--ink); font-weight: 600; white-space: nowrap; }
  #criteria :global(.dir) { margin: 0.15rem 0 0.35rem; font-size: 0.76rem; color: var(--ink-dim); }
  #criteria :global(svg.hist) { display: block; width: 100%; height: 44px; }
  /* Poor and best as two handles on one slider, under the histogram and
     lined up with it: the inputs run half a handle past each end, so a
     handle's middle sits over the value it stands for. */
  #criteria :global(.dual) { position: relative; height: 22px; margin-top: 0.2rem; }
  #criteria :global(.dual::before), #criteria :global(.dual::after) { content: ''; position: absolute; border-radius: 3px; pointer-events: none; }
  #criteria :global(.dual::before) { left: 0; right: 0; top: 9.5px; height: 3px; background: var(--line); }
  #criteria :global(.dual::after) {
    left: var(--lo);
    right: calc(100% - var(--hi));
    top: 8.5px;
    height: 5px;
    background: linear-gradient(var(--dir), rgba(154, 167, 159, 0.4), var(--ramp-hi, #ffdd80));
  }
  /* input[type='range'] to outrank the general slider rule further down. */
  #criteria :global(.dual input[type='range']) {
    position: absolute;
    left: -10px;
    top: 0;
    width: calc(100% + 20px);
    height: 22px;
    margin: 0;
    background: none;
    -webkit-appearance: none;
    appearance: none;
    pointer-events: none;
  }
  #criteria :global(.dual input.front) { z-index: 1; }
  #criteria :global(.dual input::-webkit-slider-runnable-track) { height: 22px; background: none; }
  #criteria :global(.dual input::-moz-range-track) { background: none; }
  #criteria :global(.dual input::-webkit-slider-thumb) {
    -webkit-appearance: none;
    pointer-events: auto;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border-radius: 50%;
    border: 2px solid #0d1210;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    cursor: grab;
  }
  #criteria :global(.dual input::-moz-range-thumb) {
    pointer-events: auto;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid #0d1210;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    cursor: grab;
  }
  #criteria :global(.t-bad::-webkit-slider-thumb) { background: #c9d2cc; }
  #criteria :global(.t-bad::-moz-range-thumb) { background: #c9d2cc; }
  #criteria :global(.t-good::-webkit-slider-thumb) { background: var(--ramp-hi, #ffdd80); }
  #criteria :global(.t-good::-moz-range-thumb) { background: var(--ramp-hi, #ffdd80); }
  #criteria :global(.dual input:focus-visible) { outline: none; }
  #criteria :global(.dual input:focus-visible::-webkit-slider-thumb) { box-shadow: 0 0 0 3px var(--accent); }
  #criteria :global(.dual input:focus-visible::-moz-range-thumb) { box-shadow: 0 0 0 3px var(--accent); }
  #criteria :global(.thresh) { display: flex; justify-content: space-between; margin-top: 0.25rem; font-size: 0.72rem; color: var(--ink-dim); }
  #criteria :global(.thresh.flip) { flex-direction: row-reverse; }
  #criteria :global(.thresh i) { display: inline-block; width: 8px; height: 8px; margin-right: 0.35rem; border-radius: 50%; vertical-align: 0.05em; }
  #criteria :global(.dot-bad) { background: #c9d2cc; }
  #criteria :global(.dot-good) { background: var(--ramp-hi, #ffdd80); }
  #criteria :global(.weight) {
    display: grid;
    gap: 0.15rem;
    font-size: 0.72rem;
    color: var(--ink-dim);
  }
  #criteria :global(.thresh output), #criteria :global(.weight output) { color: var(--ink); font-variant-numeric: tabular-nums; }
  #criteria :global(input[type='range']) { width: 100%; margin: 0; accent-color: var(--accent); }
  #criteria :global(.weight) { margin-top: 0.5rem; }
  #criteria :global(.weight-head) { display: flex; justify-content: space-between; gap: 0.5rem; }
  #criteria :global(.weight-head b) { color: var(--ink); font-weight: 600; white-space: nowrap; }
  #criteria :global(.weight-foot) { display: flex; align-items: baseline; gap: 0.5rem; }
  #criteria :global(.weight-foot small) { font-size: 0.68rem; color: var(--ink-dim); }
  #criteria :global(.weight-foot output) { margin-left: auto; }
  .op-and #criteria :global(.weight), .op-or #criteria :global(.weight) { display: none; }


  /* ---- The key: bottom right on a wide screen; on a phone, above the panel. */
  .key {
    position: absolute;
    z-index: 4;
    right: 0.9rem;
    bottom: calc(1rem + var(--foot));
    width: 19rem;
    max-height: calc(100dvh - 2rem - var(--foot));
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.8rem 0.95rem 0.75rem;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgba(13, 18, 16, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  @media (max-width: 47.99rem) {
    .key { top: calc(var(--safe-t) + 0.8rem); bottom: auto; left: 0.9rem; right: auto; width: 11rem; }
  }
  .key-head { display: grid; gap: 0.5rem; }
  .key-title { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .key-fold { width: 28px; height: 28px; margin: -0.25rem -0.3rem -0.25rem 0; }
  .key-fold svg { width: 14px; height: 14px; }
  /* Minimised: the title and its button, nothing else. */
  .key.folded > :not(.key-head), .key.folded .seg { display: none; }
  .key h2 { margin: 0; white-space: nowrap; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-dim); }
  .seg-sm { padding: 2px; border-radius: 9px; }
  .seg-sm button { padding: 0.28rem 0.55rem; font-size: 0.72rem; border-radius: 7px; }
  .big { display: flex; align-items: baseline; gap: 0.55rem; margin: 0.6rem 0 0.5rem; }
  .big b { font-size: 1.9rem; font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
  .big span { font-size: 0.8rem; line-height: 1.35; color: var(--ink-dim); }
  .spread :global(svg) { display: block; width: 100%; height: 56px; }
  .key.loading .big, .key.loading .spread { opacity: 0.45; transition: opacity 0.2s; }
  .key-check { display: flex; align-items: center; gap: 0.45rem; margin-top: 0.45rem; font-size: 0.74rem; color: var(--ink-dim); cursor: pointer; }
  .key-check input { margin: 0; accent-color: var(--accent); }
  .key-check.off { opacity: 0.45; cursor: not-allowed; }
  .steady { margin-top: 0.5rem; padding: 0.55rem 0.6rem; border-radius: 9px; background: var(--bg-lift); }
  .steady[hidden] { display: none; }
  .steady p { margin: 0 0 0.45rem; font-size: 0.7rem; line-height: 1.45; color: var(--ink-dim); }
  .steady-rows { display: grid; gap: 0.2rem; }
  .steady-rows :global(div) { display: grid; grid-template-columns: 10px 1fr auto auto; align-items: center; gap: 0.45rem; font-size: 0.74rem; }
  .steady-rows :global(i) { width: 10px; height: 10px; border-radius: 2px; }
  .steady-rows :global(span) { color: var(--ink-dim); font-variant-numeric: tabular-nums; }
  .key-op output { color: var(--ink); font-variant-numeric: tabular-nums; }
  /* One key or the other, by mode. */
