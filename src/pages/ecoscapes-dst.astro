  @media (prefers-reduced-motion: reduce) { .loading-bar { animation: none; background-size: 100% 100%; } }
  .key-foot { margin: 0.55rem 0 0; font-size: 0.7rem; line-height: 1.4; color: var(--ink-dim); }
  .key-ends { display: flex; justify-content: space-between; margin-top: 0.25rem; font-size: 0.7rem; color: var(--ink-dim); }
  .key-op { display: grid; gap: 0.15rem; margin-top: 0.45rem; font-size: 0.7rem; color: var(--ink-dim); }
  .key-op input { width: 100%; margin: 0; accent-color: var(--accent); }

  /* Below MapLibre's attribution button, in the same corner. */
  .map-side { position: absolute; z-index: 4; right: 0.9rem; top: calc(var(--safe-t) + 3rem); }

  .toast {
    position: absolute;
    z-index: 7;
    top: calc(var(--safe-t) + 0.9rem);
    left: 1rem;
    right: 1rem;
    max-width: 24rem;
    margin: 0 auto;
    padding: 0.7rem 1rem;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgba(13, 18, 16, 0.9);
    font-size: 0.85rem;
