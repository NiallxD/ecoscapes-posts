---
import { getEntry } from 'astro:content';
import 'maplibre-gl/dist/maplibre-gl.css';
import Shell from '../layouts/Shell.astro';
import { asset, tile } from '../lib/paths';
import layersData from '../data/dst-layers.json';

/** Planning support: the RRN demo's weighted, fuzzy scoring, on this
 *  region's own layers. Where /map/ shows each layer as it is, this page asks
 *  what matters and how much, and colours the whole area by how well each
 *  place fits. Every layer is a file of real values (tools/prepare-value-
 *  layer.py) scored on the GPU as the sliders move -- no server. A demo: the
 *  presets are examples, not anyone's recommendation. */
const entry = await getEntry('ecoscapes', 'sea-to-sky');
if (!entry) throw new Error('src/content/ecoscapes/sea-to-sky.md is missing');
const { data } = entry;

const config = {
  bounds: data.bounds,
  limit: data.limit,
  basemap: tile(data.basemap),
  terrain: tile('/tiles/terrain.pmtiles'),
  glyphs: asset('/tiles/fonts/{fontstack}/{range}.pbf'),
  layers: layersData.map((l) => ({ ...l, src: tile(l.src), sampleSrc: tile(l.sampleSrc) })),
};
---
<Shell title="EcoScapes planning support" description="Choose what matters and how much, and see where across the Sea-to-Sky fits best.">
  <main class="dst-page">
    <div class="map" id="map" data-config={JSON.stringify(config)}></div>

    <section class="dst-panel" id="panel" aria-labelledby="panel-title">
      <header class="panel-head">
        <div>
          <p class="eyebrow">Planning support · demo</p>
          <h1 id="panel-title">What matters here?</h1>
        </div>
        <button class="fold" id="share" type="button" aria-label="Copy a link to this model" title="Copy a link to this model">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a4 4 0 005.7 0l3-3a4 4 0 00-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 00-5.7 0l-3 3a4 4 0 005.7 5.7l1-1" /></svg>
        </button>
        <button class="fold" id="fold" type="button" aria-expanded="true" aria-controls="panel-body" aria-label="Fold the panel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </button>
      </header>
      <div class="panel-body" id="panel-body">
        <p class="lede">Pick the layers that matter, say what counts as good, and weigh them. The map lights up where a place fits best. Tap the map to see why.</p>

        <div class="block">
          <h2>Start from an example</h2>
          <div class="chips" id="presets"></div>
          <p class="op-note" id="preset-note"></p>
        </div>

        <div class="block">
          <h2>Show</h2>
          <div class="seg seg-2" id="mode" role="radiogroup" aria-label="One score or two">
            <button type="button" role="radio" data-mode="one">One score</button>
            <button type="button" role="radio" data-mode="two">Two scores</button>
          </div>
          <p class="op-note" id="mode-note"></p>
        </div>

        <div class="block">
          <h2>Combine them by</h2>
          <div class="seg" id="op" role="radiogroup" aria-label="How the layers combine">
            <button type="button" role="radio" data-op="mean">Weigh up</button>
            <button type="button" role="radio" data-op="and">All must pass</button>
            <button type="button" role="radio" data-op="or">Any one</button>
          </div>
          <p class="op-note" id="op-note"></p>
        </div>

        <div class="block">
          <h2>Layers</h2>
          <div id="criteria"></div>
        </div>
      </div>
    </section>

    <!-- The result in numbers, and the key to the map's colours: the spread
         of scores is drawn in the map's own ramp, so it is both. -->
    <aside class="key" aria-labelledby="key-title">
      <div class="key-head">
        <h2 id="key-title">How much fits</h2>
        <div class="seg seg-sm" id="scope" role="radiogroup" aria-label="Count across">
          <button type="button" role="radio" data-scope="region" aria-checked="true">Whole area</button>
          <button type="button" role="radio" data-scope="view" aria-checked="false">This view</button>
          <button type="button" role="radio" data-scope="area" aria-checked="false" title="Draw an area on the map and count inside it">Draw</button>
        </div>
      </div>
      <p class="key-solo" id="key-solo" hidden></p>
      <div class="key-one">
        <p class="big"><b id="pct">–</b><span id="km"></span></p>
        <div class="spread" id="spread" aria-hidden="true"></div>
        <div class="key-ends"><span>Poor fit</span><span>Best fit</span></div>
        <label class="key-op"><span>Counts as a good fit from <output id="cut-out">70</output></span>
          <input id="cut" type="range" min="5" max="95" step="5" value="70" /></label>
        <label class="key-check"><input id="only" type="checkbox" /> Only show places above it</label>
        <label class="key-check" id="steady-label"><input id="steady-on" type="checkbox" /> Show how steady it is</label>
        <div class="steady" id="steady" hidden>
          <p>Every weight nudged up and down, sixteen times over. Brightest where a place stays a good fit however the weights shift; dim where it hinges on exactly how they were set.</p>
          <div class="steady-rows" id="steady-rows"></div>
        </div>
      </div>
      <!-- Two scores: the nine-cell key, which is also the numbers -- each
           cell's area on hover, and a click shows that cell alone. -->
      <div class="key-two">
        <p class="big"><b id="bi-pct">–</b><span id="bi-km"></span></p>
        <div class="bi">
          <span class="bi-y" id="bi-y"></span>
          <div class="bi-grid" id="bi-grid" role="group" aria-label="The nine combinations"></div>
          <span class="bi-x" id="bi-x"></span>
        </div>
        <p class="bi-hint">Hover a square for its area. Click to show it alone.</p>
        <div class="bi-brk" id="bi-brk"></div>
      </div>
      <label class="key-op">Strength <input id="opacity" type="range" min="0.2" max="1" step="0.05" value="0.85" /></label>
      <p class="key-foot" id="key-foot"></p>
      <!-- The strongest places for the model as it stands: numbered on the
           map, named by the nearest town, and a tour that flies through them. -->
      <div class="best">
        <div class="best-head">
          <button type="button" id="best-btn" aria-expanded="false" aria-controls="best-list">Best places</button>
          <button type="button" id="tour-btn">Take the tour</button>
        </div>
        <ol class="best-list" id="best-list" hidden></ol>
        <p class="best-note" id="best-note" hidden></p>
      </div>
      <div class="key-out">
        <button type="button" id="save-png">Map image</button>
        <button type="button" id="save-csv">Numbers (CSV)</button>
      </div>
    </aside>

    <div class="map-side">
      <!-- Flat, or the scores laid over the ground's own shape. -->
      <!-- The tilt, sliding out of the button while 3D is on: a mouse's
           way to it (a right-drag also tilts). Not on a touch screen, where
           two fingers do it. -->
      <div class="tilt-wrap">
        <label class="tilt" id="tilt" aria-hidden="true">
          <span>Tilt</span>
          <input type="range" min="0" max="80" step="1" value="60" tabindex="-1" aria-label="Tilt" />
        </label>
        <button class="step" id="three-d" type="button" aria-pressed="false" aria-label="3D view" title="3D view"><span class="step-text">3D</span></button>
      </div>
      <button class="step" id="here" type="button" aria-label="Score where I am" title="Score where I am">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3" />
        </svg>
      </button>
      <a class="step" href={asset('/map/')} aria-label="Back to the map">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3.5l8.5 4.5-8.5 4.5L3.5 8z" /><path d="M3.5 12l8.5 4.5 8.5-4.5" /><path d="M3.5 16l8.5 4.5 8.5-4.5" />
        </svg>
      </a>
    </div>

    <div class="loading-bar" id="loading-bar" aria-hidden="true"></div>
    <p class="toast" id="toast" role="status" aria-live="polite" hidden></p>
  </main>
</Shell>

<style>
  .dst-page { position: relative; height: 100dvh; overflow: hidden; }
  .map { position: absolute; inset: 0; background: var(--bg); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* ---- The panel ---------------------------------------------------------
     A phone: the lower half of the screen, foldable to its title. A wider
     screen: a card down the left. */
  .dst-panel {
    position: absolute;
    z-index: 6;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 56dvh;
    display: flex;
    flex-direction: column;
    border-radius: 20px 20px 0 0;
    border-top: 1px solid var(--line);
    background: rgba(13, 18, 16, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
  @media (min-width: 48rem) {
    .dst-panel {
      left: 1rem;
      right: auto;
      top: calc(var(--safe-t) + 1rem);
      bottom: auto;
      width: 25rem;
      max-height: calc(100dvh - 2rem);
      border-radius: 18px;
      border: 1px solid var(--line);
    }
  }
  .panel-head { display: flex; align-items: flex-start; gap: 0.8rem; padding: 1rem 1.1rem 0.6rem; }
  .panel-head > div { flex: 1; min-width: 0; }
  #share { margin-right: -0.4rem; }
  .eyebrow { margin: 0; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  h1 { font-size: 1.2rem; line-height: 1.2; margin: 0.25rem 0 0; }
  .fold {
    flex: none;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--bg-lift);
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .fold svg { width: 16px; height: 16px; transition: transform 0.18s; }
  .fold[aria-expanded='false'] svg { transform: rotate(180deg); }
  .panel-body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 1.1rem calc(1.2rem + var(--foot));
  }
  .panel-body[hidden] { display: none; }
  @media (min-width: 48rem) { .panel-body { padding-bottom: 1.2rem; } }
  .lede { margin: 0 0 0.9rem; font-size: 0.88rem; line-height: 1.5; color: var(--ink-dim); }
  .block { border-top: 1px solid var(--line); padding: 0.8rem 0; }
  .block h2 {
    margin: 0 0 0.55rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
  }

  .chips :global(button), .seg button {
    appearance: none;
    -webkit-appearance: none;
    font: inherit;
    font-size: 0.82rem;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  /* Examples: an even grid of equal buttons, however many there are. */
  .chips { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
  .chips :global(button) {
    padding: 0.55rem 0.75rem;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--bg-lift);
    text-align: left;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .chips :global(button:hover) { border-color: #3a4843; }
  .chips :global(button[aria-pressed='true']) { border-color: var(--accent); color: var(--accent); }
  /* How they combine: one control in three parts, the chosen part lifted. */
  .seg {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 3px;
    border-radius: 11px;
    border: 1px solid var(--line);
    background: rgba(0, 0, 0, 0.25);
  }
  .seg-2 { grid-template-columns: 1fr 1fr; }
  .seg button { padding: 0.5rem 0.4rem; border: 0; border-radius: 8px; background: none; color: var(--ink-dim); }
  .seg button:hover { color: var(--ink); }
  .seg button[aria-checked='true'] { background: var(--bg-lift); color: var(--accent); box-shadow: 0 0 0 1px var(--line); }
  .op-note { margin: 0.5rem 0 0; font-size: 0.76rem; line-height: 1.45; color: var(--ink-dim); }
  button:focus-visible, select:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* One criterion: its name, the spread of its values with the two
     thresholds on it, and its weight. */
  /* Two scores: the layers in two sections, one per axis, each named. */
  #criteria :global(.axis) { margin-top: 0.4rem; }
  #criteria :global(.axis + .axis) { margin-top: 1rem; padding-top: 0.8rem; border-top: 1px dashed var(--line); }
  #criteria :global(.axis-head) { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.4rem; }
  #criteria :global(.axis-head i) { width: 12px; height: 12px; border-radius: 3px; flex: none; }
  #criteria :global(.axis-name) {
    flex: 1;
    min-width: 0;
    padding: 0.3rem 0.45rem;
    border-radius: 7px;
    border: 1px solid transparent;
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
  }
  #criteria :global(.axis-name:hover), #criteria :global(.axis-name:focus) { border-color: var(--line); background: var(--bg-lift); outline: none; }
  #criteria :global(.axis-sub) { font-size: 0.7rem; color: var(--ink-dim); white-space: nowrap; }
  #criteria :global(.add select) {
    width: 100%;
    margin-top: 0.3rem;
    padding: 0.55rem 0.7rem;
    border-radius: 10px;
    border: 1px dashed var(--line);
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: 0.85rem;
  }
  #criteria :global(.empty) { margin: 0; font-size: 0.85rem; line-height: 1.5; color: var(--ink-dim); }
  #criteria :global(.crit) { padding: 0.75rem 0; border-top: 1px solid var(--line); }
  #criteria :global(.crit:first-child) { border-top: 0; padding-top: 0.1rem; }
  #criteria :global(.crit-head) { display: flex; align-items: center; gap: 0.4rem; }
  #criteria :global(.crit-head b) { flex: 1; min-width: 0; font-size: 0.92rem; font-weight: 600; }
  #criteria :global(.icon) {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: none;
    color: var(--ink-dim);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  #criteria :global(.icon svg) { width: 14px; height: 14px; }
  #criteria :global(.dir) { margin: 0.15rem 0 0.35rem; font-size: 0.76rem; color: var(--ink-dim); }
  #criteria :global(svg.hist) { display: block; width: 100%; height: 44px; }
  #criteria :global(.thresh) { display: grid; grid-template-columns: 1fr 1fr; gap: 0.2rem 0.8rem; margin-top: 0.3rem; }
  #criteria :global(.thresh label), #criteria :global(.weight) {
    display: grid;
    gap: 0.15rem;
    font-size: 0.72rem;
    color: var(--ink-dim);
  }
  #criteria :global(.thresh output), #criteria :global(.weight output) { color: var(--ink); font-variant-numeric: tabular-nums; }
  #criteria :global(input[type='range']) { width: 100%; margin: 0; accent-color: var(--accent); }
  #criteria :global(.weight) { margin-top: 0.5rem; }
  .op-and #criteria :global(.weight), .op-or #criteria :global(.weight) { display: none; }


  /* ---- The key: bottom right on a wide screen; on a phone, above the panel. */
  .key {
    position: absolute;
    z-index: 4;
    right: 0.9rem;
    bottom: calc(1rem + var(--foot));
    width: 19rem;
    max-height: calc(100dvh - 2rem - var(--foot));
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.8rem 0.95rem 0.75rem;
    border-radius: 14px;
    border: 1px solid var(--line);
    background: rgba(13, 18, 16, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  @media (max-width: 47.99rem) {
    .key { top: calc(var(--safe-t) + 0.8rem); bottom: auto; left: 0.9rem; right: auto; width: 11rem; }
  }
  .key-head { display: grid; gap: 0.5rem; }
  .key h2 { margin: 0; white-space: nowrap; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-dim); }
  .seg-sm { padding: 2px; border-radius: 9px; }
  .seg-sm button { padding: 0.28rem 0.55rem; font-size: 0.72rem; border-radius: 7px; }
  .big { display: flex; align-items: baseline; gap: 0.55rem; margin: 0.6rem 0 0.5rem; }
  .big b { font-size: 1.9rem; font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
  .big span { font-size: 0.8rem; line-height: 1.35; color: var(--ink-dim); }
  .spread :global(svg) { display: block; width: 100%; height: 56px; }
  .key.loading .big, .key.loading .spread { opacity: 0.45; transition: opacity 0.2s; }
  .key-check { display: flex; align-items: center; gap: 0.45rem; margin-top: 0.45rem; font-size: 0.74rem; color: var(--ink-dim); cursor: pointer; }
  .key-check input { margin: 0; accent-color: var(--accent); }
  .key-check.off { opacity: 0.45; cursor: not-allowed; }
  .steady { margin-top: 0.5rem; padding: 0.55rem 0.6rem; border-radius: 9px; background: var(--bg-lift); }
  .steady[hidden] { display: none; }
  .steady p { margin: 0 0 0.45rem; font-size: 0.7rem; line-height: 1.45; color: var(--ink-dim); }
  .steady-rows { display: grid; gap: 0.2rem; }
  .steady-rows :global(div) { display: grid; grid-template-columns: 10px 1fr auto auto; align-items: center; gap: 0.45rem; font-size: 0.74rem; }
  .steady-rows :global(i) { width: 10px; height: 10px; border-radius: 2px; }
  .steady-rows :global(span) { color: var(--ink-dim); font-variant-numeric: tabular-nums; }
  .key-op output { color: var(--ink); font-variant-numeric: tabular-nums; }
  /* One key or the other, by mode. */
  .key-two { display: none; }
  .bi-on .key-one { display: none; }
  .bi-on .key-two { display: block; }
  /* One layer shown alone: said at the top of the key, its card marked. */
  .key-solo { display: flex; align-items: center; gap: 0.5rem; margin: 0.55rem 0 0; padding: 0.4rem 0.55rem; border-radius: 8px; background: var(--bg-lift); font-size: 0.74rem; }
  .key-solo[hidden] { display: none; }
  .key-solo :global(button) { margin-left: auto; appearance: none; border: 0; background: none; color: var(--accent); font: inherit; cursor: pointer; }
  .soloing #criteria :global(.crit:not(.solo)) { opacity: 0.45; }
  #criteria :global(.icon[aria-pressed='true']) { color: var(--accent); border-color: var(--accent); }
  /* A categorical layer: a score for each kind, not two thresholds. */
  #criteria :global(.cats) { display: grid; gap: 0.25rem; margin-top: 0.35rem; }
  #criteria :global(.cat) { display: grid; grid-template-columns: 1fr auto auto; align-items: center; gap: 0.5rem; font-size: 0.76rem; }
  #criteria :global(.cat small) { color: var(--ink-dim); font-variant-numeric: tabular-nums; }
  #criteria :global(.cat-seg) { display: inline-flex; border: 1px solid var(--line); border-radius: 7px; overflow: hidden; }
  #criteria :global(.cat-seg button) { appearance: none; border: 0; background: none; color: var(--ink-dim); font: inherit; font-size: 0.7rem; padding: 0.2rem 0.45rem; cursor: pointer; }
  #criteria :global(.cat-seg button + button) { border-left: 1px solid var(--line); }
  #criteria :global(.cat-seg button[aria-pressed='true']) { background: var(--bg-lift); color: var(--accent); }
  /* The nine cells: second axis up, first across, high/high top right. */
  .bi { display: grid; grid-template-columns: auto 1fr; grid-template-rows: auto auto; gap: 0.35rem 0.5rem; align-items: center; }
  .bi-y { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 0.72rem; color: var(--ink-dim); white-space: nowrap; }
  .bi-x { grid-column: 2; font-size: 0.72rem; color: var(--ink-dim); }
  .bi-y :global(i), .bi-x :global(i) { font-style: normal; font-weight: 600; }
  .bi-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; }
  .bi-grid :global(button) {
    appearance: none;
    aspect-ratio: 1.6;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    transition: transform 0.12s, opacity 0.12s;
  }
  .bi-grid :global(button:hover) { transform: scale(1.06); }
  .bi-grid.isolating :global(button:not([aria-pressed='true'])) { opacity: 0.3; }
  .bi-grid :global(button[aria-pressed='true']) { box-shadow: 0 0 0 2px var(--ink); }
  .bi-hint { margin: 0.4rem 0 0; font-size: 0.7rem; color: var(--ink-dim); }
  .bi-brk { display: grid; gap: 0.5rem; margin-top: 0.6rem; }
  .bi-brk :global(.brk) { display: grid; grid-template-columns: 1fr 1fr; gap: 0.1rem 0.7rem; font-size: 0.7rem; color: var(--ink-dim); }
  .bi-brk :global(.brk b) { grid-column: 1 / -1; font-weight: 600; color: var(--ink); }
  .bi-brk :global(.brk output) { color: var(--ink); font-variant-numeric: tabular-nums; }
  .bi-brk :global(input) { width: 100%; margin: 0; accent-color: var(--accent); }
  .best { margin-top: 0.6rem; }
  .best-head { display: flex; gap: 0.4rem; }
  .best-head button {
    flex: 1;
    appearance: none;
    padding: 0.45rem 0.5rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--bg-lift);
    color: var(--ink);
    font: inherit;
    font-size: 0.76rem;
    cursor: pointer;
  }
  .best-head button[aria-expanded='true'], .best-head button[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); }
  .best-list { list-style: none; margin: 0.45rem 0 0; padding: 0; display: grid; gap: 0.2rem; }
