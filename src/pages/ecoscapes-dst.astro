  import { addRelief, addSky, tilting } from '../lib/terrain';
  import { confirmLeave } from '../lib/leave';
  import { PALETTES, paletteById, rgb } from '../lib/dst/palettes';
  import { cameraAt, flight, lookFrom, metreAt, type View } from '../lib/dst/flyover';
  import { FlightDebug } from '../lib/dst/flyover-debug';
  import { ScoreLayer, MAX_CRITERIA, scoreOf, criterionLut, type Criterion, type Op } from '../lib/dst/score-layer';
  import type { Grid, StatsRequest, StatsResponse, Tally } from '../lib/dst/stats-worker';

  // A phone gets the screen above instead (.phone-gate), and nothing past
  // here runs.
  // Unless a shared model is to be drawn as a picture (showOnPhone, below):
  // then the rest runs behind the screen, the map unseen.
  const PHONE = '(pointer: coarse) and (max-width: 599px), (pointer: coarse) and (max-height: 599px)';
  const onPhone = matchMedia(PHONE).matches;
  if (onPhone) {
    await new Promise<void>((go) => document.getElementById('gate-see')!.addEventListener('click', () => go(), { once: true }));
    document.documentElement.classList.add('phone-render');
  }

  type LngLat = [number, number];
  type Layer = {
    id: string;
    name: string;
    /** Where it sits in the add-a-layer menu. */
    group: string;
    src: string;
    lo: number;
    hi: number;
    unit: string;
    /** Values that are classes, with a name each: thresholds step between
     *  them rather than sliding. */
    classes?: { value: number; label: string }[];
    /** Which way is usually "good" for this layer, for a new criterion. */
    higher: 'better' | 'worse';
    /** Categories with no order between them (land cover): scored kind by
     *  kind rather than by two thresholds. */
    categorical?: boolean;
    about: string;
    /** The map portal's longer description, and where the data comes from. */
    detail?: { text: string[]; source: string; href: string };
    hist: number[];
    /** Its area sample: full-detail values on a grid every layer shares. */
    sampleSrc: string;
    sample: Grid;
  };
  type Config = { bounds: [LngLat, LngLat]; limit: [LngLat, LngLat]; basemap: string; terrain: string; glyphs: string; logo: string; emblem: string; cards: Card[]; layers: Layer[] };
  type Card = { title: string; image: string; tall: boolean; seconds: number; text: string[] };

  const el = document.getElementById('map')!;
  const config: Config = JSON.parse(el.dataset.config!);
  const byId = new Map(config.layers.map((l) => [l.id, l]));
  // Menu groups in catalogue order.
  const groups = [...new Set(config.layers.map((l) => l.group))];
  const abs = (p: string) => (/^https?:/.test(p) ? p : location.origin + p);
  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  // ---- The model -----------------------------------------------------------
  // All of it, in one place: what the map, the panel and the explanation read.
  /** `scores`: a categorical layer's score for each class value. */
  type Item = { id: string; weight: number; good: number; bad: number; axis: 0 | 1; scores?: Record<number, number> };
  let items: Item[] = [];
  let op: Op = 'mean';
  // Two scores (bivariate): each layer feeds one of two axes, each axis is
  // named by whoever is using it, and breaks into low / middle / high.
  type Mode = 'one' | 'two';
  let mode: Mode = 'one';
  const AXIS_NAMES: [string, string] = ['Value', 'Pressure'];
  let axisNames: [string, string] = [...AXIS_NAMES];
  let breaks: [[number, number], [number, number]] = [[0.35, 0.65], [0.35, 0.65]];
  /** The one cell shown alone, or -1 for all. */
  let only = -1;
  /** One layer shown alone (its index), or -1: its own score on the map and
   *  in the numbers, to see what it contributes. */
  let solo = -1;
  /** Layers whose longer description is open, by id. */
  const infoOpen = new Set<string>();
  const soloing = () => solo >= 0 && solo < items.length;
  /** What is actually drawn and counted: the model, or the one layer alone. */
  const effectiveMode = (): Mode => (soloing() ? 'one' : mode);
  // Row-major from low/low: row = second axis (up), column = first (across).
  // Blue across, orange up, cream where both are high. Checked with the
  // palette validator on this basemap over all 36 pairs: normal vision ΔE
  // 15.8, protan/deutan 12.1. Low/low is dim on purpose: nothing of note.
  const PALETTE = ['#343c39', '#38618d', '#3584e8', '#8c593c', '#998d90', '#9dc1e5', '#e8722f', '#f8b787', '#fff8d6'];
  const AXIS_COLOURS = [PALETTE[2], PALETTE[6]];

  /** A value near the given share of a layer's pixels, from its histogram:
   *  where a new criterion's thresholds start, so the map shows a spread
   *  rather than all-best or all-worst. */
  const quantile = (l: Layer, q: number) => {
    const total = l.hist.reduce((a, b) => a + b, 0);
    let run = 0;
    for (let i = 0; i < l.hist.length; i++) {
      run += l.hist[i];
      if (run >= q * total) return l.lo + ((i + 0.5) / l.hist.length) * (l.hi - l.lo);
    }
    return l.hi;
  };
  const snap = (l: Layer, v: number) =>
    l.classes ? l.classes.reduce((a, c) => (Math.abs(c.value - v) < Math.abs(a.value - v) ? c : a)).value : v;
  const fresh = (id: string, weight = 1, higher?: 'better' | 'worse', axis: 0 | 1 = 0, q?: [number, number]): Item => {
    const l = byId.get(id)!;
    const up = (higher ?? l.higher) === 'better';
    // From a quarter of the way up the spread to near its top: the ordinary
    // scores poorly, and only the stand-out places are brightest. An example
    // can start elsewhere (`q`, shares of the layer's area).
    const [qa, qb] = q ?? (up ? [0.25, 0.95] : [0.05, 0.75]);
    const a = snap(l, l.classes ? l.classes[0].value : quantile(l, qa));
    const b = snap(l, l.classes ? l.classes.at(-1)!.value : quantile(l, qb));
    // A categorical layer starts with every kind in the middle, to be scored.
    const scores = l.categorical ? Object.fromEntries(l.classes!.map((c) => [c.value, 0.5])) : undefined;
    return { id, weight, bad: up ? a : b, good: up ? b : a, axis, scores };
  };

  // Examples, to show what the tool is for. Plainly examples: nobody's
  // recommendation, and the panel says so.
  type Preset = {
    name: string;
    about: string;
    op: Op;
    /** Two scores, with these axis names. */
    axes?: [string, string];
    items: [string, number, ('better' | 'worse')?, (0 | 1)?, [number, number]?][];
  };
  const PRESETS: Preset[] = [
    {
      name: 'Wildlife strongholds',
      about:
        'Where habitat is already at its best: land that suits many native species, lets animals move through it and could recover from a fire or a clearcut, with little human impact.',
      op: 'mean',
      items: [
        ['habitat-suitability', 3],
        ['habitat-permeability', 2],
        ['ecosystem-resilience', 2],
        ['cumulative-impacts', 1],
      ],
    },
    {
      name: 'Under pressure',
      about:
        'Where nature is under most strain: the heaviest human impact, a footprint that has grown over forty years, built-up land, and where a fire could burn hottest.',
      op: 'mean',
      items: [
        ['cumulative-impacts', 3, 'better'],
        ['human-footprint-change', 2, 'better'],
        ['built-up-density', 1, 'better'],
        ['wildfire-hazard', 1, 'better'],
      ],
    },
    {
      name: 'Room to roam',
      about:
        'Where the wide-ranging carnivores (grizzly, wolverine, lynx and fisher) can live, and the linkages that let them move between those places.',
      op: 'mean',
      items: [
        ['habitat-grizzly-bear', 2],
        ['habitat-wolverine', 2],
        ['habitat-canada-lynx', 1],
        ['habitat-pacific-fisher', 1],
        ['connectivity-linkages', 2],
      ],
    },
    {
      name: 'Bear country',
      about:
        'Where both bears do well through the seasons: grizzly habitat, black bear habitat in summer and in fall, and the linkages that join them up.',
      op: 'mean',
      items: [
        ['habitat-grizzly-bear', 2],
        ['habitat-black-bear-summer', 1],
        ['habitat-black-bear-fall', 1],
        ['connectivity-linkages', 1],
      ],
    },
    {
      name: "Life at the water's edge",
      about:
        'Where the animals of streams, ponds and wetlands find good habitat: beaver and mink, and three of the region\'s frogs and toads.',
      op: 'mean',
      items: [
        ['habitat-beaver', 2],
        ['habitat-mink', 1],
        ['habitat-northern-red-legged-frog', 1],
        ['habitat-western-toad', 1],
        ['habitat-pacific-tree-frog', 1],
      ],
    },
    {
      name: 'Quiet and intact',
      about:
        'Good habitat, away from trails and little touched by people. All three must pass, so a place lights up only if it does well on every one.',
      op: 'and',
      items: [
        ['distance-to-trails', 1],
        ['cumulative-impacts', 1],
        ['habitat-suitability', 1],
      ],
    },
    {
      name: 'Value × pressure',
      about:
        'Bivariate: how valuable the land is for nature, set against how much pressure it is under. The top-right square, high on both, is where they meet.',
      op: 'mean',
      axes: ['Value', 'Pressure'],
      items: [
        ['habitat-suitability', 2, undefined, 0],
        ['ecosystem-resilience', 1, undefined, 0],
        ['habitat-permeability', 1, undefined, 0],
        // Pressure counts from well below the extremes: at the defaults only
        // the most built-up 5% would score, and nothing valuable is there.
        ['cumulative-impacts', 2, 'better', 1, [0.5, 0.85]],
        ['human-footprint-change', 1, 'better', 1, [0.5, 0.85]],
        ['wildfire-hazard', 1, 'better', 1],
      ],
    },
    {
      name: 'Habitat × climate',
      about:
        'Bivariate: good habitat today, set against places sheltered from a warming climate. The top-right square is where the two coincide.',
      op: 'mean',
      axes: ['Habitat now', 'Climate shelter'],
      items: [
        ['habitat-suitability', 1, undefined, 0],
        ['climate-macrorefugia', 1, undefined, 1],
        ['climate-microrefugia', 1, undefined, 1],
      ],
    },
  ];
  let preset: string | null = null;

  // ---- The map -------------------------------------------------------------
  maplibregl.setWorkerUrl(workerUrl);
  maplibregl.addProtocol('pmtiles', new Protocol().tile);
  const [[w, s], [e, n]] = config.limit;
  /** As far as the map pans: the study area and as much again on every
   *  side, so zoomed right out the whole area fits on any screen, the dark
   *  beyond its edge all round it. */
  const ROOM: [LngLat, LngLat] = [[w - (e - w), s - (n - s)], [e + (e - w), n + (n - s)]];
  // On a phone the panel covers the lower half: the area is framed in the
  // part of the map left showing.
  /** Room round an area fitted to the screen. A wider screen: beside the
   *  panel, but centred in the window where it fits without going under
   *  the panel -- the same size either way, only moved. */
  const framing = (b: [LngLat, LngLat]) => {
    if (!matchMedia('(min-width: 48rem)').matches) return { top: 20, left: 20, right: 20, bottom: innerHeight * 0.56 + 10 };
    const [top, bottom, edge, panel] = [20, 20, 20, 25 * 16 + 20];
    const y = (lat: number) => Math.log(Math.tan(Math.PI / 4 + (lat * Math.PI) / 360));
    const w = ((b[1][0] - b[0][0]) * Math.PI) / 180;
    const h = y(b[1][1]) - y(b[0][1]);
    const room = innerWidth - panel - edge;
    const width = w * Math.min(room / w, (innerHeight - top - bottom) / h);
    const left = Math.max(panel, (innerWidth - width) / 2);
    return { top, bottom, left, right: Math.max(edge, innerWidth - left - width) };
  };
  const map = new maplibregl.Map({
    // Room for more tiles than the few screens' worth MapLibre keeps by
    // default, so a flyover's path, loaded before it plays, is still there.
    // ?fly-cache=N tries another size (MapLibre's own is 5).
    maxTileCacheZoomLevels: Number(new URLSearchParams(location.search).get('fly-cache')) || 12,
    container: el,
    bounds: config.bounds,
    maxBounds: ROOM,
    fitBoundsOptions: { padding: framing(config.bounds) },
    maxZoom: 15,
    attributionControl: false,
    dragRotate: false,
    style: studyStyle({ basemap: abs(config.basemap), glyphs: abs(config.glyphs), limit: config.limit }),
  });
  map.addControl(new maplibregl.AttributionControl({ compact: true, customAttribution: 'TerrAdapt-Cascadia, Nature Squamish' }), 'bottom-left');
  map.once('load', () => el.querySelector('.maplibregl-ctrl-attrib')?.classList.remove('maplibregl-compact-show'));
  // Out as far as the whole area beside the panels, and a little more; no
  // further, where it would only be the dark round it.
  const setMinZoom = () => {
    const cam = map.cameraForBounds(config.limit, { padding: framing(config.limit) });
    if (cam?.zoom !== undefined) map.setMinZoom(Math.max(0, cam.zoom - 0.4));
  };
  setMinZoom();
  map.on('resize', setMinZoom);

  const score = new ScoreLayer('score');
  // ?debug: hooks for measuring (tools/bench-dst.mjs), nothing on screen.
  const debug = new URLSearchParams(location.search).has('debug') ? { counts: [] as number[] } : null;
  if (debug) Object.assign(window, { __dst: { map, score, debug } });
  map.on('load', () => {
    addRelief(map, abs(config.terrain));
    addSky(map);
    // Over the land, under the roads and the towns: still a map to find your
    // way by.
    const firstRoad = map.getStyle().layers.find((l) => l.id.startsWith('roads_tunnels'))?.id;
    try {
      map.addLayer(score, firstRoad);
    } catch {
      say('This needs a browser with WebGL 2.');
    }
    push();
  });

  // The scores over the ground's own shape, tilted: the score layer follows
  // the terrain itself (score-layer.ts), so the sliders are as quick in 3D.
  tilting(map, abs(config.terrain), document.getElementById('three-d')!, document.getElementById('tilt')!);

  const toast = document.getElementById('toast')!;
  let toastTimer = 0;
  function say(text: string) {
    toast.textContent = text;
    toast.hidden = false;
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => (toast.hidden = true), 4200);
  }

  const criteria = (): Criterion[] =>
    (soloing() ? [items[solo]] : items).map((i) => ({
      layer: byId.get(i.id)!,
      weight: soloing() ? 1 : i.weight,
      good: i.good,
      bad: i.bad,
      axis: i.axis,
      scores: i.scores,
    }));
  /** The model to the map: lookup tables and uniforms only, so on the next
   *  frame. */
  function push() {
    score.setModel(criteria(), op);
    const two = effectiveMode() === 'two';
    score.setBivariate(two ? { breaks, palette: PALETTE, only } : null);
    syncSteady();
    page.classList.toggle('bi-on', two);
    page.classList.toggle('soloing', soloing());
    document.getElementById('key-title')!.textContent = two ? 'Where they meet' : 'How much fits';
    const note = document.getElementById('key-solo')!;
    note.hidden = !soloing();
    if (soloing())
      note.innerHTML = `Showing <b>${esc(byId.get(items[solo].id)!.name)}</b> alone <button type="button" id="solo-off">Show all</button>`;
    recount();
    saveHash();
  }

  // ---- The panel -----------------------------------------------------------
  const page = el.parentElement!;
  const list = document.getElementById('criteria')!;
  const modeEl = document.getElementById('mode')!;
  const MODE_NOTES: Record<Mode, string> = {
    one: 'Every layer feeds one score, from poor fit to best fit.',
    two: 'Sort the layers into two groups and see where they coincide: each place gets a score for each group, and a colour for the pair.',
  };
  for (const b of modeEl.querySelectorAll<HTMLElement>('[data-mode]')) b.dataset.tip = MODE_NOTES[b.dataset.mode as Mode];
  const presetsEl = document.getElementById('presets')!;
  // One settings group open at a time: name="settings" does it where the
  // browser knows exclusive <details>, this where it does not.
  const folds = document.querySelectorAll<HTMLDetailsElement>('.fold-block');
  for (const d of folds)
    d.addEventListener('toggle', () => {
      if (d.open) for (const o of folds) if (o !== d) o.open = false;
    });
  const opEl = document.getElementById('op')!;
  /** The calculation type as its button names it, for the exports. */
  const opLabel = () => opEl.querySelector(`[data-op="${op}"]`)!.textContent!;
  const OP_NAMES: Record<Op, string> = { mean: 'weighing up', and: 'all must pass', or: 'any one' };
  const OP_NOTES: Record<Op, string> = {
    mean: 'Each layer counts as much as its weight says: a weak layer can be made up for by strong ones.',
    and: 'A place scores only as well as its weakest layer. Weights are set aside.',
    or: 'A place scores as well as its strongest layer. Weights are set aside.',
  };
  // Each calculation type's note as its button's hover tip.
  for (const b of opEl.querySelectorAll<HTMLElement>('[data-op]')) b.dataset.tip = OP_NOTES[b.dataset.op as Op];

  const fmt = (l: Layer, v: number) => {
    if (l.classes) return l.classes.find((c) => c.value === snap(l, v))?.label ?? String(v);
    const span = l.hi - l.lo;
    const d = span >= 100 ? 0 : span >= 10 ? 1 : 2;
    // No "-0" from a value a hair under zero.
    return `${(Math.abs(v) < 0.5 * 10 ** -d ? 0 : v).toFixed(d)}${l.unit ? ` ${l.unit}` : ''}`;
  };

  /** A layer's values as a histogram, the part that scores between the two
   *  thresholds shaded from poor to best. */
  function histSvg(l: Layer, it: Item) {
    const W = 300, H = 44, n = l.hist.length;
    // Square-root scale, so a layer dominated by one value (much of the area
    // at zero impact, say) still shows the rest of its spread.
    const max = Math.sqrt(Math.max(...l.hist)) || 1;
    const x = (v: number) => ((v - l.lo) / (l.hi - l.lo || 1)) * W;
    const bars = l.hist
      .map((c, i) => {
        const h = (Math.sqrt(c) / max) * (H - 4);
        const mid = l.lo + ((i + 0.5) / n) * (l.hi - l.lo);
        const sc = scoreOf({ layer: l, weight: 1, good: it.good, bad: it.bad }, mid);
        return `<rect x="${((i / n) * W).toFixed(1)}" y="${(H - h).toFixed(1)}" width="${(W / n - 1).toFixed(1)}" height="${h.toFixed(1)}" rx="1" fill="${rampCss(sc)}"/>`;
      })
      .join('');
    const mark = (v: number, c: string) => `<line x1="${x(v)}" x2="${x(v)}" y1="0" y2="${H}" stroke="${c}" stroke-width="2"/>`;
    return `<svg class="hist" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-hidden="true">${bars}${mark(it.bad, '#9aa79f')}${mark(it.good, rgb(STOPS[4]))}</svg>`;
  }
  /** The palette the score is drawn in (palettes.ts), for the key's charts. */
  let STOPS: number[][] = PALETTES[0].stops;
  function rampCss(t: number) {
    const s = Math.min(1, Math.max(0, t)) * 4;
    const i = Math.min(3, Math.floor(s));
    const f = s - i;
    const c = STOPS[i].map((a, k) => Math.round(a + (STOPS[i + 1][k] - a) * f));
    return `rgb(${c.join(',')})`;
  }

  /** A weight in words. 1 is neutral -- every layer counts the same --
   *  so the bands are narrow near it and widen upward, as a doubling
   *  matters more than a step: 0.1-0.3, 0.4-0.7, 0.8-1.2, 1.3-1.7,
   *  1.8-2.4, 2.5-3.2, 3.3-4.2, 4.3-5. */
  const WEIGHT_WORDS: [number, string][] = [
    [0.35, 'Very little'],
    [0.75, 'Little'],
    [1.25, 'Neutral'],
    [1.75, 'A bit'],
    [2.45, 'Quite a bit'],
    [3.25, 'A lot'],
    [4.25, 'Lots'],
    [Infinity, 'Most important'],
  ];
  const weightWord = (w: number) => WEIGHT_WORDS.find(([top]) => w < top)![1];

  /** Where the two handles of a layer's one slider sit, for the shading
   *  between them: poor to best, whichever way round they are. */
  function dualStyle(l: Layer, it: Item) {
    const pc = (v: number) => (((v - l.lo) / (l.hi - l.lo || 1)) * 100).toFixed(2);
    return `--bad:${pc(it.bad)}%;--good:${pc(it.good)}%;--lo:${pc(Math.min(it.bad, it.good))}%;--hi:${pc(Math.max(it.bad, it.good))}%;--dir:${it.good >= it.bad ? '90deg' : '270deg'}`;
  }

  function sliderAttrs(l: Layer) {
    if (l.classes) {
      const v = l.classes.map((c) => c.value);
      return `min="${Math.min(...v)}" max="${Math.max(...v)}" step="1"`;
    }
    return `min="${l.lo}" max="${l.hi}" step="${(l.hi - l.lo) / 254}"`;
  }

  /** A categorical layer's kinds, each with its share of the study area and
   *  a Poor / Fair / Good choice. */
  function catsHtml(l: Layer, it: Item) {
    const total = l.hist.reduce((a, b) => a + b, 0) || 1;
    const share = (v: number) => {
      const bin = Math.min(l.hist.length - 1, Math.floor(((v - l.lo) / (l.hi - l.lo || 1)) * l.hist.length));
      return l.hist[bin] / total;
    };
    const LEVELS: [string, number][] = [['Poor', 0], ['Fair', 0.5], ['Good', 1]];
    return `<div class="cats">${l
      .classes!.map((c) => {
        const pct = share(c.value) * 100;
        const s = it.scores?.[c.value] ?? 0.5;
        return `<div class="cat"><span>${esc(c.label)}</span><small>${pct >= 1 ? Math.round(pct) : pct > 0 ? '<1' : 0}%</small>
          <span class="cat-seg" role="group" aria-label="${esc(c.label)}">${LEVELS.map(
            ([name, v]) => `<button type="button" data-act="cat" data-v="${c.value}" data-s="${v}" aria-pressed="${s === v}">${name}</button>`,
          ).join('')}</span></div>`;
      })
      .join('')}</div>`;
  }

  function critHtml(it: Item, i: number) {
    const l = byId.get(it.id)!;
    const better = it.good >= it.bad ? 'Higher = better' : 'Lower = better';
    const on = soloing() && solo === i;
    // A weight only counts against another layer's: in the same score, when
    // there are two.
    const alone = items.filter((x) => mode !== 'two' || x.axis === it.axis).length === 1;
    return `<div class="crit${on ? ' solo' : ''}" data-i="${i}">
      <div class="crit-head">
        <b>${esc(l.name)}</b>
        <button class="icon" type="button" data-act="solo" aria-pressed="${on}" aria-label="Show ${esc(l.name)} alone" title="Show this layer alone">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
        ${
          mode === 'two'
            ? `<button class="icon" type="button" data-act="axis" aria-label="Move to ${esc(axisNames[1 - it.axis])}" title="Move to ${esc(axisNames[1 - it.axis])}">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h14l-4-4M20 16H6l4 4"/></svg>
        </button>`
            : ''
        }
        <button class="icon" type="button" data-act="flip" aria-label="Swap which end is good" title="Swap which end is good">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4v16M4 7l3-3 3 3M17 20V4M14 17l3 3 3-3"/></svg>
        </button>
        ${
          l.detail
            ? `<button class="icon" type="button" data-act="info" aria-expanded="${infoOpen.has(l.id)}" aria-label="About ${esc(l.name)}" title="About this layer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v6"/><circle cx="12" cy="7.5" r="0.6" fill="currentColor"/></svg>
        </button>`
            : ''
        }
        <button class="icon" type="button" data-act="remove" aria-label="Remove ${esc(l.name)}" title="Remove">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
      ${
        l.detail && infoOpen.has(l.id)
          ? `<div class="info">${l.detail.text.map((t) => `<p>${esc(t)}</p>`).join('')}<p class="info-src">Source: ${
              l.detail.href ? `<a href="${esc(l.detail.href)}" target="_blank" rel="noopener">${esc(l.detail.source)}</a>` : esc(l.detail.source)
            }</p></div>`
          : ''
      }
      ${
        l.categorical
          ? `<p class="dir">Score each kind. ${esc(l.about)}</p>${catsHtml(l, it)}`
          : `<p class="dir">${esc(l.about)} <span class="way">${better}</span></p>
      <div class="hist-wrap">${histSvg(l, it)}</div>
      <div class="dual" style="${dualStyle(l, it)}">
        <input type="range" class="t-bad" data-k="bad" ${sliderAttrs(l)} value="${it.bad}" aria-label="Poor at">
        <input type="range" class="t-good" data-k="good" ${sliderAttrs(l)} value="${it.good}" aria-label="Best at">
      </div>
      <div class="thresh${it.good < it.bad ? ' flip' : ''}">
        <span><i class="dot-bad"></i>Poor at <output data-out="bad">${esc(fmt(l, it.bad))}</output></span>
        <span><i class="dot-good"></i>Best at <output data-out="good">${esc(fmt(l, it.good))}</output></span>
      </div>`
      }
      <label class="weight">
        <span class="weight-head">How much do you value this layer? <b data-out="weight-word">${weightWord(it.weight)}</b></span>
        <input type="range" data-k="weight" min="0.1" max="5" step="0.1" value="${it.weight}">
        <span class="weight-foot">${
          alone ? '<small>Add another layer below to use weighting</small>' : ''
        }<output data-out="weight">×${it.weight.toFixed(1)}</output></span></label>
    </div>`;
  }

  /** The add-a-layer menu, for one axis in two-score mode. */
  function addHtml(axis: 0 | 1) {
    const used = new Set(items.map((i) => i.id));
    const full = items.length >= MAX_CRITERIA;
    return `<label class="add"><span class="sr">Add a layer</span><select data-axis="${axis}"${full ? ' disabled' : ''}>
      <option value="">${full ? `Up to ${MAX_CRITERIA} layers at once` : mode === 'two' ? `+ Add to ${esc(axisNames[axis])}` : '+ Add a layer'}</option>
      ${groups
        .map((g) => {
          const opts = config.layers.filter((l) => l.group === g && !used.has(l.id));
          return opts.length
            ? `<optgroup label="${esc(g)}">${opts.map((l) => `<option value="${esc(l.id)}">${esc(l.name)}</option>`).join('')}</optgroup>`
            : '';
        })
        .join('')}
    </select></label>`;
  }

  function render() {
    const cards = (axis?: 0 | 1) =>
      items
        .map((it, i) => (axis === undefined || it.axis === axis ? critHtml(it, i) : ''))
        .join('');
    if (mode === 'two') {
      list.innerHTML = ([0, 1] as const)
        .map(
          (a) => `<div class="axis">
            <div class="axis-head"><i style="background:${AXIS_COLOURS[a]}"></i>
              <input class="axis-name" data-axis="${a}" value="${esc(axisNames[a])}" aria-label="Name of the ${a ? 'second' : 'first'} score" maxlength="24">
              <span class="axis-sub">${a ? 'up the key' : 'across the key'}</span></div>
            ${cards(a) || `<p class="empty">No layers in this score yet.</p>`}
            ${addHtml(a)}
          </div>`,
        )
        .join('');
    } else {
      list.innerHTML =
        (items.length ? cards() : `<p class="empty">No layers yet. Start from an example, or add one below.</p>`) + addHtml(0);
    }
    for (const b of modeEl.querySelectorAll<HTMLButtonElement>('button'))
      b.setAttribute('aria-checked', String(b.dataset.mode === mode));
    document.getElementById('mode-note')!.textContent = MODE_NOTES[mode];
    document.getElementById('mode-val')!.textContent = mode === 'two' ? 'Bivariate' : 'Single';
    document.getElementById('op-val')!.textContent = opEl.querySelector(`[data-op="${op}"]`)!.textContent!;
    document.getElementById('preset-val')!.textContent = preset ?? (items.length ? 'Your own mix' : '');

    for (const b of opEl.querySelectorAll<HTMLButtonElement>('button'))
      b.setAttribute('aria-checked', String(b.dataset.op === op));
    document.getElementById('op-note')!.textContent =
      OP_NOTES[op] + (mode === 'two' ? ' Each of the two scores is combined this way.' : '');
    page.classList.toggle('op-and', op === 'and');
    page.classList.toggle('op-or', op === 'or');
    for (const b of presetsEl.querySelectorAll<HTMLButtonElement>('button'))
      b.setAttribute('aria-pressed', String(b.dataset.name === preset));
    const chosen = PRESETS.find((p) => p.name === preset);
    document.getElementById('preset-note')!.textContent = chosen
      ? `${chosen.about} An example of what the tool can do, not a recommendation.`
      : items.length
        ? 'Your own mix. Pick an example to start again.'
        : '';
    renderKeyTwo();
  }

  presetsEl.innerHTML = PRESETS.filter((p) => p.items.every(([id]) => byId.has(id)))
    .map((p) => `<button type="button" data-name="${esc(p.name)}" data-tip="${esc(p.about)}" aria-pressed="false">${esc(p.name)}</button>`)
    .join('');
  function usePreset(name: string) {
    const p = PRESETS.find((x) => x.name === name)!;
    items = p.items.map(([id, wt, higher, axis, q]) => fresh(id, wt, higher, axis ?? 0, q));
    op = p.op;
    mode = p.axes ? 'two' : 'one';
    axisNames = p.axes ? [...p.axes] : [...AXIS_NAMES];
    only = -1;
    solo = -1;
    preset = name;
    render();
    push();
  }
  // A pointer resting on an example gets its layers ready, so the click has
  // less to wait for.
  const warmed = new Set<string>();
  const warmPreset = (e: Event) => {
    const name = (e.target as HTMLElement).closest<HTMLButtonElement>('button')?.dataset.name;
    const p = name && !warmed.has(name) && PRESETS.find((x) => x.name === name);
    if (!p) return;
    warmed.add(name);
    const ls = p.items.map(([id]) => byId.get(id)!);
    score.warm(ls.map((l) => l.src));
    stats.postMessage({ warm: ls.map((l) => abs(l.sampleSrc)) });
  };
  presetsEl.addEventListener('pointerover', warmPreset);
  presetsEl.addEventListener('focusin', warmPreset);
  presetsEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (b) usePreset(b.dataset.name!);
  });
  opEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    op = b.dataset.op as Op;
    preset = null;
    render();
    push();
  });
  list.addEventListener('change', (e) => {
    const sel = e.target as HTMLSelectElement;
    if (sel.tagName !== 'SELECT' || !sel.value) return;
    const axis = Number(sel.dataset.axis) as 0 | 1;
    items.push(fresh(sel.value, 1, undefined, axis));
    preset = null;
    render();
    push();
    list.querySelector(`select[data-axis="${axis}"]`)?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  });
  modeEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b || b.dataset.mode === mode) return;
    mode = b.dataset.mode as Mode;
    only = -1;
    solo = -1;
    preset = null;
    render();
    push();
  });
  list.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-act]');
    if (!b) return;
    const i = Number(b.closest<HTMLElement>('.crit')!.dataset.i);
    const act = b.dataset.act;
    if (act === 'info') {
      const id = items[i].id;
      if (!infoOpen.delete(id)) infoOpen.add(id);
      render();
      return;
    }
    if (act === 'solo') {
      solo = solo === i ? -1 : i;
      render();
      push();
      return;
    }
    if (act === 'remove') {
      items.splice(i, 1);
      if (solo === i) solo = -1;
      else if (solo > i) solo--;
    } else if (act === 'axis') items[i].axis = (1 - items[i].axis) as 0 | 1;
    else if (act === 'cat') items[i].scores = { ...items[i].scores, [Number(b.dataset.v)]: Number(b.dataset.s) };
    else if (items[i].scores)
      // Swapping ends on a categorical layer turns every score over.
      items[i].scores = Object.fromEntries(Object.entries(items[i].scores!).map(([k, v]) => [k, 1 - v]));
    else [items[i].good, items[i].bad] = [items[i].bad, items[i].good];
    preset = null;
    render();
    push();
  });
  // Dragging a slider: the map and this criterion's own readouts, in place --
  // not a re-render of the panel, which would drop the slider mid-drag.
  list.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    if (input.classList.contains('axis-name')) {
      // Renamed in place: the key and the menus follow, the panel is not
      // redrawn under the cursor.
      axisNames[Number(input.dataset.axis)] = input.value.trim() || AXIS_NAMES[Number(input.dataset.axis)];
      renderKeyTwo();
      showNumbers();
      saveHash();
      return;
    }
    const row = input.closest<HTMLElement>('.crit');
    if (!row || !input.dataset.k) return;
    const it = items[Number(row.dataset.i)];
    const l = byId.get(it.id)!;
    const k = input.dataset.k as 'good' | 'bad' | 'weight';
    it[k] = Number(input.value);
    preset = null;
    for (const b of presetsEl.querySelectorAll('button')) b.setAttribute('aria-pressed', 'false');
    document.getElementById('preset-note')!.textContent = 'Your own mix. Pick an example to start again.';
    document.getElementById('preset-val')!.textContent = 'Your own mix';
    row.querySelector(`[data-out="${k}"]`)!.textContent = k === 'weight' ? `×${it.weight.toFixed(1)}` : fmt(l, it[k]);
    if (k === 'weight') row.querySelector('[data-out="weight-word"]')!.textContent = weightWord(it.weight);
    if (k !== 'weight') {
      row.querySelector('.hist-wrap')!.innerHTML = histSvg(l, it);
      row.querySelector('.way')!.textContent = it.good >= it.bad ? 'Higher = better' : 'Lower = better';
      row.querySelector('.dual')!.setAttribute('style', dualStyle(l, it));
      row.querySelector('.thresh')!.classList.toggle('flip', it.good < it.bad);
      // The handle last moved on top, so two that meet can still be parted.
      for (const x of row.querySelectorAll('.dual input')) x.classList.toggle('front', x === input);
    }
    push();
  });
  // ---- The numbers ---------------------------------------------------------
  // Counted in a worker from each layer's area sample, a moment after the
  // model stops changing: the map answers every frame, the numbers as soon
  // as they are sure.
  const stats = new Worker(new URL('../lib/dst/stats-worker.ts', import.meta.url), { type: 'module' });
  const keyEl = document.querySelector<HTMLElement>('.key')!;
  const keyFold = document.getElementById('key-fold')!;
  keyFold.addEventListener('click', () => {
    const open = keyFold.getAttribute('aria-expanded') !== 'true';
    keyFold.setAttribute('aria-expanded', String(open));
    keyFold.setAttribute('aria-label', open ? 'Minimise' : 'Open');
    keyEl.classList.toggle('folded', !open);
  });
  // Either way off the page loses the model on the map: asked first. (The
  // link button in the panel keeps it, for coming back to.)
  confirmLeave(document.querySelector<HTMLAnchorElement>('#home'));
  confirmLeave(document.querySelector<HTMLAnchorElement>('#to-map'));

  // ---- Legend --------------------------------------------------------------
  // Open or folded as it was left, in this browser.
  const legend = document.getElementById('legend') as HTMLDetailsElement;
  try {
    if (localStorage.getItem('dst-legend') === 'closed') legend.open = false;
  } catch {}
  legend.addEventListener('toggle', () => {
    try {
      localStorage.setItem('dst-legend', legend.open ? 'open' : 'closed');
    } catch {}
  });

  // ---- Colours -------------------------------------------------------------
  // The palette one score is drawn in: the map, the key's charts, the best
  // places' pins. Kept in this browser for next time.
  const palWrap = document.getElementById('pal-wrap')!;
  const palBtn = document.getElementById('pal-btn')!;
  const palMenu = document.getElementById('pal-menu')!;
  function usePalette(id: string | null) {
    const p = paletteById(id);
    STOPS = p.stops;
    score.setPalette(p.stops);
    el.parentElement!.style.setProperty('--ramp-hi', rgb(p.stops[4]));
    el.parentElement!.style.setProperty('--ramp-mid', rgb(p.stops[3]));
    el.parentElement!.style.setProperty('--ramp', `linear-gradient(90deg, ${p.stops.map(rgb).join(', ')})`);
    palMenu.innerHTML = PALETTES.map(
      (q) =>
        `<button type="button" role="radio" aria-checked="${q.id === p.id}" data-palette="${q.id}">` +
        `<span>${q.name}</span><i class="pal-bar" style="background:linear-gradient(90deg,${q.stops.map(rgb).join(',')})"></i></button>`,
    ).join('');
    try {
      localStorage.setItem('dst-palette', p.id);
    } catch {}
  }
  usePalette((() => {
    try {
      return localStorage.getItem('dst-palette');
    } catch {
      return null;
    }
  })());
  const showPalettes = (open: boolean) => {
    palMenu.hidden = !open;
    palBtn.setAttribute('aria-expanded', String(open));
  };
  palBtn.addEventListener('click', () => {
    // One menu out at a time: they open into the same space.
    if (palMenu.hidden) closeOthers();
    showPalettes(palMenu.hidden);
  });
  palMenu.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-palette]');
    if (!b) return;
    usePalette(b.dataset.palette!);
    render();
    showNumbers();
  });
  document.addEventListener('click', (e) => {
    if (!palMenu.hidden && !palWrap.contains(e.target as Node)) showPalettes(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !palMenu.hidden) showPalettes(false);
  });
  const pctEl = document.getElementById('pct')!;
  const kmEl = document.getElementById('km')!;
  const spreadEl = document.getElementById('spread')!;
  const footEl = document.getElementById('key-foot')!;
  const cutIn = document.getElementById('cut') as HTMLInputElement;
  const cutOut = document.getElementById('cut-out')!;
  const onlyIn = document.getElementById('only') as HTMLInputElement;
  const steadyIn = document.getElementById('steady-on') as HTMLInputElement;
  /** How steady is shown when asked for and there are weights to nudge. */
  const steadyActive = () => steadyIn.checked && effectiveMode() === 'one' && op === 'mean' && criteria().length > 1;
  const scopeEl = document.getElementById('scope')!;
  type Scope = 'region' | 'view' | 'area';
  let scope: Scope = 'region';
  /** The latest count for each scope. */
  const tallies: Record<Scope, Tally | null> = { region: null, view: null, area: null };
  const current = () => tallies[scope];
  const WHERE: Record<Scope, string> = { region: 'across the study area', view: 'in view', area: 'in the drawn area' };
  let seq = 0;
  let countTimer = 0;
  const cut = () => Number(cutIn.value) / 100;
  const grid = config.layers[0]?.sample;

  /** The part of the map that can be seen -- not what the panel covers on a
   *  wide screen -- as sample cells, for counting "this view". */
  function viewCells(): [number, number, number, number] | null {
    if (!grid) return null;
    const panel = document.getElementById('panel')!;
    // Folded to its title, the panel hides next to nothing.
    const wide = matchMedia('(min-width: 48rem)').matches && !document.getElementById('panel-body')!.hidden;
    const left = wide ? panel.getBoundingClientRect().right - el.getBoundingClientRect().left : 0;
    const nw = map.unproject([Math.max(0, left), 0]);
    const se = map.unproject([el.clientWidth, el.clientHeight]);
    const n = 2 ** grid.z * 256;
    const px = (lng: number, lat: number) => {
      const r = (lat * Math.PI) / 180;
      return [((lng + 180) / 360) * n, ((1 - Math.log(Math.tan(r) + 1 / Math.cos(r)) / Math.PI) / 2) * n];
    };
    const [x0, y0] = px(nw.lng, nw.lat);
    const [x1, y1] = px(se.lng, se.lat);
    const c = (x: number) => Math.floor((x - grid.x0) / grid.step);
    const r = (y: number) => Math.floor((y - grid.y0) / grid.step);
    return [Math.max(0, c(x0)), Math.max(0, r(y0)), Math.min(grid.w, c(x1) + 1), Math.min(grid.h, r(y1) + 1)];
  }

  /** The model as the counting worker takes it: every layer's lookup table
   *  (the shader's own), weights and axes. */
  function statsModel() {
    const cs = criteria();
    const luts = new Uint8Array(cs.length * 256);
    cs.forEach((c, i) => luts.set(criterionLut(c), i * 256));
    return {
      grid: grid!,
      op,
      cut: cut(),
      breaks: effectiveMode() === 'two' ? breaks : null,
      steady: steadyActive(),
      layers: cs.map((c) => ({ src: abs(byId.get(c.layer.id)!.sampleSrc), weight: c.weight, axis: c.axis ?? 0 })),
      luts,
    };
  }
  /** The whole area is counted once per model; a model counted before is
   *  answered from here, so going back and forth costs nothing. */
  const regionCache = new Map<string, Tally>();
  const modelKey = (m: ReturnType<typeof statsModel>) =>
    JSON.stringify([m.op, m.cut, m.breaks, m.steady, m.layers, Array.from(m.luts)]);

  function recount() {
    clearTimeout(countTimer);
    if (!grid || !items.length) {
      tallies.region = tallies.view = tallies.area = null;
      showNumbers();
      showBest();
      return;
    }
    countTimer = window.setTimeout(() => {
      const m = statsModel();
      const key = modelKey(m);
      const hit = regionCache.get(key);
      if (hit) {
        // Any count still on its way is for an older model: bumping the
        // sequence drops it, rather than letting it land over this one and be
        // cached under this model's key.
        seq++;
        tallies.region = hit;
        showNumbers();
        showBest();
      } else stats.postMessage({ ...m, seq: ++seq, kind: 'region', view: null } satisfies StatsRequest);
      regionKey = key;
      if (scope === 'view') recountView();
      if (scope === 'area') recountArea();
    }, 120);
  }
  /** The view alone, over just its own rectangle: after a pan or zoom, or
   *  when "This view" is chosen. */
  function recountView() {
    if (!grid || !items.length) return;
    stats.postMessage({ ...statsModel(), seq: ++viewSeq, kind: 'view', view: viewCells() } satisfies StatsRequest);
  }
  /** Inside the drawn outline only. */
  function recountArea() {
    if (!grid || !items.length || drawn.length < 3) return;
    const n = 2 ** grid.z * 256;
    const ring = drawn.map(([lng, lat]) => {
      const r = (lat * Math.PI) / 180;
      const x = ((lng + 180) / 360) * n, y = ((1 - Math.log(Math.tan(r) + 1 / Math.cos(r)) / Math.PI) / 2) * n;
      return [(x - grid.x0) / grid.step, (y - grid.y0) / grid.step] as [number, number];
    });
    stats.postMessage({ ...statsModel(), seq: ++areaSeq, kind: 'area', view: null, area: ring } satisfies StatsRequest);
  }
  let regionKey = '';
  let viewSeq = 0;
  let areaSeq = 0;
  stats.onmessage = (e: MessageEvent<StatsResponse>) => {
    const d = e.data;
    if (d.seq !== (d.kind === 'region' ? seq : d.kind === 'view' ? viewSeq : areaSeq)) return;
    if ('loading' in d) {
      keyEl.classList.add('loading');
      return;
    }
    keyEl.classList.remove('loading');
    if (debug) debug.counts.push(d.ms);
    if (d.kind === 'region') {
      regionCache.set(regionKey, d.tally);
      if (regionCache.size > 50) regionCache.delete(regionCache.keys().next().value!);
    }
    tallies[d.kind] = d.tally;
    showNumbers();
    showBest();
  };

  /** How sure the numbers are: sampled at full detail every ~200 m, which is
   *  exact enough for the study area, but zoomed right in few samples fall in
   *  view. */
  const precision = (t: Tally) =>
    t.points < 2000
      ? `Zoomed in this close, only ${t.points.toLocaleString('en-CA')} sample points are in view: treat these as approximate.`
      : 'Counted at full detail.';
  const km2 = (v: number) =>
    v >= 100 ? `${Math.round(v).toLocaleString('en-CA')} km²` : v >= 1 ? `${v.toFixed(1)} km²` : `${Math.round(v * 100)} ha`;

  function showNumbers() {
    const t = current();
    if (effectiveMode() === 'two') return showNumbersTwo(t);
    const c = Math.round(cut() * 100);
    cutOut.textContent = String(c);
    if (!t || !t.total) {
      pctEl.textContent = '–';
      kmEl.textContent = items.length ? 'No data here for these layers.' : 'Add a layer to see how much fits.';
      spreadEl.innerHTML = '';
      footEl.textContent = '';
      return;
    }
    pctEl.textContent = `${Math.round((t.above / t.total) * 100)}%`;
    kmEl.innerHTML = `${km2(t.above)}<br>scores ${c} or more`;
    spreadEl.innerHTML = spreadSvg(t, cut());
    const rows = document.getElementById('steady-rows')!;
    if (steadyActive() && t.steady.length === 4) {
      const NAMES = ['Always a good fit', 'Mostly (12–15 of 16)', 'Sometimes (1–11)', 'Never'];
      const SHADES = [1, 0.85, 0.45, 0];
      rows.innerHTML = t.steady
        .map(
          (a, i) =>
            `<div><i style="background:${rampCss(SHADES[i])}"></i>${NAMES[i]}<span>${km2(a)}</span><span>${Math.round((a / t.total) * 100)}%</span></div>`,
        )
        .join('');
    } else rows.innerHTML = '';
    footEl.textContent =
      `Of the ${km2(t.total)} ${WHERE[scope]} that these layers cover. ` +
      `Average score ${Math.round(t.mean * 100)}. ${precision(t)}`;
  }

  /** The spread of scores by area, in the map's own colours: the key and the
   *  distribution in one. Bars under the cut-off are faded. */
  function spreadSvg(t: Tally, cutAt: number) {
    const W = 300, H = 56, n = t.hist.length;
    const max = Math.max(...t.hist) || 1;
    const bars = t.hist
      .map((a, i) => {
        const h = Math.max(a > 0 ? 1.5 : 0, (a / max) * (H - 2));
        const lo = i / n, hi = (i + 1) / n;
        const tip = `${Math.round(lo * 100)}–${Math.round(hi * 100)}: ${km2(a)} (${Math.round((a / t.total) * 100)}%)`;
        return `<rect x="${((i / n) * W + 1).toFixed(1)}" y="${(H - h).toFixed(1)}" width="${(W / n - 2).toFixed(1)}" height="${h.toFixed(1)}" rx="2" fill="${rampCss((i + 0.5) / n)}" opacity="${lo + 1e-9 >= cutAt ? 1 : 0.35}"><title>${tip}</title></rect>`;
      })
      .join('');
    const x = cutAt * W;
    return `<svg viewBox="0 0 ${W} ${H}" preserveAspectRatio="none">${bars}<line x1="${x}" x2="${x}" y1="0" y2="${H}" stroke="#eef2ee" stroke-width="1.5" stroke-dasharray="3 3"/></svg>`;
  }

  // ---- Two scores: the key ---------------------------------------------------
  const biGrid = document.getElementById('bi-grid')!;
  const biPct = document.getElementById('bi-pct')!;
  const biKm = document.getElementById('bi-km')!;
  const biBrk = document.getElementById('bi-brk')!;
  const BANDS = ['Low', 'Medium', 'High'];
  /** Which cell the headline is about: the one shown alone, the one under
   *  the pointer, or high on both. */
  let hovered = -1;
  const cellName = (cell: number) =>
    `${BANDS[cell % 3]} ${axisNames[0].toLowerCase()}, ${BANDS[Math.floor(cell / 3)].toLowerCase()} ${axisNames[1].toLowerCase()}`;

  function renderKeyTwo() {
    document.getElementById('bi-x')!.innerHTML = `<i>${esc(axisNames[0])}</i> →`;
    document.getElementById('bi-y')!.innerHTML = `<i>${esc(axisNames[1])}</i> →`;
    document.getElementById('lg-bi-x')!.innerHTML = `→ Higher <i>${esc(axisNames[0])}</i>`;
    document.getElementById('lg-bi-y')!.innerHTML = `↑ Higher <i>${esc(axisNames[1])}</i>`;
    document.getElementById('lg-bi-grid')!.innerHTML = [6, 7, 8, 3, 4, 5, 0, 1, 2].map((c) => `<i style="background:${PALETTE[c]}"></i>`).join('');
    // Top row first: high on the second axis.
    biGrid.innerHTML = [6, 7, 8, 3, 4, 5, 0, 1, 2]
      .map((c) => `<button type="button" data-cell="${c}" style="background:${PALETTE[c]}" aria-pressed="${c === only}" aria-label="${esc(cellName(c))}"></button>`)
      .join('');
    biGrid.classList.toggle('isolating', only >= 0);
    const pc = (v: number) => Math.round(v * 100);
    biBrk.innerHTML = ([0, 1] as const)
      .map(
        (a) => `<div class="brk" data-axis="${a}"><b>${esc(axisNames[a])}</b>
          <label>Low below <output>${pc(breaks[a][0])}</output>
            <input type="range" data-b="0" min="5" max="90" step="5" value="${pc(breaks[a][0])}"></label>
          <label>High from <output>${pc(breaks[a][1])}</output>
            <input type="range" data-b="1" min="10" max="95" step="5" value="${pc(breaks[a][1])}"></label></div>`,
      )
      .join('');
  }

  function showNumbersTwo(t: Tally | null) {
    for (const b of biGrid.querySelectorAll<HTMLButtonElement>('button')) {
      const c = Number(b.dataset.cell);
      b.title = t && t.total ? `${cellName(c)}: ${km2(t.cells[c])} (${Math.round((t.cells[c] / t.total) * 100)}%)` : cellName(c);
    }
    const cell = hovered >= 0 ? hovered : only >= 0 ? only : 8;
    const both = items.some((i) => i.axis === 0) && items.some((i) => i.axis === 1);
    if (!t || !t.total) {
      biPct.textContent = '–';
      biKm.textContent = !items.length
        ? 'Add layers to both scores to see how they overlap.'
        : !both
          ? 'Each score needs at least one layer.'
          : 'No data here for these layers.';
      footEl.textContent = '';
      return;
    }
    biPct.textContent = `${Math.round((t.cells[cell] / t.total) * 100)}%`;
    biKm.innerHTML = `${km2(t.cells[cell])}<br>${esc(cellName(cell).toLowerCase())}`;
    footEl.textContent =
      `Of the ${km2(t.total)} ${WHERE[scope]} where both scores have data. ${precision(t)}`;
  }

  biGrid.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    const c = Number(b.dataset.cell);
    only = only === c ? -1 : c;
    for (const x of biGrid.querySelectorAll('button')) x.setAttribute('aria-pressed', String(Number(x.getAttribute('data-cell')) === only));
    biGrid.classList.toggle('isolating', only >= 0);
    score.setBivariate({ breaks, palette: PALETTE, only });
    showNumbers();
  });
  biGrid.addEventListener('pointerover', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    hovered = b ? Number(b.dataset.cell) : -1;
    showNumbers();
  });
  biGrid.addEventListener('pointerleave', () => {
    hovered = -1;
    showNumbers();
  });
  biBrk.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    const a = Number(input.closest<HTMLElement>('.brk')!.dataset.axis);
    const k = Number(input.dataset.b);
    let v = Number(input.value) / 100;
    // Low stays below high.
    if (k === 0) v = Math.min(v, breaks[a][1] - 0.05);
    else v = Math.max(v, breaks[a][0] + 0.05);
    breaks[a][k] = v;
    input.value = String(Math.round(v * 100));
    input.previousElementSibling!.textContent = String(Math.round(v * 100));
    score.setBivariate({ breaks, palette: PALETTE, only });
    recount();
    saveHash();
  });

  /** The steadiness switch: usable only with weights to nudge, and the map
   *  and its note to match. */
  function syncSteady() {
    const can = effectiveMode() === 'one' && op === 'mean' && criteria().length > 1;
    const label = document.getElementById('steady-label')!;
    steadyIn.disabled = !can;
    label.classList.toggle('off', !can);
    label.title = can
      ? ''
      : effectiveMode() === 'two'
        ? 'For one score.'
        : op !== 'mean'
          ? 'Only weighing up has weights to nudge.'
          : 'Needs two or more layers to weigh against each other.';
    score.setSteady(steadyActive() ? cut() : null);
    document.getElementById('steady')!.hidden = !steadyActive();
  }
  steadyIn.addEventListener('change', () => {
    syncSteady();
    recount();
    saveHash();
  });
  cutIn.addEventListener('input', () => {
    if (onlyIn.checked) score.setCut(cut());
    if (steadyActive()) score.setSteady(cut());
    showNumbers();
    recount();
    saveHash();
  });
  onlyIn.addEventListener('change', () => score.setCut(onlyIn.checked ? cut() : 0));
  scopeEl.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    // "Draw" again while its area is showing: draw a new one.
    if (b.dataset.scope === 'area' && (scope === 'area' || !drawn.length)) startDraw();
    scope = b.dataset.scope as Scope;
    for (const x of scopeEl.querySelectorAll('button')) x.setAttribute('aria-checked', String(x === b));
    if (scope === 'view') recountView();
    if (scope === 'area') recountArea();
    showDrawn();
    showNumbers();
    showBest();
  });
  // ---- Drawing an area --------------------------------------------------------
  // RRN's parcel totals, for any outline: click round an area, double-click
  // (or click the first point) to close it, and every number counts inside
  // it alone. Escape leaves off.
  let drawn: [number, number][] = [];
  let drawing = false;
  let drawEnded = 0;
  let hover: [number, number] | null = null;
  const drawnSource = () => map.getSource('drawn') as maplibregl.GeoJSONSource | undefined;
  function showDrawn() {
    const src = drawnSource();
    if (!src) return;
    const pts = drawing && hover ? [...drawn, hover] : drawn;
    const show = drawing || scope === 'area';
    src.setData({
      type: 'FeatureCollection',
      features:
        !show || !pts.length
          ? []
          : [
              drawing
                ? { type: 'Feature', properties: {}, geometry: { type: 'LineString', coordinates: pts } }
                : { type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [[...pts, pts[0]]] } },
              ...drawn.map((c) => ({ type: 'Feature' as const, properties: { vertex: 1 }, geometry: { type: 'Point' as const, coordinates: c } })),
            ],
    });
    // Off while there is nothing drawn, so the map has no tiles of it to cut.
    const vis = show && pts.length ? 'visible' : 'none';
    for (const id of ['drawn-fill', 'drawn-line', 'drawn-pts']) map.setLayoutProperty(id, 'visibility', vis);
  }
  function startDraw() {
    drawing = true;
    drawn = [];
    hover = null;
    stopTour();
    popup.remove();
    map.doubleClickZoom.disable();
    map.getCanvas().style.cursor = 'crosshair';
    say('Click round the area you want to count. Double-click, or click the first point, to finish.');
    showDrawn();
  }
  function endDraw(keep: boolean) {
    drawing = false;
    drawEnded = Date.now();
    map.getCanvas().style.cursor = '';
    setTimeout(() => map.doubleClickZoom.enable(), 350);
    if (!keep || drawn.length < 3) {
      drawn = keep ? drawn : [];
      if (drawn.length < 3) {
        drawn = [];
        if (scope === 'area') {
          scope = 'region';
          for (const x of scopeEl.querySelectorAll<HTMLButtonElement>('button')) x.setAttribute('aria-checked', String(x.dataset.scope === 'region'));
          showNumbers();
          showBest();
        }
      }
    }
    showDrawn();
    if (drawn.length >= 3) {
      recountArea();
      saveHash();
    }
  }
  map.on('load', () => {
    map.addSource('drawn', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    map.addLayer({ id: 'drawn-fill', layout: { visibility: 'none' }, type: 'fill', source: 'drawn', filter: ['==', ['geometry-type'], 'Polygon'], paint: { 'fill-color': '#eef2ee', 'fill-opacity': 0.07 } });
    map.addLayer({ id: 'drawn-line', layout: { visibility: 'none' }, type: 'line', source: 'drawn', filter: ['!=', ['geometry-type'], 'Point'], paint: { 'line-color': '#eef2ee', 'line-width': 2, 'line-dasharray': [3, 2] } });
    map.addLayer({ id: 'drawn-pts', layout: { visibility: 'none' }, type: 'circle', source: 'drawn', filter: ['==', ['geometry-type'], 'Point'], paint: { 'circle-radius': 4, 'circle-color': '#0d1210', 'circle-stroke-color': '#eef2ee', 'circle-stroke-width': 2 } });
    showDrawn();
  });
  map.on('click', (e) => {
    if (!drawing) return;
    const p = [e.lngLat.lng, e.lngLat.lat] as [number, number];
    // Back on the first point closes the outline.
    if (drawn.length >= 3) {
      const first = map.project(drawn[0]);
      if (Math.hypot(first.x - e.point.x, first.y - e.point.y) < 12) return endDraw(true);
    }
    drawn.push(p);
    showDrawn();
  });
  map.on('dblclick', (e) => {
    if (!drawing) return;
    e.preventDefault();
    // The double-click's two clicks each added a point: one is enough.
    drawn.pop();
    endDraw(true);
  });
  map.on('mousemove', (e) => {
    if (!drawing) return;
    hover = [e.lngLat.lng, e.lngLat.lat];
    showDrawn();
  });
  window.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (drawing) endDraw(false);
    else {
      popup.remove();
      stopTour();
    }
  });

  // "This view" follows the map; the whole area does not need recounting.
  map.on('moveend', () => {
    if (scope === 'view' && !flying) recountView();
  });

  keyEl.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).id !== 'solo-off') return;
    solo = -1;
    render();
    push();
  });

  // ---- A link to this model --------------------------------------------------
  // The whole model -- layers, thresholds, weights, how they combine, the
  // two-score names and breaks, the cut-off -- lives in the address, so a
  // link reopens exactly what was on screen. Written as the model changes
  // (replacing, not adding to, the history), read once on opening.
  type Saved = {
    v: 1;
    m: Mode;
    o: Op;
    a: [string, string];
    b: [[number, number], [number, number]];
    c: number;
    i: [string, number, number, number, 0 | 1, Record<number, number>?][];
    /** A drawn area, when there is one. */
    d?: [number, number][];
    /** How steady is showing. */
    s?: 1;
    /** A flyover's views: lng, lat, zoom, turn, tilt, ground height, and
     *  the callout's title and text. */
    f?: [number, number, number, number, number, number?, string?, string?][];
  };
  const r4 = (v: number) => Number(v.toPrecision(4));
  let hashTimer = 0;
  const MAX_VIEWS = 30;
  const TITLE_MAX = 60;
  const TEXT_MAX = 240;
  /** A flyover's view, with its callout if it has one. */
  type FlyView = View & { title?: string; text?: string };
  let flyViews: FlyView[] = [];
  const hasCallout = (v: FlyView) => !!(v.title?.trim() || v.text?.trim());
  // The model in the address, as JSON: deflated (#z=) where the browser can,
  // which makes a link with a flyover about a third as long -- and its QR code
  // coarser, so it prints sharper. Plain (#m=) otherwise, and still read.
  const toB64 = (bytes: Uint8Array) => btoa(String.fromCharCode(...bytes)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
  const fromB64 = (b64: string) => Uint8Array.from(atob(b64.replace(/-/g, '+').replace(/_/g, '/')), (ch) => ch.charCodeAt(0));
  const through = async (bytes: Uint8Array, stream: CompressionStream | DecompressionStream) =>
    new Uint8Array(await new Response(new Blob([bytes as BlobPart]).stream().pipeThrough(stream)).arrayBuffer());
  let hashRun = 0;
  /** The address brought up to date a moment after the last change. */
  function saveHash() {
    clearTimeout(hashTimer);
    hashTimer = window.setTimeout(writeHash, 250);
  }
  /** The address brought up to date now, for a link or code made from it. */
  function flushHash() {
    clearTimeout(hashTimer);
    return writeHash();
  }
  async function writeHash() {
    const me = ++hashRun;
    if (!items.length) {
      history.replaceState(null, '', location.pathname + location.search);
      return;
    }
    const saved: Saved = {
      v: 1,
      m: mode,
      o: op,
      a: axisNames,
      b: breaks,
      c: Number(cutIn.value),
      i: items.map((it) => [it.id, it.weight, r4(it.bad), r4(it.good), it.axis, ...(it.scores ? [it.scores] : [])] as Saved['i'][number]),
      ...(steadyIn.checked ? { s: 1 as const } : {}),
      ...(drawn.length >= 3 ? { d: drawn.map(([x, y]) => [Number(x.toFixed(5)), Number(y.toFixed(5))] as [number, number]) } : {}),
      ...(flyViews.length
        ? {
            f: flyViews.map(
              (v) =>
                [
                  Number(v.lng.toFixed(5)),
                  Number(v.lat.toFixed(5)),
                  Number(v.zoom.toFixed(3)),
                  Number(v.bearing.toFixed(1)),
                  Number(v.pitch.toFixed(1)),
                  Math.round(v.elevation),
                  ...(hasCallout(v) ? [v.title?.trim() ?? '', v.text?.trim() ?? ''] : []),
                ] as NonNullable<Saved['f']>[number],
            ),
          }
        : {}),
    };
    const json = new TextEncoder().encode(JSON.stringify(saved));
    let hash = `m=${toB64(json)}`;
    if (typeof CompressionStream !== 'undefined') {
      try {
        hash = `z=${toB64(await through(json, new CompressionStream('deflate-raw')))}`;
      } catch {}
    }
    // A newer save started while this one was deflating: that one wins.
    if (me !== hashRun) return;
    history.replaceState(null, '', `${location.pathname}${location.search}#${hash}`);
  }
  async function loadHash() {
    const m = location.hash.match(/^#([mz])=([A-Za-z0-9_-]+)/);
    if (!m) return false;
    try {
      let bytes = fromB64(m[2]);
      if (m[1] === 'z') bytes = await through(bytes, new DecompressionStream('deflate-raw'));
      const saved = JSON.parse(new TextDecoder().decode(bytes)) as Saved;
      if (saved.v !== 1) return false;
      items = saved.i
        .filter(([id]) => byId.has(id))
        .slice(0, MAX_CRITERIA)
        .map(([id, weight, bad, good, axis, scores]) => ({ id, weight, bad, good, axis, scores }));
      mode = saved.m === 'two' ? 'two' : 'one';
      op = (['mean', 'and', 'or'] as Op[]).includes(saved.o) ? saved.o : 'mean';
      axisNames = [String(saved.a?.[0] ?? AXIS_NAMES[0]).slice(0, 24), String(saved.a?.[1] ?? AXIS_NAMES[1]).slice(0, 24)];
      if (Array.isArray(saved.b)) breaks = saved.b;
      if (saved.c) cutIn.value = String(saved.c);
      if (Array.isArray(saved.d) && saved.d.length >= 3) drawn = saved.d.slice(0, 200);
      steadyIn.checked = saved.s === 1;
      if (Array.isArray(saved.f))
        flyViews = saved.f.slice(0, MAX_VIEWS).map(([lng, lat, zoom, bearing, pitch, elevation, title, text]) => ({
          lng,
          lat,
          zoom,
          bearing,
          pitch,
          elevation: elevation ?? 0,
          title: String(title ?? '').slice(0, TITLE_MAX),
          text: String(text ?? '').slice(0, TEXT_MAX),
        }));
      return items.length > 0;
    } catch {
      return false;
    }
  }
  document.getElementById('share')!.addEventListener('click', async () => {
    await flushHash();
    try {
      await navigator.clipboard.writeText(location.href);
      say(items.length ? 'Link copied: it opens this exact sandbox.' : 'Link copied.');
    } catch {
      say('Copy the address bar to share this sandbox.');
    }
  });

  // ---- Taking it away ---------------------------------------------------------
  // The map as an image, and the numbers as a table -- for a report or a
  // meeting. The image is the map as drawn, with the key and the model under
  // it, so it stands on its own.
  const loadingBar = document.getElementById('loading-bar')!;
  map.on('render', () => loadingBar.classList.toggle('on', items.length > 0 && score.pending > 0));

  const download = (name: string, href: string) => {
    const a = document.createElement('a');
    a.href = href;
    a.download = name;
    a.click();
  };
  const stamp = () => new Date().toISOString().slice(0, 10);
  /** One line per layer, as the panel has it. */
  const modelLines = () =>
    criteria().map((c) => {
      const l = byId.get(c.layer.id)!;
      const how = c.scores
        ? 'scored by kind'
        : `poor at ${fmt(l, c.bad)}, best at ${fmt(l, c.good)}`;
      const wt = op === 'mean' && !soloing() ? `, ×${c.weight}` : '';
      const axis = effectiveMode() === 'two' ? `[${axisNames[c.axis ?? 0]}] ` : '';
      return `${axis}${l.name}: ${how}${wt}`;
    });

  // The save button's menu: the whole area as a finished map, the view, or
  // the numbers.
  const saveWrap = document.getElementById('save-wrap')!;
  const saveBtn = document.getElementById('save-btn')!;
  const saveMenu = document.getElementById('save-menu')!;
  const showSave = (open: boolean) => {
    saveMenu.hidden = !open;
    saveBtn.setAttribute('aria-expanded', String(open));
  };
  let saving = false;
  saveBtn.addEventListener('click', () => {
    if (!items.length) return say('Add a layer first.');
    if (saveMenu.hidden) closeOthers();
    showSave(saveMenu.hidden);
  });
  saveMenu.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-save]');
    if (!b || saving) return;
    const all = saveMenu.querySelectorAll('button');
    saving = true;
    for (const x of all) x.disabled = true;
    try {
      await ({ full: saveFull, view: saveView, csv: saveCsv, qr: saveQr } as Record<string, () => unknown>)[b.dataset.save!]();
      showSave(false);
    } finally {
      saving = false;
      for (const x of all) x.disabled = false;
    }
  });
  document.addEventListener('click', (e) => {
    if (!saveMenu.hidden && !saving && !saveWrap.contains(e.target as Node)) showSave(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !saveMenu.hidden && !saving) showSave(false);
  });

  /** The canvas as it is drawn next: it is only readable during a render. */
  const grab = () =>
    new Promise<HTMLCanvasElement>((done) => {
      map.once('render', () => {
        const src = map.getCanvas();
        const c = document.createElement('canvas');
        c.width = src.width;
        c.height = src.height;
        c.getContext('2d')!.drawImage(src, 0, 0);
        done(c);
      });
      map.triggerRepaint();
    });

  /** The view as it is, with the key and the model under it. */
  async function saveView() {
    const src = await grab();
    const dpr = src.width / el.clientWidth;
    const lines = modelLines();
    const headline =
      effectiveMode() === 'two'
        ? `${biPct.textContent} ${biKm.textContent?.replace(/\s+/g, ' ')}`
        : `${pctEl.textContent} (${kmEl.textContent?.replace(/\s+/g, ' ')})`;
    const pad = 18 * dpr, line = 17 * dpr, foot = pad * 2 + line * (lines.length + 3);
    const out = document.createElement('canvas');
    out.width = src.width;
    out.height = src.height + foot;
    const ctx = out.getContext('2d')!;
    ctx.fillStyle = '#0d1210';
    ctx.fillRect(0, 0, out.width, out.height);
    ctx.drawImage(src, 0, 0);
    ctx.fillStyle = '#eef2ee';
    ctx.font = `600 ${14 * dpr}px system-ui, sans-serif`;
    let y = src.height + pad + line * 0.8;
    ctx.fillText(`EcoScapes Data Sandbox: ${headline}`, pad, y);
    ctx.font = `${12 * dpr}px system-ui, sans-serif`;
    ctx.fillStyle = '#9aa79f';
    y += line * 1.2;
    ctx.fillText(`Calculation type: ${opLabel()}. Numbers ${WHERE[scope]}. ${stamp()}`, pad, y);
    for (const l of lines) ctx.fillText(l, pad, (y += line));
    download(`ecoscapes-data-sandbox-${stamp()}.png`, out.toDataURL('image/png'));
  }

  /** Everything in view drawn: the map's own tiles and the scores'. */
  const settled = () =>
    new Promise<void>((done) => {
      const until = Date.now() + 30000;
      let calm = 0;
      const check = () => {
        const ready = !map.isMoving() && map.areTilesLoaded() && score.pending === 0;
        calm = ready ? calm + 1 : 0;
        if (calm >= 3 || Date.now() > until) return done();
        map.triggerRepaint();
        setTimeout(check, 150);
      };
      map.once('render', () => setTimeout(check, 150));
      map.triggerRepaint();
    });

  const logo = new Image();
  logo.src = config.logo;
  const emblem = new Image();
  emblem.src = config.emblem;

  /** A code that opens this model, on its own: dark on white for any phone
   *  to read, with the EcoScapes emblem in the middle. The most error
   *  correction the link leaves room for, so the emblem can cover the
   *  middle and the code still reads. */
  async function saveQr() {
    await flushHash();
    const { default: qrcode } = await import('qrcode-generator');
    let qr: ReturnType<typeof qrcode> | null = null;
    let level = '';
    for (const l of ['H', 'Q', 'M', 'L'] as const) {
      try {
        const q = qrcode(0, l);
        q.addData(location.href);
        q.make();
        [qr, level] = [q, l];
        break;
      } catch {}
    }
    if (!qr) return say('This link is too long for a code.');
    if (!emblem.complete) await new Promise((r) => (emblem.onload = emblem.onerror = r));
    const n = qr.getModuleCount();
    const quiet = 4;
    const cell = Math.max(8, Math.ceil(1200 / (n + quiet * 2)));
    const size = (n + quiet * 2) * cell;
    const out = document.createElement('canvas');
    out.width = out.height = size;
    const ctx = out.getContext('2d')!;
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(0, 0, size, size);
    ctx.fillStyle = '#0d1210';
    for (let r = 0; r < n; r++)
      for (let c = 0; c < n; c++) if (qr.isDark(r, c)) ctx.fillRect((c + quiet) * cell, (r + quiet) * cell, cell, cell);
    // The emblem: about a fifth of the code across with high correction, less
    // as the correction drops, on a white ring so its edge stays clean.
    if (emblem.naturalWidth) {
      const share = { H: 0.24, Q: 0.2, M: 0.15, L: 0.1 }[level as 'H' | 'Q' | 'M' | 'L'];
      const d = n * cell * share;
      const mid = size / 2;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(mid, mid, d / 2 + cell, 0, Math.PI * 2);
      ctx.fill();
      ctx.drawImage(emblem, mid - d / 2, mid - d / 2, d, d);
    }
    download(`ecoscapes-data-sandbox-qr-${stamp()}.png`, out.toDataURL('image/png'));
  }

  /** The whole study area to its dashed edge, flat and north up, drawn
   *  sharper than the screen and finished as a map: north, a scale, the key,
   *  the model, where it all comes from, and a code that opens this model.
   *  The camera goes back after. */
  async function saveFull() {
    const out = await drawFull();
    download(`ecoscapes-data-sandbox-full-${stamp()}.png`, out.toDataURL('image/png'));
  }
  async function drawFull() {
    stopTour();
    popup.remove();
    say('Drawing the full map…');
    const before = { center: map.getCenter(), zoom: map.getZoom(), pitch: map.getPitch(), bearing: map.getBearing() };
    const ratio = map.getPixelRatio();
    const [[bw, bs], [be, bn]] = config.limit;
    let shot: HTMLCanvasElement, crop: { x: number; y: number; w: number; h: number }, zoom: number, lat: number;
    try {
      map.setMaxBounds(null);
      map.jumpTo({ ...map.cameraForBounds(config.limit, { padding: 6 })!, pitch: 0, bearing: 0 });
      // Sharper than the screen: about 3200 pixels on the long side, within
      // what the graphics card takes.
      const nw = map.project([bw, bn]), se = map.project([be, bs]);
      const long = Math.max(se.x - nw.x, se.y - nw.y);
      const gl = map.getCanvas().getContext('webgl2');
      const maxSide = Math.min(8192, gl ? (gl.getParameter(gl.MAX_RENDERBUFFER_SIZE) as number) : 4096);
      map.setPixelRatio(Math.max(ratio, Math.min(4, 3200 / long, maxSide / Math.max(el.clientWidth, el.clientHeight))));
      await settled();
      shot = await grab();
      // Out by a pixel, so the dashed edge is inside the picture whole.
      const k = shot.width / el.clientWidth;
      const x0 = Math.round((nw.x - 1) * k), y0 = Math.round((nw.y - 1) * k);
      crop = { x: x0, y: y0, w: Math.round((se.x + 1) * k) - x0, h: Math.round((se.y + 1) * k) - y0 };
      zoom = map.getZoom();
      lat = map.getCenter().lat;
    } finally {
      map.setPixelRatio(ratio);
      map.jumpTo(before);
      map.setMaxBounds(ROOM);
    }
    if (!logo.complete) await new Promise((r) => (logo.onload = logo.onerror = r));

    await flushHash();
    const { default: qrcode } = await import('qrcode-generator');
    const qr = qrcode(0, 'L');
    qr.addData(location.href);
    qr.make();

    // Laid out in units of a thousandth of the map's width.
    const u = crop.w / 1000;
    const M = 36 * u;
    const out = document.createElement('canvas');
    const ctx = out.getContext('2d')!;
    const font = (size: number, weight = 400) => (ctx.font = `${weight} ${size * u}px system-ui, -apple-system, 'Segoe UI', sans-serif`);
    /** Text broken into lines no wider than w. */
    const wrap = (text: string, w: number) => {
      const rows: string[] = [];
      let row = '';
      for (const word of text.split(' ')) {
        const next = row ? `${row} ${word}` : word;
        if (row && ctx.measureText(next).width > w) {
          rows.push(row);
          row = word;
        } else row = next;
      }
      return row ? [...rows, row] : rows;
    };

    // The foot's height first: the model, the layers' descriptions and the
    // sources in one column, the code beside them.
    // The code in the head's right-hand corner; everything under the head
    // the full width.
    const qrSize = 76 * u;
    const textW = crop.w;
    // The model as a chart per layer: its values across the area, shaded by
    // the score each gets, with the poor and best marks on it.
    const crits = criteria();
    const cols = crits.length > 1 ? 2 : 1;
    const rowsN = Math.ceil(crits.length / cols);
    const chartGap = 26 * u, chartH = 34 * u, cellH = 84 * u;
    const chartW = (textW - chartGap * (cols - 1)) / cols;
    font(10.5);
    // How to read them, in plain words.
    const explain = wrap(
      'Each bar is a slice of the study area, low values on the left to high on the right; taller means more land. ' +
        'Colour is the score: dark counts little, bright counts most. ' +
        'E.g. a tall bright bar is a lot of land that scores well; a short dark one, a little that scores poorly.',
      textW,
    );
    const used = crits.map((c) => byId.get(c.layer.id)!);
    const from = [...new Set(used.map((l) => l.detail?.source).filter(Boolean))].join('; ') || 'TerrAdapt-Cascadia, Nature Squamish';
    font(10);
    const sources = wrap(
      `${stamp()} · Layers: ${from} · Relief © Mapterhorn · Base map © OpenStreetMap, Protomaps · A demo, not a recommendation`,
      textW,
    );
    const headH = 50 * u;

    // About each layer: its description, in two columns when there is more
    // than one, each block to the shorter column.
    const aboutLH = 15 * u, aboutGap = 26 * u;
    const withText = used.filter((l) => l.detail);
    const aboutCols = withText.length > 1 ? 2 : 1;
    const aboutW = (textW - aboutGap * (aboutCols - 1)) / aboutCols;
    font(10.5);
    const blocks = withText.map((l) => {
      // Paragraphs apart by an empty row.
      const rows = l.detail!.text.flatMap((t, i) => [...(i ? [''] : []), ...wrap(t, aboutW)]);
      return { l, rows, h: 18 * u + rows.length * aboutLH + 16 * u };
    });
    const colH = Array(aboutCols).fill(0) as number[];
    const placed = blocks.map((b) => {
      const c = colH.indexOf(Math.min(...colH));
      const at = { ...b, col: c, y: colH[c] };
      colH[c] += b.h;
      return at;
    });
    const modelH = 12 * u + explain.length * 15 * u + 10 * u + rowsN * cellH;
    const aboutH = blocks.length ? 30 * u + 12 * u + Math.max(...colH) : 0;
    const bodyH = modelH + aboutH + 14 * u + sources.length * 15 * u;
    // The head as tall as the code and its words under it.
    const footH = 24 * u + qrSize + 16 * u + 14 * u + 18 * u + bodyH;
    out.width = Math.round(crop.w + M * 2);
    out.height = Math.round(crop.h + M * 2 + footH);

    ctx.fillStyle = '#0d1210';
    ctx.fillRect(0, 0, out.width, out.height);
    ctx.drawImage(shot, crop.x, crop.y, crop.w, crop.h, M, M, crop.w, crop.h);

    // North, top right, inside the dashed edge.
    const ax = M + crop.w - 44 * u, ay = M + 44 * u;
    ctx.fillStyle = 'rgba(13,18,16,0.75)';
    ctx.beginPath();
    ctx.arc(ax, ay, 28 * u, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#eef2ee';
    ctx.beginPath();
    ctx.moveTo(ax, ay - 2 * u);
    ctx.lineTo(ax + 8 * u, ay + 21 * u);
    ctx.lineTo(ax, ay + 16 * u);
    ctx.lineTo(ax - 8 * u, ay + 21 * u);
    ctx.closePath();
    ctx.fill();
    font(12, 700);
    ctx.textAlign = 'center';
    ctx.fillText('N', ax, ay - 8 * u);
    ctx.textAlign = 'left';

    // A scale, bottom left, inside the edge: a round distance near a fifth of
    // the width.
    const metresPerPx = (40075016.686 * Math.cos((lat * Math.PI) / 180)) / (512 * 2 ** zoom) / (shot.width / el.clientWidth);
    const want = (crop.w / 5) * metresPerPx;
    const step = 10 ** Math.floor(Math.log10(want));
    const dist = [5, 2, 1].map((f) => f * step).find((d) => d <= want)!;
    const barW = dist / metresPerPx, sx = M + 30 * u, sy = M + crop.h - 30 * u;
    ctx.fillStyle = 'rgba(13,18,16,0.75)';
    ctx.fillRect(sx - 12 * u, sy - 28 * u, barW + 24 * u, 44 * u);
    ctx.fillStyle = '#eef2ee';
    ctx.fillRect(sx, sy, barW / 2, 6 * u);
    ctx.strokeStyle = '#eef2ee';
    ctx.lineWidth = 1.5 * u;
    ctx.strokeRect(sx, sy, barW, 6 * u);
    font(12);
    ctx.fillText('0', sx, sy - 8 * u);
    ctx.textAlign = 'right';
    ctx.fillText(`${dist >= 1000 ? dist / 1000 : dist} ${dist >= 1000 ? 'km' : 'm'}`, sx + barW, sy - 8 * u);
    ctx.textAlign = 'left';

    // The head of the foot: the logo and title, the key, and the code at the
    // right, the rest centred on the code.
    const headTop = M + crop.h + 24 * u;
    let y = headTop + (qrSize - headH) / 2;
    const lw = logo.naturalWidth ? (logo.naturalWidth / logo.naturalHeight) * headH : 0;
    if (lw) ctx.drawImage(logo, M, y, lw, headH);
    ctx.fillStyle = '#3a4843';
    ctx.fillRect(M + lw + 20 * u, y + 4 * u, 1.5 * u, headH - 8 * u);
    const tx = M + lw + 40 * u;
    ctx.fillStyle = '#eef2ee';
    font(23, 650);
    ctx.fillText('Sea-to-Sky Data Sandbox', tx, y + 22 * u);
    ctx.fillStyle = '#9aa79f';
    font(13);
    const two = effectiveMode() === 'two';
    const t = tallies.region;
    let headline = '';
    if (t && t.total) {
      if (two) {
        const cell = only >= 0 ? only : 8;
        headline = `${Math.round((t.cells[cell] / t.total) * 100)}% of the study area ${cellName(cell).toLowerCase()} (${km2(t.cells[cell])})`;
      } else {
        headline = `${Math.round((t.above / t.total) * 100)}% of the study area scores ${Math.round(cut() * 100)} or more (${km2(t.above)})`;
      }
    }
    ctx.fillText(headline, tx, y + 44 * u);

    const kx = M + crop.w - qrSize - 36 * u;
    if (two) {
      const c = 20 * u, g = 3 * u, gx = kx - 3 * c - 2 * g;
      [6, 7, 8, 3, 4, 5, 0, 1, 2].forEach((cell, i) => {
        ctx.fillStyle = PALETTE[cell];
        ctx.fillRect(gx + (i % 3) * (c + g), y - 6 * u + Math.floor(i / 3) * (c + g), c, c);
      });
      font(11);
      ctx.fillStyle = '#9aa79f';
      ctx.textAlign = 'right';
      ctx.fillText(`${axisNames[1]} ↑`, gx - 10 * u, y + 10 * u);
      ctx.fillText(`${axisNames[0]} →`, gx - 10 * u, y + 52 * u);
      ctx.textAlign = 'left';
    } else {
      const rw = 200 * u, rh = 12 * u, rx = kx - rw, ry = y + 8 * u;
      const grad = ctx.createLinearGradient(rx, 0, rx + rw, 0);
      for (let i = 0; i <= 10; i++) grad.addColorStop(i / 10, rampCss(i / 10));
      ctx.fillStyle = grad;
      ctx.fillRect(rx, ry, rw, rh);
      ctx.fillStyle = '#eef2ee';
      ctx.fillRect(rx + rw * cut() - u, ry - 4 * u, 2 * u, rh + 8 * u);
      font(11);
      ctx.fillStyle = '#9aa79f';
      ctx.fillText('Poor fit', rx, ry + rh + 17 * u);
      ctx.textAlign = 'right';
      ctx.fillText('Best fit', rx + rw, ry + rh + 17 * u);
      ctx.textAlign = 'left';
    }

    // The body: the model and the sources, the full width.
    y = headTop + qrSize + 16 * u + 14 * u;
    ctx.fillStyle = '#2a3430';
    ctx.fillRect(M, y, crop.w, 1.5 * u);
    y += 18 * u;
    ctx.fillStyle = '#eef2ee';
    font(12, 650);
    ctx.fillText(`The model · Calculation type: ${opLabel()}`, M, y + 10 * u);
    font(10.5);
    ctx.fillStyle = '#9aa79f';
    let ey = y + 10 * u;
    for (const row of explain) ctx.fillText(row, M, (ey += 15 * u));
    const gridTop = ey + 14 * u;
    const fit = (text: string, w: number) => {
      let t = text;
      while (ctx.measureText(t).width > w && t.length > 4) t = t.slice(0, -2);
      return t === text ? text : `${t}…`;
    };
    crits.forEach((c, i) => {
      const l = byId.get(c.layer.id)!;
      const cx = M + (i % cols) * (chartW + chartGap);
      const cy = gridTop + Math.floor(i / cols) * cellH;
      // Name, and the weight at the right.
      font(11, 650);
      const wt = op === 'mean' && !soloing() ? `×${c.weight.toFixed(1)} · ${weightWord(c.weight)}` : '';
      const wtW = wt ? ctx.measureText(wt).width + 10 * u : 0;
      let nx = cx;
      if (two) {
        ctx.fillStyle = AXIS_COLOURS[c.axis ?? 0];
        ctx.beginPath();
        ctx.arc(cx + 4 * u, cy + 7 * u, 4 * u, 0, Math.PI * 2);
        ctx.fill();
        nx += 13 * u;
      }
      ctx.fillStyle = '#eef2ee';
      ctx.fillText(fit(l.name, chartW - wtW - (nx - cx)), nx, cy + 11 * u);
      if (wt) {
        font(10);
        ctx.fillStyle = '#9aa79f';
        ctx.textAlign = 'right';
        ctx.fillText(wt, cx + chartW, cy + 11 * u);
        ctx.textAlign = 'left';
      }
      // The chart: square-root heights, as the panel draws it, so a layer
      // mostly at one value still shows the rest.
      const by = cy + 18 * u, n = l.hist.length;
      const max = Math.sqrt(Math.max(...l.hist)) || 1;
      const bw = chartW / n;
      l.hist.forEach((count, b) => {
        const h = (Math.sqrt(count) / max) * (chartH - 2 * u);
        const mid = l.lo + ((b + 0.5) / n) * (l.hi - l.lo);
        ctx.fillStyle = rampCss(scoreOf(c, mid));
        ctx.fillRect(cx + b * bw, by + chartH - h, Math.max(bw - 0.6 * u, 0.5 * u), h);
      });
      const at = (v: number) => cx + ((v - l.lo) / (l.hi - l.lo || 1)) * chartW;
      if (!c.scores) {
        ctx.fillStyle = '#9aa79f';
        ctx.fillRect(at(c.bad) - u, by - 2 * u, 2 * u, chartH + 4 * u);
        ctx.fillStyle = rgb(STOPS[4]);
        ctx.fillRect(at(c.good) - u, by - 2 * u, 2 * u, chartH + 4 * u);
      }
      // Under it: the ends, and the settings.
      font(9.5);
      ctx.fillStyle = '#7d8a83';
      ctx.fillText(fmt(l, l.lo), cx, by + chartH + 12 * u);
      ctx.textAlign = 'right';
      ctx.fillText(fmt(l, l.hi), cx + chartW, by + chartH + 12 * u);
      ctx.textAlign = 'center';
      ctx.fillStyle = '#c9d2cc';
      const how = c.scores
        ? 'Scored kind by kind'
        : `Poor at ${fmt(l, c.bad)} · Best at ${fmt(l, c.good)} · ${c.good >= c.bad ? 'Higher = better' : 'Lower = better'}`;
      ctx.fillText(fit(how, chartW - 90 * u), cx + chartW / 2, by + chartH + 12 * u);
      ctx.textAlign = 'left';
    });
    y += modelH;

    // About these layers, in the same column.
    if (blocks.length) {
      y += 30 * u;
      ctx.fillStyle = '#eef2ee';
      font(12, 650);
      ctx.fillText('About these layers', M, y);
      y += 12 * u;
      for (const b of placed) {
        const bx = M + b.col * (aboutW + aboutGap);
        let by = y + b.y + 14 * u;
        ctx.fillStyle = '#eef2ee';
        font(11, 650);
        ctx.fillText(b.l.name, bx, by);
        ctx.fillStyle = '#b7c1bb';
        font(10.5);
        for (const row of b.rows) ctx.fillText(row, bx, (by += aboutLH));
      }
      y += Math.max(...colH);
    }
    y += 24 * u;
    font(10);
    ctx.fillStyle = '#7d8a83';
    for (const row of sources) {
      ctx.fillText(row, M, y);
      y += 15 * u;
    }

    // A code that opens this exact model, light on dark as a phone reads it.
    // Each square a whole number of pixels on whole pixels, so none blurs
    // into the next; the code centred in its light square.
    const n = qr.getModuleCount();
    const cell = Math.max(1, Math.floor(qrSize / (n + 4)));
    const qx = M + crop.w - qrSize, qy = headTop;
    const [cx0, cy0] = [Math.round(qx + (qrSize - n * cell) / 2), Math.round(qy + (qrSize - n * cell) / 2)];
    ctx.fillStyle = '#eef2ee';
    ctx.fillRect(qx, qy, qrSize, qrSize);
    ctx.fillStyle = '#0d1210';
    for (let r = 0; r < n; r++)
      for (let c = 0; c < n; c++) if (qr.isDark(r, c)) ctx.fillRect(cx0 + c * cell, cy0 + r * cell, cell, cell);
    font(9);
    ctx.fillStyle = '#9aa79f';
    ctx.textAlign = 'center';
    ctx.fillText('Open this sandbox', qx + qrSize / 2, qy + qrSize + 12 * u);
    ctx.textAlign = 'left';

    return out;
  }

  /** On a phone, the shared model as the full map image, to look at and
   *  keep: drawn behind the screen, then shown in place of it. */
  async function showOnPhone() {
    const see = document.getElementById('gate-see') as HTMLButtonElement;
    const busy = document.getElementById('gate-busy')!;
    const view = document.getElementById('phone-view')!;
    const root = document.documentElement;
    const fail = (why: string) => {
      busy.textContent = why;
      root.classList.remove('phone-render');
    };
    see.disabled = true;
    busy.hidden = false;
    if (!document.createElement('canvas').getContext('webgl2')) return fail('This phone cannot draw the map. Email yourself the link instead.');
    if (!items.length) return fail('This link has no model in it to draw.');
    try {
      if (!map.loaded()) await new Promise((r) => map.once('load', r));
      // The whole area's count, for the headline under the map.
      const until = Date.now() + 30000;
      while (!tallies.region && Date.now() < until) await new Promise((r) => setTimeout(r, 200));
      const out = await drawFull();
      const blob = await new Promise<Blob | null>((r) => out.toBlob(r, 'image/png'));
      if (!blob) throw new Error('no image');
      const url = URL.createObjectURL(blob);
      (document.getElementById('view-img') as HTMLImageElement).src = url;
      const save = document.getElementById('view-save') as HTMLAnchorElement;
      save.href = url;
      save.download = `ecoscapes-data-sandbox-${stamp()}.png`;
      // Done with the map: its memory back for the picture.
      map.remove();
      root.classList.remove('phone-render');
      const open = (on: boolean) => {
        root.classList.toggle('phone-viewing', on);
        view.hidden = !on;
        scrollTo(0, 0);
      };
      open(true);
      busy.hidden = true;
      see.disabled = false;
      see.addEventListener('click', () => open(true));
      document.getElementById('view-back')!.addEventListener('click', () => open(false));
    } catch {
      fail('Could not draw the map on this phone. Email yourself the link instead.');
    }
  }

  /** The model and its areas as a table. */
  function saveCsv() {
    const t = current();
    if (!items.length || !t) return say('Add a layer first.');
    const q = (v: string | number) => `"${String(v).replace(/"/g, '""')}"`;
    const rows: (string | number)[][] = [
      ['EcoScapes Data Sandbox', stamp()],
      ['Counted', WHERE[scope]],
      ['Calculation type', opLabel()],
      [],
      ['Layer', 'Group', 'Poor at', 'Best at', 'Weight'],
      ...criteria().map((c) => {
        const l = byId.get(c.layer.id)!;
        return [l.name, effectiveMode() === 'two' ? axisNames[c.axis ?? 0] : '', c.scores ? 'by kind' : fmt(l, c.bad), c.scores ? 'by kind' : fmt(l, c.good), c.weight];
      }),
      [],
      ['Area covered by these layers (km²)', t.total.toFixed(1)],
    ];
    if (effectiveMode() === 'two') {
      rows.push([], ['Cell', 'Area (km²)', 'Share (%)']);
      for (let c = 8; c >= 0; c--) rows.push([cellName(c), t.cells[c].toFixed(1), ((t.cells[c] / t.total) * 100).toFixed(2)]);
    } else {
      rows.push([`Scoring ${Math.round(cut() * 100)} or more (km²)`, t.above.toFixed(1)], ['Average score', (t.mean * 100).toFixed(1)]);
      rows.push([], ['Score from', 'Score to', 'Area (km²)', 'Share (%)']);
      t.hist.forEach((a, i) =>
        rows.push([(i * 100) / t.hist.length, ((i + 1) * 100) / t.hist.length, a.toFixed(1), ((a / t.total) * 100).toFixed(2)]),
      );
    }
    const csv = rows.map((r) => r.map(q).join(',')).join('\r\n');
    download(`ecoscapes-data-sandbox-${stamp()}.csv`, URL.createObjectURL(new Blob([csv], { type: 'text/csv' })));
  }

  const opacity = document.getElementById('opacity') as HTMLInputElement;
  opacity.addEventListener('input', () => score.setOpacity(Number(opacity.value)));

  const fold = document.getElementById('fold')!;
  const panelBody = document.getElementById('panel-body')!;
  fold.addEventListener('click', () => {
    const open = fold.getAttribute('aria-expanded') !== 'true';
    fold.setAttribute('aria-expanded', String(open));
    fold.setAttribute('aria-label', open ? 'Fold the panel' : 'Open the panel');
    panelBody.hidden = !open;
    if (scope === 'view') recountView();
  });

  // ---- Why this place --------------------------------------------------------
  const popup = new maplibregl.Popup({ maxWidth: '20rem', focusAfterOpen: false });
  map.on('click', (e) => {
    // Not while recording or flying a flyover: a click there is for moving
    // the map, not reading it.
    if (drawing || flyOpen || flying || Date.now() - drawEnded < 400) return;
    stopTour();
    if (items.length) showWhy(e.lngLat);
  });
  /** Why a place scored what it did, in a popup there. */
  async function showWhy(at: maplibregl.LngLat, title = '') {
    const { lng, lat } = at;
    const { rows, total, second } = await score.explain(lng, lat);
    const how = op === 'and' ? 'its weakest layer' : op === 'or' ? 'its strongest layer' : 'weighed up';
    const band = (v: number, [lo, hi]: [number, number]) => (v < lo ? 0 : v < hi ? 1 : 2);
    let head: string;
    // One layer shown alone is one score, whichever mode the model is in.
    const two = effectiveMode() === 'two';
    if (two) {
      head =
        total === null || second === null
          ? `<div class="why-total"><span>Both scores need data here.</span></div>`
          : `<div class="why-total"><i class="why-sw" style="background:${PALETTE[band(second, breaks[1]) * 3 + band(total, breaks[0])]}"></i>` +
            `<span><b>${esc(cellName(band(second, breaks[1]) * 3 + band(total, breaks[0])))}</b><br>` +
            `${esc(axisNames[0])} ${Math.round(total * 100)} · ${esc(axisNames[1])} ${Math.round(second * 100)} · ${how}</span></div>`;
    } else {
      head =
        total === null
          ? `<div class="why-total"><span>No data here for these layers.</span></div>`
          : `<div class="why-total"><b>${Math.round(total * 100)}</b><span>out of 100 · ${how}</span></div>`;
    }
    const html =
      head +
      `<table class="why">${rows
        .map(({ c, value, score: sc }) => {
          const l = byId.get(c.layer.id)!;
          const right =
            value === null
              ? `<span class="dim">no data</span>`
              : `${esc(fmt(l, value))}<span class="why-bar"><i style="width:${Math.round(sc! * 100)}%"></i></span>`;
          const wt = op === 'mean' ? ` <span class="dim">×${c.weight}</span>` : '';
          const dot = two ? `<i class="why-dot" style="background:${AXIS_COLOURS[c.axis ?? 0]}"></i>` : '';
          return `<tr><td>${dot}${esc(l.name)}${wt}</td><td>${right}</td></tr>`;
        })
        .join('')}</table>`;
    popup.setLngLat(at).setHTML((title ? `<p class="why-title">${esc(title)}</p>` : '') + html).addTo(map);
  }

  // ---- The best places, and a tour of them -------------------------------------
  // Named by the nearest town, so "12 km north-east of Pemberton" rather than
  // coordinates. Approximate positions, enough for "near".
  const TOWNS: [string, number, number][] = [
    ['Squamish', -123.156, 49.702], ['Brackendale', -123.157, 49.771], ['Britannia Beach', -123.203, 49.625],
    ['Lions Bay', -123.236, 49.458], ['Horseshoe Bay', -123.273, 49.373], ['Whistler', -122.957, 50.116],
    ['Pemberton', -122.803, 50.319], ['Mount Currie', -122.717, 50.32], ["D'Arcy", -122.48, 50.549],
    ['Birken', -122.62, 50.48], ['Lillooet', -121.937, 50.686], ['Seton Portage', -122.292, 50.706],
    ['Gold Bridge', -122.841, 50.853], ['Gibsons', -123.508, 49.399], ['Sechelt', -123.755, 49.474],
    ['Pender Harbour', -124.03, 49.63], ['Egmont', -123.93, 49.75], ['Powell River', -124.525, 49.835],
    ['Vancouver', -123.121, 49.283], ['Harrison Hot Springs', -121.786, 49.301], ['Hope', -121.442, 49.386],
    ['Chilliwack', -121.952, 49.158], ['Mission', -122.311, 49.134], ['Bralorne', -122.816, 50.778],
    ['Lytton', -121.582, 50.232], ['Boston Bar', -121.444, 49.866], ['Port Mellon', -123.486, 49.523],
  ];
  const km = (a: [number, number], b: [number, number]) => {
    const r = Math.PI / 180;
    const x = Math.sin(((b[1] - a[1]) * r) / 2) ** 2 + Math.cos(a[1] * r) * Math.cos(b[1] * r) * Math.sin(((b[0] - a[0]) * r) / 2) ** 2;
    return 12742 * Math.asin(Math.sqrt(x));
  };
  function near(lng: number, lat: number) {
    const [name, tl, tt] = TOWNS.reduce((a, t) => (km([t[1], t[2]], [lng, lat]) < km([a[1], a[2]], [lng, lat]) ? t : a));
    const d = km([tl, tt], [lng, lat]);
    if (d < 3) return `at ${name}`;
    const deg = (Math.atan2((lng - tl) * Math.cos((lat * Math.PI) / 180), lat - tt) * 180) / Math.PI;
    const dirs = ['north', 'north-east', 'east', 'south-east', 'south', 'south-west', 'west', 'north-west'];
    return `${Math.round(d)} km ${dirs[Math.round(((deg + 360) % 360) / 45) % 8]} of ${name}`;
  }
  const lngLatOf = (x: number, y: number) => {
    const n = 2 ** (grid?.z ?? 12) * 256;
    return new maplibregl.LngLat((x / n) * 360 - 180, (Math.atan(Math.sinh(Math.PI * (1 - (2 * y) / n))) * 180) / Math.PI);
  };

  const bestBtn = document.getElementById('best-btn')!;
  const bestList = document.getElementById('best-list')!;
  const bestMenu = document.getElementById('best-menu')!;
  let bestOpen = false;
  let pins: maplibregl.Marker[] = [];
  const spots = () => {
    const t = current();
    return (t?.best ?? []).map((b) => ({ at: lngLatOf(b.x, b.y), v: b.v }));
  };
  const spotValue = (v: number) => (effectiveMode() === 'two' ? `${Math.round(v * 100)}% high both` : String(Math.round(v * 100)));

  /** The list and the pins, from the latest count (called whenever it lands). */
  function showBest() {
    for (const p of pins) p.remove();
    pins = [];
    const list = spots();
    bestBtn.toggleAttribute('disabled', !list.length && !bestOpen);
    const note = document.getElementById('best-note')!;
    bestMenu.hidden = !bestOpen;
    if (!bestOpen) return;
    if (!list.length) {
      bestList.innerHTML = '';
      note.textContent = items.length ? 'Still counting…' : 'Add a layer to find the best places.';
      return;
    }
    note.textContent =
      (effectiveMode() === 'two'
        ? 'The places with the most land high on both scores, '
        : 'The places with the highest average score, ') +
      `each over about 3 km around the pin, ${WHERE[scope]}. A tap gives one spot's own score.`;
    bestList.innerHTML = list
      .map((s, i) => `<li><button type="button" data-i="${i}"><b>${i + 1}</b><span>${esc(near(s.at.lng, s.at.lat))}</span><em>${spotValue(s.v)}</em></button></li>`)
      .join('');
    pins = list.map((s, i) => {
      const elp = document.createElement('div');
      elp.className = 'best-pin';
      elp.textContent = String(i + 1);
      elp.addEventListener('click', (e) => {
        e.stopPropagation();
        visit(i);
      });
      return new maplibregl.Marker({ element: elp }).setLngLat(s.at).addTo(map);
    });
  }
  function mark(i: number) {
    pins.forEach((p, j) => p.getElement().classList.toggle('on', j === i));
    bestList.querySelectorAll('button').forEach((b, j) => b.classList.toggle('on', j === i));
  }
  function visit(i: number, duration = 1600) {
    const s = spots()[i];
    if (!s) return Promise.resolve();
    mark(i);
    return new Promise<void>((done) => {
      let arrived = false;
      const arrive = () => {
        if (arrived) return;
        arrived = true;
        showWhy(s.at, `${i + 1} · ${near(s.at.lng, s.at.lat)}`);
        done();
      };
      map.once('moveend', arrive);
      // Already there, there is no move to end: arrive anyway.
      setTimeout(arrive, duration + 600);
      map.flyTo({ center: s.at, zoom: Math.max(map.getZoom(), 11), duration, essential: true });
    });
  }
  /** Opened, the places are toured at once; pressed again, the tour stops,
   *  and once more, the places go. */
  function setBest(open: boolean) {
    bestOpen = open;
    bestBtn.setAttribute('aria-expanded', String(open));
    const label = touring ? 'Stop the tour' : open ? 'Hide the best places' : 'Best places';
    bestBtn.title = label;
    bestBtn.setAttribute('aria-label', label);
    showBest();
  }
  bestBtn.addEventListener('click', () => {
    if (touring) stopTour();
    else if (bestOpen) setBest(false);
    else {
      closeOthers();
      tour();
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && bestOpen) {
      stopTour();
      setBest(false);
    }
  });
  bestList.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (b) {
      stopTour();
      visit(Number(b.dataset.i));
    }
  });

  /** Every toolbar menu shut, before another opens. */
  function closeOthers() {
    showPalettes(false);
    showFly(false);
    showSave(false);
    if (bestOpen) {
      stopTour();
      setBest(false);
    }
  }

  // The tour: to each place in turn, explaining it, until it ends or the map
  // is touched.
  let touring = 0;
  function stopTour() {
    if (!touring) return;
    touring = 0;
    setBest(bestOpen);
  }
  async function tour() {
    const me = (touring = Date.now());
    setBest(true);
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (let i = 0; i < spots().length && touring === me; i++) {
      await visit(i, reduce ? 0 : 3200);
      await new Promise((r) => setTimeout(r, 3800));
    }
    if (touring === me) {
      stopTour();
      map.flyTo({ center: map.getCenter(), zoom: 8.2, duration: reduce ? 0 : 2400 });
    }
  }
  for (const ev of ['dragstart', 'wheel', 'touchstart'] as const) map.on(ev, () => stopTour());

  // ---- The flyover -----------------------------------------------------------
  // While the menu is open, each "add" keeps the view on screen -- where,
  // how close, turned and tilted. Play flies through them in order on one
  // smooth path (flyover.ts), the panels out of the way and the legend left.
  const flyBtn = document.getElementById('fly-btn')!;
  const flyMenu = document.getElementById('fly-menu')!;
  const flyList = document.getElementById('fly-list')!;
  const flyNote = document.getElementById('fly-note')!;
  const flyPlay = document.getElementById('fly-play') as HTMLButtonElement;
  const flyClear = document.getElementById('fly-clear') as HTMLButtonElement;
  const flySpeed = document.getElementById('fly-speed') as HTMLInputElement;
  const flyStop = document.getElementById('fly-stop')!;
  const flyLive = document.getElementById('fly-live') as HTMLButtonElement;
  const flySave = document.getElementById('fly-save')!;
  const flyVideo = document.getElementById('fly-video') as HTMLVideoElement;
  let flyOpen = false;
  const viewNow = (): View => {
    const c = map.getCenter();
    return { lng: c.lng, lat: c.lat, zoom: map.getZoom(), bearing: map.getBearing(), pitch: map.getPitch(), elevation: map.getCenterElevation() };
  };
  const plan = () => flight(flyViews, { w: el.clientWidth, h: el.clientHeight }, Number(flySpeed.value), flyViews.map(hasCallout));
  const flyCallout = document.getElementById('fly-callout')!;
  /** The view whose callout is open for editing in the list, if any. */
  let editing = -1;
  // ?flyover-debug: the path drawn on the map and charted (flyover-debug.ts).
  const flyDebug = new URLSearchParams(location.search).has('flyover-debug')
    ? new FlightDebug(map, page, () => `score in view missing ${score.pending} loading ${score.loading} held ${score.held}`)
    : null;
  if (flyDebug) score.onTile = (key, ms) => flyDebug.note('score-tile-in', `${key} upload ${ms.toFixed(1)}ms`);
  const flyLabel = (v: FlyView) => {
    if (v.title?.trim()) return v.title.trim();
    const at = near(v.lng, v.lat);
    return at[0].toUpperCase() + at.slice(1);
  };
  const CALLOUT_ICON =
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><path d="M5 4.5h14a1.5 1.5 0 011.5 1.5v8a1.5 1.5 0 01-1.5 1.5h-5.5L12 19l-1.5-3.5H5A1.5 1.5 0 013.5 14V6A1.5 1.5 0 015 4.5z" /><path d="M8 8.5h8M8 11.5h5" /></svg>';
  function renderFly() {
    flyList.innerHTML = flyViews
      .map(
        (v, i) =>
          `<li><button type="button" class="fly-go" data-go="${i}" title="Go to this view"><b>${i + 1}</b><span>${esc(flyLabel(v))}</span></button>` +
          `<button type="button" class="fly-pen${hasCallout(v) ? ' on' : ''}" data-edit="${i}" aria-expanded="${editing === i}" aria-label="Callout for view ${i + 1}" title="Callout: words pinned to this spot as the flight passes, slowing down for them">${CALLOUT_ICON}</button>` +
          `<button type="button" class="fly-del" data-del="${i}" aria-label="Remove view ${i + 1}" title="Remove">×</button></li>` +
          (editing === i
            ? `<li class="fly-edit"><input data-title="${i}" maxlength="${TITLE_MAX}" placeholder="Callout title" value="${esc(v.title ?? '')}" />` +
              `<textarea data-text="${i}" maxlength="${TEXT_MAX}" rows="2" placeholder="A sentence or two (optional)">${esc(v.text ?? '')}</textarea></li>`
            : ''),
      )
      .join('');
    renderFlyStatus();
  }
  /** Everything but the list, so typing a callout keeps its place. */
  function renderFlyStatus() {
    const stops = flyViews.filter(hasCallout).length;
    flyNote.textContent =
      flyViews.length >= 2
        ? `${flyViews.length} views${stops ? `, ${stops} with a callout` : ''}, about ${Math.round(plan().duration)} seconds.${stops ? '' : ' The speech bubble on a view adds a callout.'}`
        : flyViews.length
          ? 'Now move to the next view and add that too. The speech bubble on a view gives it a callout, pinned to that spot, and the flight slows to show it.'
          : 'Move the map to where the flight starts, as close and as tilted as you want it, and add it. Then the next, and the next. A right-drag turns the camera where it stands, to aim it. The speech bubble on a view gives it a callout, and the flight slows to show it.';
    flyPlay.disabled = flyLive.disabled = flyViews.length < 2;
    // Made already, and nothing changed since: it plays at once.
    const made = !!video && video.key === videoKey();
    flySave.hidden = !made;
    flyPlay.textContent = made ? 'Replay' : 'Play';
    flyClear.disabled = !flyViews.length;
    flyDebug?.set(flyViews.length >= 2 ? plan() : null);
  }
  function showFly(open: boolean) {
    // Leaving, the middle of the view back on the ground (see looking round).
    if (!open && looked && !flying) {
      looked = false;
      map.setCenterClampedToGround(true);
    }
    flyOpen = open;
    flyMenu.hidden = !open;
    page.classList.toggle('fly-open', open);
    if (open) popup.remove();
    flyBtn.setAttribute('aria-expanded', String(open));
    if (open) renderFly();
  }
  flyBtn.addEventListener('click', () => {
    if (flyOpen) return showFly(false);
    closeOthers();
    showFly(true);
  });
  document.getElementById('fly-add')!.addEventListener('click', () => {
    if (flyViews.length >= MAX_VIEWS) return say(`A flyover takes up to ${MAX_VIEWS} views.`);
    flyViews.push(viewNow());
    editing = -1;
    renderFly();
    flyList.lastElementChild?.scrollIntoView({ block: 'nearest' });
    saveHash();
  });
  flyList.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (!b) return;
    if (b.dataset.del !== undefined) {
      flyViews.splice(Number(b.dataset.del), 1);
      editing = -1;
      renderFly();
      saveHash();
    } else if (b.dataset.edit !== undefined) {
      const i = Number(b.dataset.edit);
      editing = editing === i ? -1 : i;
      renderFly();
      flyList.querySelector('.fly-edit')?.scrollIntoView({ block: 'nearest' });
      flyList.querySelector<HTMLInputElement>(`[data-title="${i}"]`)?.focus({ preventScroll: true });
    } else {
      const v = flyViews[Number(b.dataset.go)];
      map.easeTo({ center: [v.lng, v.lat], zoom: v.zoom, bearing: v.bearing, pitch: v.pitch, duration: 900 });
    }
  });
  flyList.addEventListener('input', (e) => {
    const f = e.target as HTMLInputElement | HTMLTextAreaElement;
    const i = Number(f.dataset.title ?? f.dataset.text);
    const v = flyViews[i];
    if (!v) return;
    if (f.dataset.title !== undefined) v.title = f.value;
    else v.text = f.value;
    const row = flyList.querySelector(`[data-go="${i}"] span`);
    if (row) row.textContent = flyLabel(v);
    flyList.querySelector(`[data-edit="${i}"]`)?.classList.toggle('on', hasCallout(v));
    renderFlyStatus();
    saveHash();
  });
  flyClear.addEventListener('click', () => {
    editing = -1;
    flyViews = [];
    renderFly();
    saveHash();
  });
  flySpeed.addEventListener('input', renderFly);
  flyPlay.addEventListener('click', play);
  flyLive.addEventListener('click', playLive);
  flySave.addEventListener('click', () => {
    if (video) download(`ecoscapes-flyover-${stamp()}.mp4`, video.url);
  });

  // Looking round, while the flyover is open: a right-drag (or ctrl-drag)
  // turns the camera where it stands, across and up and down, rather than
  // swinging it round the middle of the view -- aiming it without moving it.
  // The middle of the view is then off the ground, wherever the gaze puts it,
  // and a flight flies it just so.
  let look: { x: number; y: number; cam: number[]; bearing: number; pitch: number } | null = null;
  let looked = false;
  const TURN_PER_PX = 0.25;
  el.addEventListener(
    'mousedown',
    (e) => {
      if (!flyOpen || flying || !(e.button === 2 || (e.button === 0 && e.ctrlKey))) return;
      e.preventDefault();
      e.stopPropagation();
      const v = viewNow();
      look = {
        x: e.clientX,
        y: e.clientY,
        cam: cameraAt(v, el.clientHeight, map.getVerticalFieldOfView(), metreAt(v.lat)).camera,
        bearing: v.bearing,
        pitch: v.pitch,
      };
      map.setCenterClampedToGround(false);
      looked = true;
    },
    true,
  );
  el.addEventListener('contextmenu', (e) => {
    if (flyOpen) e.preventDefault();
  });
  window.addEventListener('mousemove', (e) => {
    if (!look) return;
    const bearing = look.bearing + (e.clientX - look.x) * TURN_PER_PX;
    const pitch = Math.min(80, Math.max(0, look.pitch - (e.clientY - look.y) * TURN_PER_PX));
    const c = lookFrom(look.cam, bearing, pitch, map.getZoom(), el.clientHeight, map.getVerticalFieldOfView());
    map.jumpTo({ center: [c.lng, c.lat], elevation: c.elevation, bearing, pitch });
  });
  window.addEventListener('mouseup', () => (look = null));

  let flying = 0;
  let restorePR = 0;
  const flyCover = document.getElementById('fly-cover')!;
  /** Once every tile the view needs -- ground, heights, scores -- is in, or
   *  after `limit` ms whatever is still missing. Two frames first, for the
   *  map to see what the new view needs. */
  const ready = (limit: number) =>
    new Promise<boolean>((done) => {
      const t0 = performance.now();
      const check = () => {
        if (map.areTilesLoaded() && score.pending === 0) done(true);
        else if (performance.now() - t0 > limit) done(false);
        else requestAnimationFrame(check);
      };
      requestAnimationFrame(() => requestAnimationFrame(check));
    });
  /** The flight flown once in steps before it plays, under a cover, each step
   *  held until its tiles are in: the real flight then never waits on one.
   *  Backwards, so it ends at the first view, whose tiles are then the
   *  freshest kept. */
  async function preload(f: ReturnType<typeof plan>, me: number) {
    const steps = Math.max(2, Math.ceil(f.duration / 0.35));
    cover('Getting the flight ready', 0);
    for (let k = 0; k <= steps; k++) {
      if (flying !== me) return false;
      const v = f.at(f.duration * (1 - k / steps));
      map.jumpTo({ center: [v.lng, v.lat], zoom: v.zoom, bearing: v.bearing, pitch: v.pitch, elevation: v.elevation });
      cover('Getting the flight ready', k / steps);
      const t0 = performance.now();
      const done = await ready(5000);
      flyDebug?.note('preload', `step ${k}/${steps} at t ${(f.duration * (1 - k / steps)).toFixed(2)}: ${done ? 'ready' : 'gave up waiting'} after ${(performance.now() - t0).toFixed(0)} ms`);
    }
    hideCover();
    return flying === me;
  }
  // The cards (cards.md) in turn while the cover is up, each for its own
  // seconds, carrying on from where the last cover left off.
  const cardEl = document.getElementById('fly-card')!;
  let cardAt = 0;
  let cardTimer = 0;
  const pics = [...cardEl.querySelectorAll<HTMLImageElement>('.fly-pics img')];
  const caption = cardEl.querySelector('figcaption')!;
  let front = -1;
  let cardRun = 0;
  const pause = (ms: number) => new Promise((r) => (cardTimer = window.setTimeout(r, ms)));
  async function showCard(run: number) {
    const list = config.cards;
    const c = list[cardAt++ % list.length];
    // The picture decoded in the back one first; nothing on screen changes
    // until it is ready.
    const back = pics[front === 0 ? 1 : 0];
    if (c.image) {
      back.src = c.image;
      try {
        await back.decode();
      } catch {}
    }
    if (run !== cardRun) return;
    // The words out, the picture across, the words in.
    if (front >= 0) {
      caption.classList.add('out');
      await pause(350);
      if (run !== cardRun) return;
    }
    cardEl.classList.toggle('tall', c.tall);
    cardEl.classList.toggle('nopic', !c.image);
    caption.querySelector('h2')!.textContent = c.title;
    caption.querySelector('div')!.innerHTML = c.text.map((t) => `<p>${esc(t)}</p>`).join('');
    if (c.image) {
      pics.forEach((p) => p.classList.toggle('on', p === back));
      front = pics.indexOf(back);
    }
    caption.classList.remove('out');
    await pause(c.seconds * 1000);
    if (run === cardRun) showCard(run);
  }
  function startCards() {
    if (!config.cards.length) return;
    cardEl.hidden = false;
    showCard(++cardRun);
  }
  function hideCover() {
    flyCover.hidden = true;
    cardRun++;
    clearTimeout(cardTimer);
    cardEl.hidden = true;
  }
  /** The cover over the map while a flight is got ready or made. */
  function cover(what: string, done: number, note = '') {
    if (flyCover.hidden) {
      startCards();
      // From empty, not sliding back from wherever the last one ended.
      const bar = flyCover.querySelector<HTMLElement>('.fly-bar i')!;
      bar.style.transition = 'none';
      flyCover.style.setProperty('--done', '0');
      void bar.offsetWidth;
      bar.style.transition = '';
    }
    flyCover.hidden = false;
    flyCover.querySelector('b')!.textContent = what;
    flyCover.querySelector('span')!.textContent = `${Math.round(done * 100)}%`;
    flyCover.style.setProperty('--done', String(done));
    flyCover.querySelector('small')!.textContent = note;
  }
  /** Out of the way for a flight: the panels, the tour, the popup. */
  function takeOff() {
    const me = ++flying;
    showFly(false);
    stopTour();
    popup.remove();
    page.classList.add('flying');
    flyStop.hidden = false;
    // The middle of the view at the flight's own height, not the ground's:
    // held to the ground, the camera rides up and down every ridge it passes.
    map.setCenterClampedToGround(false);
    return me;
  }
  const jumpTo = (v: View) => map.jumpTo({ center: [v.lng, v.lat], zoom: v.zoom, bearing: v.bearing, pitch: v.pitch, elevation: v.elevation });

  // ---- The flight as a video ---------------------------------------------------
  // Made frame by frame, each drawn complete before it is kept, then played
  // over the map: perfectly smooth in any browser, after a wait. Kept for as
  // long as nothing it shows changes -- the flight, the model, the colours,
  // the window -- so playing it again is at once, and it can be saved.
  let video: { key: string; url: string; start: number } | null = null;
  /** The title card the saved video opens with: the logo and the model --
   *  its layers, how they are weighed, the colours. Skipped when played here. */
  const INTRO = 3;
  function titleCard(ctx: CanvasRenderingContext2D, w: number, h: number) {
    const css = getComputedStyle(page);
    const colour = (name: string, fallback: string) => css.getPropertyValue(name).trim() || fallback;
    const u = h / 1000;
    const font = (size: number, weight = 400) => (ctx.font = `${weight} ${size * u}px system-ui, -apple-system, 'Segoe UI', sans-serif`);
    ctx.fillStyle = colour('--bg', '#0d1210');
    ctx.fillRect(0, 0, w, h);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'alphabetic';
    const lines = modelLines();
    // Fewer lines, larger; up to MAX_CRITERIA fits.
    const size = lines.length > 5 ? 28 : 34;
    const gap = size * 1.55;
    const block = 90 + 70 + 60 + lines.length * gap + (effectiveMode() === 'two' ? 0 : 90);
    let y = Math.max(120, (1000 - block) / 2);
    if (logo.complete && logo.naturalWidth) {
      const lh = 90 * u;
      const lw = (logo.naturalWidth / logo.naturalHeight) * lh;
      ctx.drawImage(logo, (w - lw) / 2, y * u, lw, lh);
    }
    y += 90 + 70;
    font(22, 600);
    ctx.fillStyle = colour('--accent', '#7fe0a8');
    if ('letterSpacing' in ctx) (ctx as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing = `${3 * u}px`;
    ctx.fillText('DATA SANDBOX · FLYOVER', w / 2, y * u);
    if ('letterSpacing' in ctx) (ctx as CanvasRenderingContext2D & { letterSpacing: string }).letterSpacing = '0px';
    y += 50;
    font(24);
    ctx.fillStyle = colour('--ink-dim', '#9aa79f');
    ctx.fillText(`Calculation type: ${opLabel()}`, w / 2, y * u);
    y += 20;
    font(size);
    ctx.fillStyle = colour('--ink', '#eef2ee');
    for (const line of lines) ctx.fillText(line, w / 2, (y += gap) * u);
    // The colours, poor to best (two scores have their own nine).
    if (effectiveMode() !== 'two') {
      y += 60;
      const [rw, rh] = [420 * u, 12 * u];
      const g = ctx.createLinearGradient((w - rw) / 2, 0, (w + rw) / 2, 0);
      STOPS.forEach((c, i) => g.addColorStop(i / (STOPS.length - 1), rgb(c)));
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.roundRect((w - rw) / 2, y * u, rw, rh, rh / 2);
      ctx.fill();
      font(20);
      ctx.fillStyle = colour('--ink-dim', '#9aa79f');
      ctx.textAlign = 'left';
      ctx.fillText('Poor fit', (w - rw) / 2, (y + 42) * u);
      ctx.textAlign = 'right';
      ctx.fillText('Best fit', (w + rw) / 2, (y + 42) * u);
    }
  }
  /** Where a view's callout is pinned on screen, in CSS pixels: the ground
   *  at its spot, or null when that is behind the camera or off screen. */
  function pinOf(v: FlyView) {
    const p = map.project([v.lng, v.lat]);
    const [w, h] = [el.clientWidth, el.clientHeight];
    return Number.isFinite(p.x) && Number.isFinite(p.y) && p.x > -40 && p.x < w + 40 && p.y > -40 && p.y < h + 40 ? p : null;
  }
  /** The stem from the spot up to the card, in CSS pixels. */
  const STEM = 56;
  /** A view's callout drawn into a video frame, as it looks on the live map:
   *  a dot on its spot, a stem up, a dark card on top. */
  function drawCallout(ctx: CanvasRenderingContext2D, w: number, h: number, v: FlyView, alpha: number) {
    const pin = pinOf(v);
    if (!pin) return;
    const css = getComputedStyle(page);
    const colour = (name: string, fallback: string) => css.getPropertyValue(name).trim() || fallback;
    // CSS pixels to the frame's.
    const u = w / el.clientWidth;
    const [px, py] = [pin.x * u, pin.y * u];
    const font = (size: number, weight = 400) => (ctx.font = `${weight} ${size * u}px system-ui, -apple-system, 'Segoe UI', sans-serif`);
    const most = Math.min(352 * u, w - 32 * u) - 29 * u;
    /** Words into lines no wider than `most`, in the font set now. */
    const wrap = (text: string) => {
      const lines: string[] = [];
      for (const word of text.split(/\s+/).filter(Boolean)) {
        const last = lines[lines.length - 1];
        if (last !== undefined && ctx.measureText(`${last} ${word}`).width <= most) lines[lines.length - 1] = `${last} ${word}`;
        else lines.push(word);
      }
      return lines;
    };
    const [title, text] = [v.title?.trim() ?? '', v.text?.trim() ?? ''];
    font(16, 600);
    const tl = wrap(title);
    const tw = Math.max(0, ...tl.map((l) => ctx.measureText(l).width));
    font(13.6);
    const bl = wrap(text);
    const bw = Math.max(0, ...bl.map((l) => ctx.measureText(l).width));
    const [padX, padY, th, bh, gap] = [14.4 * u, 10 * u, 20 * u, 19 * u, tl.length && bl.length ? 4 * u : 0];
    const boxW = Math.max(tw, bw) + 2 * padX;
    const boxH = tl.length * th + gap + bl.length * bh + 2 * padY;
    const [x, y] = [px - boxW / 2, py - (STEM + 5) * u - boxH];
    const accent = colour('--accent', '#7fe0a8');
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.fillStyle = accent;
    ctx.fillRect(px - 1 * u, py - (STEM + 5) * u, 2 * u, STEM * u);
    ctx.beginPath();
    ctx.arc(px, py, 8 * u, 0, 2 * Math.PI);
    ctx.fillStyle = 'rgba(13, 18, 16, 0.6)';
    ctx.fill();
    ctx.beginPath();
    ctx.arc(px, py, 5 * u, 0, 2 * Math.PI);
    ctx.fillStyle = accent;
    ctx.fill();
    ctx.shadowColor = 'rgba(0, 0, 0, 0.4)';
    ctx.shadowBlur = 24 * u;
    ctx.shadowOffsetY = 6 * u;
    ctx.fillStyle = 'rgba(13, 18, 16, 0.88)';
    ctx.beginPath();
    ctx.roundRect(x, y, boxW, boxH, 10 * u);
    ctx.fill();
    ctx.shadowColor = 'transparent';
    ctx.fillStyle = accent;
    ctx.fillRect(x + 8 * u, y + boxH - 2 * u, boxW - 16 * u, 2 * u);
    ctx.textAlign = 'left';
    ctx.textBaseline = 'top';
    let ty = y + padY;
    font(16, 600);
    ctx.fillStyle = colour('--ink', '#eef2ee');
    for (const l of tl) {
      ctx.fillText(l, x + padX, ty + 1 * u);
      ty += th;
    }
    ty += gap;
    font(13.6);
    ctx.fillStyle = colour('--ink-dim', '#9aa79f');
    for (const l of bl) {
      ctx.fillText(l, x + padX, ty + 2 * u);
      ty += bh;
    }
    ctx.restore();
  }
  /** The live flight's callout, as it is now: pinned to its spot. */
  let calloutAt = -1;
  function showCallout(c: { i: number; a: number } | null) {
    const pin = c && pinOf(flyViews[c.i]);
    flyCallout.hidden = !pin;
    if (!c || !pin) return (calloutAt = -1);
    if (calloutAt !== c.i) {
      calloutAt = c.i;
      flyCallout.querySelector('h3')!.textContent = flyViews[c.i].title?.trim() ?? '';
      flyCallout.querySelector('p')!.textContent = flyViews[c.i].text?.trim() ?? '';
    }
    flyCallout.style.transform = `translate(${pin.x}px, ${pin.y}px)`;
    flyCallout.style.opacity = String(c.a);
  }
  const videoKey = () =>
    JSON.stringify([location.hash, flyViews, flySpeed.value, getComputedStyle(page).getPropertyValue('--ramp'), map.getCanvas().width, map.getCanvas().height]);
  /** Drawn complete: redrawn at once, and again each frame until every tile
   *  is in (or 8 s pass), the view set again each time in case anything
   *  moved it. The last draw is the one copied, in the same task. */
  async function settle(v: View, me: number) {
    const t0 = performance.now();
    for (;;) {
      // Stopped: let go at once, so a flight made after it has the map to
      // itself.
      if (flying !== me) return;
      jumpTo(v);
      map.redraw();
      if ((map.areTilesLoaded() && score.pending === 0) || performance.now() - t0 > 8000) return;
      await new Promise((r) => requestAnimationFrame(r));
    }
  }
  async function play() {
    if (flyViews.length < 2) return;
    const f = plan();
    const key = videoKey();
    const me = takeOff();
    if (!video || video.key !== key) {
      const dbg = map.getLayer('flight-debug') ? map.getLayoutProperty('flight-debug', 'visibility') : null;
      if (dbg !== null) map.setLayoutProperty('flight-debug', 'visibility', 'none');
      cover('Preparing your flight', 0, 'Each frame is drawn in full, so it plays smoothly.');
      const t0 = performance.now();
      let blob: Blob | null = null;
      try {
        if (!logo.complete) await new Promise((r) => (logo.onload = logo.onerror = r));
        const { recordFlight } = await import('../lib/dst/flyover-video');
        blob = await recordFlight({
          duration: f.duration,
          size: { w: map.getCanvas().width, h: map.getCanvas().height },
          draw: async (t, ctx, w, h) => {
            await settle(f.at(t), me);
            if (flying !== me) return;
            ctx.drawImage(map.getCanvas(), 0, 0, w, h);
            const c = f.callout(t);
            if (c) drawCallout(ctx, w, h, flyViews[c.i], c.a);
          },
          onProgress: (k, n) => {
            if (flying !== me) return;
            const left = ((performance.now() - t0) / k) * (n - k) / 1000;
            cover('Preparing your flight', k / n, k > 30 ? `About ${left > 90 ? `${Math.round(left / 60)} min` : `${Math.ceil(left)} s`} left.` : 'Each frame is drawn in full, so it plays smoothly.');
          },
          cancelled: () => flying !== me,
          intro: { seconds: INTRO, draw: titleCard },
        });
      } catch (err) {
        say(err instanceof Error ? err.message : 'Could not make the video.');
      }
      if (dbg !== null) map.setLayoutProperty('flight-debug', 'visibility', dbg ?? 'visible');
      if (!blob || flying !== me) return endFly(flying === me);
      if (video) URL.revokeObjectURL(video.url);
      video = { key, url: URL.createObjectURL(blob), start: INTRO };
    } else {
      // Under the video, the map waits at the last view, for the hand-back.
      jumpTo(f.at(f.duration));
    }
    hideCover();
    // Past the title card: that is for the saved copy.
    if (flyVideo.src !== video.url) flyVideo.src = video.url;
    flyVideo.currentTime = video.start;
    flyVideo.hidden = false;
    flyVideo.onended = () => {
      if (flying === me) endFly(true);
    };
    try {
      await flyVideo.play();
    } catch {
      endFly(true);
    }
  }

  // ---- The flight on the live map ------------------------------------------------
  async function playLive() {
    if (flyViews.length < 2) return;
    const f = plan();
    const me = takeOff();
    score.keep = 2400;
    // ?fly-pr=N: the flight drawn at N pixels to the CSS pixel, to see whether
    // the GPU keeping up is what stutters.
    const pr = Number(new URLSearchParams(location.search).get('fly-pr'));
    if (pr > 0) {
      restorePR = map.getPixelRatio();
      map.setPixelRatio(pr);
    }
    flyDebug?.begin({
      'fly-pr': pr > 0 ? `${pr} (was ${restorePR})` : `off, drawn at ${map.getPixelRatio()}`,
      'fly-cache': new URLSearchParams(location.search).get('fly-cache') ?? '12 (default here)',
      speed: flySpeed.value,
      duration: `${f.duration.toFixed(2)} s`,
      'view at s': f.times.map((t) => Number(t.toFixed(2))),
      views: flyViews,
    });
    if (!(await preload(f, me))) return;
    flyDebug?.note('play', 'preload done, flying');
    // At the first view now: away.
    let t0 = 0;
    const frame = (now: number) => {
      if (flying !== me) return;
      t0 ||= now;
      const t = (now - t0) / 1000;
      const v = f.at(t);
      const j0 = performance.now();
      map.jumpTo({ center: [v.lng, v.lat], zoom: v.zoom, bearing: v.bearing, pitch: v.pitch, elevation: v.elevation });
      showCallout(f.callout(t));
      flyDebug?.frame(now, t, v, performance.now() - j0);
      flyDebug?.playhead(t, v);
      if (t >= f.duration) {
        flyDebug?.end('reached the last view');
        endFly(true);
      }
      else requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
  function endFly(reopen = false) {
    if (!flying) return;
    flyDebug?.end('stopped');
    flying = 0;
    if (restorePR) {
      map.setPixelRatio(restorePR);
      restorePR = 0;
    }
    hideCover();
    flyVideo.pause();
    flyVideo.hidden = true;
    showCallout(null);
    score.keep = 700;
    map.setCenterClampedToGround(true);
    flyDebug?.playhead(-1);
    page.classList.remove('flying');
    flyStop.hidden = true;
    if (scope === 'view') recountView();
    if (reopen) showFly(true);
  }
  flyVideo.addEventListener('click', () => endFly(true));
  flyStop.addEventListener('click', () => {
    flyDebug?.end('stopped with the button');
    endFly(true);
  });
  for (const ev of ['mousedown', 'wheel', 'touchstart'] as const)
    map.on(ev, () => {
      if (flying) flyDebug?.end(`stopped by ${ev} on the map`);
      endFly(true);
    });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (flying) {
      flyDebug?.end('stopped with Esc');
      endFly(true);
    }
    else if (flyOpen) showFly(false);
  });

  // ---- Where I am ---------------------------------------------------------------
  let hereDot: maplibregl.Marker | null = null;
  document.getElementById('here')!.addEventListener('click', () => {
    if (!('geolocation' in navigator)) return say('This browser cannot tell where you are.');
    say('Finding where you are…');
    navigator.geolocation.getCurrentPosition(
      (p) => {
        const at = new maplibregl.LngLat(p.coords.longitude, p.coords.latitude);
        const [[w0, s0], [e0, n0]] = config.limit;
        if (at.lng < w0 || at.lng > e0 || at.lat < s0 || at.lat > n0) return say('You are outside the study area, so there is nothing to score here.');
        stopTour();
        const dot = document.createElement('div');
        dot.className = 'here-dot';
        hereDot?.remove();
        hereDot = new maplibregl.Marker({ element: dot }).setLngLat(at).addTo(map);
        map.once('moveend', () => (items.length ? showWhy(at, 'Where you are') : say('Add a layer to score where you are.')));
        map.flyTo({ center: at, zoom: 13, essential: true });
      },
      () => say('Could not tell where you are.'),
      { enableHighAccuracy: true, timeout: 12000 },
    );
  });

  // Opens empty -- the map and the choice are the visitor's -- unless the
  // address carries a model (a shared link).
  loadHash().then((shared) => {
    renderFly();
    render();
    showNumbers();
    if (shared) push();
    if (onPhone) showOnPhone();
  });
</script>
