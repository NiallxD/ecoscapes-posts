---
import { getCollection, render } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import Panorama from '../../components/Panorama.astro';
import TimeSeries from '../../components/TimeSeries.astro';
import Capture from '../../components/Capture.astro';
import Closing from '../../components/Closing.astro';
import PanelNav from '../../components/PanelNav.astro';
import { asset, locationAssets } from '../../lib/paths';

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  return locations.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const offlineList = JSON.stringify(locationAssets(entry));
const installed = data.installed.toLocaleDateString('en-CA', { year: 'numeric', month: 'long' });
const coords = `${Math.abs(data.lat).toFixed(4)}°${data.lat >= 0 ? 'N' : 'S'} ${Math.abs(data.lng).toFixed(4)}°${data.lng >= 0 ? 'E' : 'W'}`;
---

<Shell title={`${data.title} · EcoScapes`} description={data.intro}>
  <main class="deck" id="deck">
    <section class="panel intro" id="here" aria-label="This place">
      {data.hero && (
        <img
          class="intro-bg"
          src={asset(data.hero)}
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      )}
      <div class="panel-stage intro-stage">
        <div class="intro-copy">
          <p class="eyebrow">{data.place}</p>
          <h1>{data.title}</h1>
          <p class="intro-lede">{data.intro}</p>
          <div class="intro-body"><Content /></div>
          <p class="intro-meta">{coords} · post installed {installed}</p>
        </div>
        <div class="intro-tools">
          <button class="chip" id="offline" type="button" data-assets={offlineList}>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2" />
            </svg>
            <span id="offline-label">Save for offline</span>
          </button>
        </div>
      </div>
      <PanelNav next="#view" prompt />
    </section>

    <Panorama
      src={data.pano.src}
      caption={data.pano.caption}
      northOffset={data.pano.northOffset}
      prev="#here"
      next="#change"
    />
    <TimeSeries {...data.series} prev="#view" next="#add" />
    <Capture
      prompt={data.capture.prompt}
      shareTo={data.capture.shareTo}
      title={data.title}
      prev="#change"
      next="#onward"
    />
    <Closing prev="#add" wall={data.wall} />
  </main>

  <nav class="story" aria-label="Sections">
    <a href="#here" data-for="here"><i></i><span class="sr">This place</span></a>
    <a href="#view" data-for="view"><i></i><span class="sr">Panorama</span></a>
    <a href="#change" data-for="change"><i></i><span class="sr">Change over time</span></a>
    <a href="#add" data-for="add"><i></i><span class="sr">Add your photograph</span></a>
    <a href="#onward" data-for="onward"><i></i><span class="sr">Take this with you</span></a>
  </nav>
</Shell>

<style>
  .intro-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  /* Scrim: enough at the foot to hold the copy, light through the middle so the
     photograph still reads, and a touch at the very top for the progress bar.
     Deliberately kept off full black at 0% -- the blur below carries most of
     the legibility now, and a scrim heavy enough to do it alone crushes the
     bottom third of the picture into a band that reads as a missing image. */
  .intro-bg + .intro-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      to top,
      rgba(6, 10, 9, 0.72) 0%,
      rgba(6, 10, 9, 0.62) 22%,
      rgba(6, 10, 9, 0.34) 50%,
      rgba(6, 10, 9, 0.1) 74%,
      rgba(6, 10, 9, 0.45) 100%
    );
  }

  /* No .panel-rail on this panel to absorb them, so the arrow row clears the
     home indicator and any browser toolbar itself. */
  .intro { --nav-safe: var(--foot); }

  /* Dimming alone still leaves branches, glare and skyline running straight
     through the words, so the foot of the hero is blurred as well. Masked so it
     is strongest where the copy sits and gone by the middle of the frame, which
     keeps the photograph itself sharp. */
  .intro-bg + .intro-stage::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    -webkit-mask-image: linear-gradient(to top, #000 0%, #000 26%, transparent 62%);
    mask-image: linear-gradient(to top, #000 0%, #000 26%, transparent 62%);
  }

  .intro-stage {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    /* Story framing: the copy sits at the foot of the image, not centred. */
    justify-content: flex-end;
    gap: 1.25rem;
    padding: calc(var(--safe-t) + 2rem) 1.4rem calc(4.75rem + var(--foot));
  }
  .intro-copy { max-width: 30rem; position: relative; z-index: 1; }
  .intro-copy h1 { font-size: clamp(2.1rem, 8.5vw, 3rem); line-height: 1.08; margin: 0.4rem 0 0.8rem; }
  .intro-lede { font-size: 1.02rem; line-height: 1.55; margin: 0 0 1rem; }
  .intro-body { font-size: 0.9rem; line-height: 1.6; color: var(--ink-dim); }
  .intro-body :global(p) { margin: 0 0 0.8rem; }
  .intro-meta {
    font-size: 0.72rem;
    color: var(--ink-dim);
    letter-spacing: 0.04em;
    margin: 1.1rem 0 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .intro-tools { display: flex; flex-wrap: wrap; gap: 0.6rem; position: relative; z-index: 1; }

  /* Story-style progress bar: one segment per panel, filled up to where you are.
     Sits above everything, including the panorama canvas. */
  .story {
    position: fixed;
    top: calc(var(--safe-t) + 0.5rem);
    left: 0.55rem;
    right: 0.55rem;
    display: flex;
    gap: 4px;
    z-index: 6;
  }
  .story a {
    flex: 1;
    /* The visible bar is 3px; the padding makes it a real touch target. */
    padding: 9px 0;
    display: block;
  }
  .story i {
    display: block;
    height: 3px;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.26);
    overflow: hidden;
    position: relative;
  }
  /* Width is driven per-frame from the autoplay clock, so no CSS transition --
     it would fight the animation and lag behind a scrub. */
  .story i::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 3px;
    background: #fff;
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }
  /* Edge-to-edge reads fine on a phone held upright, but stretched across a
     landscape screen the segments look like a loading bar. Cap and centre them
     so they stay a deliberate piece of chrome. */
  @media (orientation: landscape), (min-width: 40rem) {
    .story {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      width: min(30rem, calc(100% - 1.5rem));
    }
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Landscape: the intro is the only text-heavy panel, so let it scroll rather
     than clip when the phone is on its side. */
  @media (orientation: landscape) and (max-height: 520px) {
    .intro-stage { justify-content: flex-start; overflow-y: auto; padding-bottom: calc(4.6rem + var(--foot)); }
  }
</style>

<script>
  // ---- Story position -----------------------------------------------------
  // The segments mark where you are; the deck is moved by hand, with the arrows
  // on the foot of each panel. (The autoplay clock that used to advance it is
  // out for now.)
  const segs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.story a'));
  const order = segs.map((s) => s.dataset.for!);

  const fill = (i: number, p: number) => segs[i].style.setProperty('--p', String(p));
  // Filled up to and including the panel you are on, so the bar reads as
  // progress through the story rather than as a clock part-way through a panel.
  const showUpTo = (i: number) => segs.forEach((_, k) => fill(k, k <= i ? 1 : 0));

  // The observer is the single source of truth for which panel we are on.
  let idx = 0;
  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const i = order.indexOf(e.target.id);
        if (i < 0) continue;
        idx = i;
        showUpTo(i);
      }
    },
    { threshold: 0.55 },
  );
  document.querySelectorAll('.panel').forEach((el) => spy.observe(el));
  showUpTo(0);

  // ---- Tap to move --------------------------------------------------------
  // Story convention: the outer thirds of the panel step back and forward. Done
  // by watching for a tap rather than by laying invisible targets over the
  // panel -- an overlay would swallow the drag that turns the panorama, and
  // would have to be cut around every control on the way.
  const go = (d: number) => {
    const next = idx + d;
    if (next < 0 || next >= order.length) return;
    document.getElementById(order[next])?.scrollIntoView({ behavior: 'smooth' });
  };

  const TAP_SLOP = 10; // px of travel still counted as a tap, not a drag
  const TAP_MS = 350;
  // Anything you can operate is left alone, wherever it happens to sit.
  const CONTROLS = 'a, button, input, label, select, textarea, [role="button"]';

  let downX = 0;
  let downY = 0;
  let downAt = 0;
  addEventListener(
    'pointerdown',
    (e) => {
      downX = e.clientX;
      downY = e.clientY;
      downAt = performance.now();
    },
    { passive: true },
  );

  addEventListener(
    'pointerup',
    (e) => {
      if (performance.now() - downAt > TAP_MS) return;
      if (Math.hypot(e.clientX - downX, e.clientY - downY) > TAP_SLOP) return;
      if ((e.target as Element | null)?.closest?.(CONTROLS)) return;

      // The foot of the panel belongs to the arrows and whatever shares their
      // row, so the zones stop at the top of it rather than at a guessed inset.
      const nav = document.getElementById(order[idx])?.querySelector('.panel-nav');
      const floor = nav ? nav.getBoundingClientRect().top : innerHeight;
      if (e.clientY >= floor) return;

      const third = innerWidth / 3;
      if (e.clientX < third) go(-1);
      else if (e.clientX > innerWidth - third) go(1);
    },
    { passive: true },
  );

  // "Save for offline": ask the service worker to pull this location's media into
  // the cache while there is still signal in the car park.
  const btn = document.getElementById('offline') as HTMLButtonElement | null;
  const label = document.getElementById('offline-label');
  if (btn && label) {
    if (!('serviceWorker' in navigator)) {
      btn.hidden = true;
    } else {
      const assets: string[] = JSON.parse(btn.dataset.assets!);
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        label.textContent = 'Saving…';
        try {
          const reg = await navigator.serviceWorker.ready;
          const ch = new MessageChannel();
          const done = new Promise<boolean>((resolve) => {
            ch.port1.onmessage = (e) => resolve(Boolean(e.data?.ok));
            setTimeout(() => resolve(false), 30000);
          });
          reg.active?.postMessage(
            { type: 'cache-location', assets, page: location.pathname },
            [ch.port2],
          );
          label.textContent = (await done) ? 'Saved for offline' : 'Could not save';
        } catch {
          label.textContent = 'Could not save';
        }
      });
    }
  }
</script>
