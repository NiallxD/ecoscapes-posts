---
// /p/<slug>/: one page per post in posts/content/. The page itself is posts/PostPage.astro.
import { getCollection } from 'astro:content';
import PostPage from '../../../posts/PostPage.astro';

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  return locations.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
---

<PostPage entry={Astro.props.entry} />
