---
import { asset } from '../lib/paths';
import Odometer from './Odometer.astro';
import AnimalButton from './AnimalButton.astro';

interface Props {
  caption: string;
  /** The page's heading, top left over the picture. */
  title?: string;
  source: string;
  dir?: string;
  ext?: string;
  years?: number[];
  video?: {
    src: string; hevc?: string; poster?: string; base?: string; overlay?: string; from: number; to: number;
    burnedIn?: boolean; duration?: number; speed?: number;
    changes?: [number, number];
  };
  /** The Raven's line. Not shown for now -- the panel runs to the foot of the
   *  screen without a rail under it -- but kept in the frontmatter for when it
   *  comes back. */
  rail?: { title: string; body: string };
  legend?: { colour: string; label: string }[];
  callouts?: {
    year: number; x: number; y: number; title: string; body?: string;
    hold: number; messageHold?: number; dimHold?: number; pause: number; endPause: number;
    markerType: 'circle' | 'box' | 'none'; sizeX: number; sizeY: number;
    place: 'above' | 'below';
  }[];
  /** The panel's own anchor: one page per playthrough, so each needs its own. */
  id?: string;
  /** Which playthrough this page is, out of how many. */
  run?: { at: number; of: number };
  prev?: string;
  next?: string;
}
const { caption, title, source, dir, ext = 'webp', years, video, legend = [], callouts = [], id = 'change', run, prev, next } = Astro.props;
const pins = video ? callouts : [];

// Two ways to carry a time series. A pre-exported video is what TerrAdapt hands
// you; an image sequence scrubs more precisely when the years are discrete.
const frames = video ? [] : (years ?? []).map((y) => ({ year: y, src: asset(`${dir}/${y}.${ext}`) }));
const span = video ? video.to - video.from + 1 : 0;
const first = video ? video.from : years![0];
// What sits under the clip: the satellite when there is one to fade down to,
// otherwise the first frame.
const under = video ? video.base ?? video.poster : undefined;
---

<!-- data-clock: the story bar fills this page's segment with the clip rather
     than all at once, the way a story's segment runs with its video. -->
<section
  class="panel ts-panel"
  id={id}
  aria-label={run && run.of > 1 ? `Change over time, ${run.at} of ${run.of}` : 'Change over time'}
  data-clock={video ? '' : undefined}
  data-next={next}
>
  <div class="panel-stage">
    <!-- The picture is the page: it fills the screen, cropped at the sides on
         a phone taller than 4:5, and everything else floats over it. -->
    {video ? (
      <div
        class="ts-frames"
        data-mode="video"
        data-from={video.from}
        data-span={span}
        data-dur={video.duration}
        data-speed={video.speed}
        data-changes={video.changes?.join(',')}
      >
        <!-- The satellite, when there is one: what the land cover is faded
             down to from the settings. -->
        {video.base && (
          <img class="ts-frame ts-under" src={asset(video.base)} alt="" aria-hidden="true" decoding="async" />
        )}
        <!-- Over the satellite, under the land cover: a layer the clip already
             carries, so it is still there with the land cover faded out. -->
        {video.base && video.overlay && (
          <img class="ts-frame ts-under" src={asset(video.overlay)} alt="" aria-hidden="true" decoding="async" />
        )}
        <!-- The land cover: the clip, over its own first frame. The frame is
             there so a page whose clip is still loading shows the landscape
             rather than a black box -- or the satellite, since Safari drops a
             video's poster the moment it is told to play, before it has a
             frame to show, and for that beat the clip is transparent.
             Faded as one layer, so where the two overlap they are one picture
             at the chosen opacity rather than two stacked up at nearly double
             it. -->
        <div class="ts-cover">
        {video.poster && (
          <img class="ts-frame" src={asset(video.poster)} alt="" aria-hidden="true" decoding="async" />
        )}
        <!-- playsinline and muted are both required or iOS takes the video
             fullscreen instead of playing it in the panel. -->
        <video
          poster={video.poster ? asset(video.poster) : undefined}
          class="ts-frame ts-video"
          playsinline
          muted
          loop
          preload="none"
          data-preload={run && run.at > 1 ? 'metadata' : 'auto'}
          disablepictureinpicture
          aria-label={caption}
        >
          <!-- HEVC first: the browser takes the first it can play. -->
          {video.hevc && <source src={asset(video.hevc)} type='video/mp4; codecs="hvc1"' />}
          <source src={asset(video.src)} type="video/mp4" />
        </video>
        </div>
        <!-- Always present, even with no callouts: it is the layer the
             authoring ring is placed in, and placing the first one is exactly
             when there are none. -->
        <div class="pins" aria-hidden="true">
          <!-- Dims the picture everywhere but inside the open ring. First in
               the layer, so every ring and every label sits over it. -->
          <span class="pin-spot"></span>
          {pins.map((c) => (
            <span
              class="pin"
              data-place={c.place}
              data-x={c.x}
              data-y={c.y}
              data-year={c.year}
              data-hold={c.hold}
              data-message={c.messageHold ?? c.hold}
              data-type={c.markerType}
              data-sx={c.sizeX}
              data-sy={c.sizeY}
              data-pause={c.pause}
              data-end-pause={c.endPause}
              data-dim={c.dimHold ?? 0}
            >
              <span class="pin-ring"></span>
              <!-- The year it is pointing at, on the ring itself: the counter
                   in the corner says where the clip is, but this says what
                   you are being shown, in the same glance as the thing. -->
              <span class="pin-year"><Odometer value={c.year} /></span>
              <span class="pin-label">
                {c.title && <b>{c.title}</b>}
                {c.body && <em>{c.body}</em>}
              </span>
            </span>
          ))}
          <!-- Where the last tap landed, with ?config or ?pin. -->
          <span class="pin pin-ghost" hidden><span class="pin-ring"></span></span>
        </div>
        <!-- Authoring aids, with ?config (or ?pin / ?diag on their own). -->
        <div class="pin-probe" hidden></div>
        <div class="pin-pick-out" hidden></div>
      </div>
    ) : (
      <div class="ts-frames" data-mode="frames">
        {frames.map((f, i) => (
          <img
            src={f.src}
            alt={i === 0 ? `${caption}, ${f.year}` : ''}
            aria-hidden={i === 0 ? undefined : 'true'}
            class="ts-frame"
            data-year={f.year}
            style={`opacity:${i === 0 ? 1 : 0}`}
            decoding="async"
            fetchpriority={i === 0 ? 'high' : 'low'}
          />
        ))}
      </div>
    )}

    <!-- Across the top, under the story bar: what this page is, and the year
         the picture is showing, with the spinner beside it while the clip
         waits for data. -->
    <div class="ts-top">
      {title && <h2 class="ts-title">{title}</h2>}
      {video && (
        <div class="ts-loading" hidden>
          <span class="spinner" aria-hidden="true"></span>
        </div>
      )}
      {video && !video.burnedIn && (
        <output class="ts-year"><Odometer value={first} /></output>
      )}
    </div>

    <AnimalButton animal="raven" />

    <!-- The page's controls, in a column in the far corner as on the
         panorama: opacity, speed, what the colours mean, then back, then on. -->
    <div class="ts-side" data-no-tap>
      <!-- The land cover's opacity: a slider that opens up out of the button,
           above it, and folds away again once it is left alone. -->
      {video?.base && (
        <div class="ts-fade" data-no-tap>
          <div
            class="ts-fade-pop"
            id={`${id}-fade`}
            role="slider"
            tabindex="-1"
            aria-orientation="vertical"
            aria-label="Land cover opacity"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="100"
            aria-valuetext="100%"
          >
            <span class="ts-fade-end" aria-hidden="true">Map</span>
            <span class="ts-fade-track" aria-hidden="true"><i class="ts-fade-fill"></i><b class="ts-fade-knob"></b></span>
            <span class="ts-fade-end" aria-hidden="true">Sat</span>
          </div>
          <button class="step ts-fade-btn" type="button" aria-label="Land cover opacity" aria-expanded="false" aria-controls={`${id}-fade`}>
            <!-- Two layers, the top one half there. -->
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 4l8 4-8 4-8-4z" fill="currentColor" fill-opacity="0.45" />
              <path d="M4 12l8 4 8-4M4 16l8 4 8-4" />
            </svg>
          </button>
        </div>
      )}
      <!-- Speed, as a button that says what it is at and steps on a notch each
           tap: the design's own pace first, then faster, then slower. -->
      {video && (
        <button class="step ts-speed" type="button" aria-label="Playback speed">1×</button>
      )}
      {legend.length > 0 && (
        <button class="step ts-open ts-key" type="button" aria-label="What the colours mean" aria-expanded="false" aria-controls={`${id}-legend`}>
          <!-- Three swatches: a key, not a menu. -->
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="6.5" cy="7" r="1.6" fill="currentColor" stroke="none" /><path d="M11 7h8" />
            <circle cx="6.5" cy="12" r="1.6" fill="currentColor" stroke="none" /><path d="M11 12h8" />
            <circle cx="6.5" cy="17" r="1.6" fill="currentColor" stroke="none" /><path d="M11 17h8" />
          </svg>
        </button>
      )}
      {prev && (
        <a class="step" href={prev} aria-label="Previous section">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </a>
      )}
      {next && (
        <a class="step" href={next} aria-label="Next section">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </a>
      )}
    </div>

    <!-- The key, pulled up over the foot of the picture on asking. The clip
         holds while it is open: it is read, and the years should not run on
         underneath it. -->
    {legend.length > 0 && (
      <div class="ts-sheet" id={`${id}-legend`} data-sheet="key" role="dialog" aria-label="What the colours mean" inert data-no-tap>
        <div class="ts-sheet-card">
          <div class="ts-sheet-head">
            <p class="ts-sheet-title">{caption}</p>
            <button class="ts-sheet-close" type="button" aria-label="Close">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
            </button>
          </div>
          <ul class="ts-legend">
            {legend.map((l) => (
              <li><i style={`background:${l.colour}`}></i>{l.label}</li>
            ))}
          </ul>
          <p class="ts-sheet-source">{source}</p>
        </div>
      </div>
    )}

  </div>
</section>

<style>
  /* No rail under this stage, so everything at the foot clears it itself. */
  .ts-panel { --nav-safe: var(--foot); }

  /* The whole stage. */
  .ts-frames {
    position: absolute;
    inset: 0;
    background: #0a0f0d;
  }

  /* Absolutely positioned rather than grid-stacked: a grid row sized to content
     leaves height:100% indefinite, so a video falls back to its intrinsic
     aspect and overflows its box instead of fitting it. inset:0 gives every
     frame a definite box for object-fit to work against. */
  .ts-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Fills the screen. The clip is 4:5 and a phone is taller than that, so
       the sides go; the callouts are placed on the frame itself, and the pin
       layer is laid over the whole frame, cropped parts and all. */
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Under the clip, which is painted over it. */
  .ts-under { z-index: 0; }
  .ts-cover { position: absolute; inset: 0; z-index: 1; }

  /* ---- The key ---------------------------------------------------------- */
  .ts-sheet {
    position: absolute;
    inset: 0;
    /* Over the picture and the column; the story bar is later in the page at
       the same level, so it still sits on top. */
    z-index: 6;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: rgba(6, 10, 9, 0);
    visibility: hidden;
    transition: background 0.3s ease, visibility 0s linear 0.3s;
  }
  .ts-sheet.open {
    background: rgba(6, 10, 9, 0.4);
    visibility: visible;
    transition: background 0.3s ease, visibility 0s;
  }
  .ts-sheet-card {
    padding: 0.9rem 1.2rem calc(1.2rem + var(--foot));
    border-radius: 20px 20px 0 0;
    /* Solid: the corner buttons sit right behind it, and through anything
       translucent they read as ghosts of controls. */
    background: var(--bg-lift);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    transform: translateY(100%);
    transition: transform 0.34s cubic-bezier(0.3, 0.9, 0.3, 1);
  }
  .ts-sheet.open .ts-sheet-card { transform: none; }
  .ts-sheet-head { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.8rem; }
  .ts-sheet-title { flex: 1; margin: 0; font-size: 0.92rem; font-weight: 600; }
  .ts-sheet-close {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    cursor: pointer;
  }
  .ts-sheet-close svg { width: 16px; height: 16px; }
  .ts-sheet-source { margin: 0.9rem 0 0; font-size: 0.7rem; color: var(--ink-dim); }

  /* Two columns of swatches: a key is scanned down, not read across. */
  .ts-legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.55rem 1rem;
  }
  .ts-legend li {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.82rem;
    line-height: 1.3;
  }
  .ts-legend i {
    flex: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    /* The swatch is the export's own colour, so it is outlined rather than
       trusted to stand out against the sheet on its own. */
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.25);
  }

  /* The column in the corner: the same place, gap and buttons as the
     panorama's, so the two pages read as one design. */
  .ts-side {
    position: absolute;
    z-index: 4;
    right: 0.9rem;
    bottom: calc(1rem + var(--foot));
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .ts-side .step svg { width: 20px; height: 20px; }
  .ts-open[aria-expanded='true'] { border-color: var(--accent); color: var(--accent); }

  /* ---- Speed and opacity ------------------------------------------------ */
  .ts-speed {
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }
  /* A notch off the design's pace is a setting in force, so it is lit. */
  .ts-speed[data-off] { border-color: var(--accent); color: var(--accent); }

  .ts-fade { position: relative; }
  .ts-fade-btn[aria-expanded='true'],
  .ts-fade[data-off] .ts-fade-btn { border-color: var(--accent); color: var(--accent); }
  /* The same backing as the buttons, stretched upwards out of this one. Grows
     from its foot so it reads as the button opening rather than as something
     arriving from elsewhere. */
  .ts-fade-pop {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.5rem);
    width: 46px;
    height: 190px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0;
    box-sizing: border-box;
    border-radius: 23px;
    background: rgba(13, 18, 16, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    /* A drag up and down it is the slider's, not a swipe of the deck. */
    touch-action: none;
    cursor: ns-resize;
    outline: none;
    transform-origin: bottom center;
    transform: scaleY(0.3);
    opacity: 0;
    visibility: hidden;
    transition: transform 0.24s cubic-bezier(0.3, 1.2, 0.4, 1), opacity 0.18s ease, visibility 0s linear 0.24s;
  }
  .ts-fade[data-open] .ts-fade-pop {
    transform: none;
    opacity: 1;
    visibility: visible;
    transition: transform 0.24s cubic-bezier(0.3, 1.2, 0.4, 1), opacity 0.18s ease, visibility 0s;
  }
  .ts-fade-end { font-size: 0.56rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-dim); }
  .ts-fade-track {
    position: relative;
    flex: 1;
    width: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.18);
  }
  .ts-fade-fill {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--fill, 100%);
    border-radius: 2px;
    background: var(--accent);
  }
  .ts-fade-knob {
    position: absolute;
    left: 50%;
    bottom: var(--fill, 100%);
    width: 20px;
    height: 20px;
    margin: 0 0 -10px -10px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
  }

  /* The pin layer is sized to the painted picture, not its element box: the
     clip is cropped to fill the screen, and aligning to the box would drift
     every pin away from the ground it marks. */
  .pins {
    position: absolute;
    pointer-events: none;
    z-index: 2;
  }
  /* The rest of the picture, taken down while a callout is open.
     A radial gradient rather than a mask: the hole is the transparent middle of
     it, so there is nothing to cut out and nothing to keep in step -- the ring
     and the clearing are drawn from the same centre and the same radius. Clear
     to exactly the ring's edge, then down to full dim by a little under twice
     it, which keeps the edge soft enough not to read as a second circle. */
  /* The rest of the picture, taken down while a callout is open.
     The dim is one enormous shadow cast by a hole the shape of the marker: a
     box-shadow spreads from the element's own border-box, so whatever shape
     that box is -- circle, ellipse, rounded rectangle -- the clearing is that
     shape too, with no second description of it to keep in step. A gradient
     could only ever do the round ones.
     Blurred to soften the edge, which is what a gradient was giving; the hole
     is grown by about the blur so the softening eats into the dark rather than
     into what is being shown. Clipped to the picture, since the shadow is
     deliberately far larger than it. */
  /* The rest of the picture, taken down while a callout is open.
     A plain dark sheet with a hole masked out of it. The hole and its feathered
     edge are both gradients, which is the one way of drawing this that every
     engine renders alike -- a huge spread shadow can be declined, and a blur
     filter has a region whose reach is the engine's business. Both were tried
     here and both failed on one browser while looking perfect on another.
     The mask is written by the script, because its shape follows the marker's. */
  .pin-spot {
    position: absolute;
    inset: 0;
    background: rgba(6, 10, 9, 0.66);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  .pin-spot.on { opacity: 1; }

  /* The pin is only an anchor: a zero-weight point on the picture that its
     ring and its words hang off, each fading on its own clock. */
  .pin {
    position: absolute;
    width: var(--w, 40px);
    height: var(--h, 40px);
    /* Pulled back by half of itself, so the point it is placed at is its
       middle rather than its top left corner. */
    margin: calc(var(--h, 40px) / -2) 0 0 calc(var(--w, 40px) / -2);
  }
  /* Sized from the callout's own radius as a fraction of the picture, so it
     marks the same patch of ground on any screen. */
  .pin-ring {
    position: absolute;
    inset: 0;
    /* A circle at equal sizes, an ellipse at unequal ones: 50% of each axis is
       what does both without asking which it is. */
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: rgba(127, 209, 166, 0.14);
    /* Dark hairlines either side of the ring, so it holds against both a pale
       clearing and a dark forest. */
    box-shadow: 0 0 0 1px rgba(6, 10, 9, 0.5), inset 0 0 0 1px rgba(6, 10, 9, 0.35);
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .pin.on .pin-ring { opacity: 1; transform: none; }
  /* A box keeps its corners, but rounded -- a hard right angle drawn over a
     raster reads as a UI element sitting on the picture rather than as
     something marked on it. Scaled off the shorter side so a long thin
     rectangle does not end up with corners bigger than its own height. */
  /* None: the words alone -- no ring, and no year badge on a ring that is
     not there. */
  .pin[data-type='none'] .pin-ring,
  .pin[data-type='none'] .pin-year { display: none; }
  .pin[data-type='box'] .pin-ring {
    border-radius: calc(min(var(--w, 40px), var(--h, 40px)) * 0.16);
  }

  /* Sat on the ring's edge, on the opposite side to the words, so the two never
     stack up on one another. Accent-filled rather than outlined: it is a label
     on a picture full of colour, and it has to survive whatever it lands on. */
  .pin-year {
    position: absolute;
    left: 50%;
    top: 0;
    z-index: 1;
    transform: translate(-50%, -50%);
    padding: 0.1em 0.45em;
    border-radius: 999px;
    background: var(--accent);
    color: #08110c;
    font-size: 0.66rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.45;
    box-shadow: 0 0 0 1px rgba(6, 10, 9, 0.45);
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .pin.on .pin-year { opacity: 1; }
  /* Words above, so the year goes below. */
  .pin[data-place='above'] .pin-year {
    top: auto;
    bottom: 0;
    transform: translate(-50%, 50%);
  }

  /* The words, on the picture and hanging off the ring rather than sitting in a
     band underneath it -- so what is being said and what it is about are one
     thing, the way a panorama marker reads. `--nudge` is set by the script when
     a label would otherwise run off the side of the picture. */
  .pin-label {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.55rem);
    transform: translateX(calc(-50% + var(--nudge, 0px)));
    width: max-content;
    max-width: min(15rem, 76vw);
    padding: 0.5rem 0.7rem;
    border-radius: 12px;
    background: rgba(8, 13, 11, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    text-align: center;
    /* Kept in the layout even when closed, so the script can measure it to work
       out that nudge before it is ever shown. */
    opacity: 0;
    visibility: hidden;
    /* Only the fade is animated. The transform carries the centring and the
       nudge, which are corrections, not movement: transitioned, a label near
       the edge visibly slides into place as it appears. */
    transition: opacity 0.45s ease, visibility 0s linear 0.45s;
  }
  .pin.words .pin-label {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.45s ease, visibility 0s;
  }
  /* Above instead, by the same gap: for a callout low in the frame, whose words
     would otherwise hang off the bottom of the picture. */
  .pin[data-place='above'] .pin-label {
    top: auto;
    bottom: calc(100% + 0.55rem);
  }
  .pin-label b { display: block; font-size: 0.82rem; font-weight: 600; line-height: 1.3; }
  .pin-label em {
    display: block;
    font-style: normal;
    font-size: 0.74rem;
    line-height: 1.4;
    color: var(--ink-dim);
    margin-top: 0.15rem;
  }

  /* The authoring ring: the same shape a real callout draws, dashed and always
     visible, so it reads as something being placed rather than something that
     is placed. */
  .pin-ghost .pin-ring {
    opacity: 1;
    transform: none;
    border-style: dashed;
    background: rgba(127, 209, 166, 0.08);
  }
  .pin-ghost[hidden] { display: none; }

  /* The snippet a tap produced, low on the picture and clear of the column.
     There is nothing to read there while placing a callout. */
  .pin-pick-out {
    position: absolute;
    z-index: 5;
    left: 0.9rem;
    bottom: calc(1rem + var(--foot));
    padding: 0.5rem 0.7rem;
    border-radius: 9px;
    background: rgba(8, 13, 11, 0.9);
    border: 1px solid var(--accent);
    color: var(--ink);
    font: 500 0.7rem/1.35 ui-monospace, SFMono-Regular, Menlo, monospace;
    white-space: pre;
    text-align: left;
    /* Tapped to copy, like the panorama's readout; and selectable, as the
       last resort if a browser will do neither. */
    cursor: copy;
    user-select: text;
    -webkit-user-select: text;
    pointer-events: auto;
  }

  /* The diagnostic wears the same box as the ?pin aid, just wider and lower
     down, since it is read rather than tapped. */
  .pin-probe.diag {
    bottom: auto;
    top: 0.6rem;
    left: 50%;
    right: auto;
    font-size: 0.6rem;
    white-space: normal;
    max-width: 92%;
  }

  /* Authoring aid, only with ?pin */
  .pin-probe {
    position: absolute;
    left: 50%;
    bottom: 4.9rem;
    transform: translateX(-50%);
    z-index: 5;
    font: 500 0.74rem/1.4 ui-monospace, SFMono-Regular, Menlo, monospace;
    background: rgba(8, 13, 11, 0.9);
    border: 1px solid var(--accent);
    color: var(--ink);
    padding: 0.5rem 0.7rem;
    border-radius: 9px;
    text-align: center;
    white-space: pre;
  }

  /* Shown while the clip is waiting for data. Over a weak connection the first
     pass through can outrun the download, and a picture that sits still with a
     year that does not change reads as a broken page rather than a slow one. */
  /* The row across the top. The title takes what the year leaves it, so the
     year stays pinned to the right-hand corner whatever the title's length. */
  .ts-top {
    position: absolute;
    top: calc(var(--safe-t) + 1.9rem);
    left: 0.9rem;
    right: 0.9rem;
    z-index: 3;
    display: flex;
    align-items: flex-start;
    /* Right-aligned when there is no title to fill the row. */
    justify-content: flex-end;
    gap: 0.5rem;
    pointer-events: none;
  }
  /* The same pill as the year, so the two read as one row of labels. It
     sizes to its words and gives way to the year, not the other way round. */
  .ts-title {
    flex: 0 1 auto;
    min-width: 0;
    margin: 0 auto 0 0;
    padding: 0.28em 0.75em;
    /* A pill on one line; a long title wraps to a second and the ends stay
       round rather than going to a lozenge. */
    border-radius: 1.1em;
    background: rgba(13, 18, 16, 0.66);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.2;
    /* Two lines at most, so a long one never runs down into the picture. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .ts-loading[hidden] { display: none; }
  .ts-loading {
    flex: none;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(13, 18, 16, 0.66);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }
  .spinner {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.25);
    border-top-color: var(--accent);
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* The year the frame is showing, in the corner under the story bar. */
  .ts-year {
    flex: none;
    padding: 0.28em 0.6em;
    border-radius: 999px;
    background: rgba(13, 18, 16, 0.66);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.2;
  }

</style>

<script>
  // One page per playthrough, each its own copy of this panel, so everything
  // below is looked up inside its page rather than by id.
  const pages = Array.from(document.querySelectorAll<HTMLElement>('.ts-panel'));

  // The reader's view settings: how much of the land cover is laid over the
  // satellite, and how many times the clip's own pace to play it at. One set
  // for every playthrough, since they are one series; kept for the visit, so
  // a reload does not undo them, but a fresh visit starts from the design.
  const TUNE = 'ts-tune';
  const tune = { cover: 1, mult: 1 };
  try {
    const kept = JSON.parse(sessionStorage.getItem(TUNE) ?? '{}');
    if (kept.cover >= 0 && kept.cover <= 1) tune.cover = kept.cover;
    if (kept.mult > 0 && kept.mult <= 4) tune.mult = kept.mult;
  } catch {}
  const tuners: (() => void)[] = [];
  const setTune = (patch: Partial<typeof tune>) => {
    Object.assign(tune, patch);
    try { sessionStorage.setItem(TUNE, JSON.stringify(tune)); } catch {}
    for (const apply of tuners) apply();
  };

  for (const page of pages) {
  const wrap = page.querySelector<HTMLElement>('.ts-frames');
  if (wrap) {
    const yearOut = page.querySelector('.ts-year'); // absent for burned-in exports

    // ---- The sheets -------------------------------------------------------
    // The key, pulled up by its button in the corner and closed by its own
    // button, a tap on the picture above it, or Escape. Written for more than
    // one; the page says when each opens and closes -- `key:open` -- so the
    // clip can hold for it.
    const openers = Array.from(page.querySelectorAll<HTMLButtonElement>('.ts-open'));
    const sheets = Array.from(page.querySelectorAll<HTMLElement>('.ts-sheet'));
    const openerOf = (sheet: HTMLElement) => openers.find((b) => b.getAttribute('aria-controls') === sheet.id);
    const setSheet = (sheet: HTMLElement, open: boolean) => {
      if (sheet.classList.contains('open') === open) return;
      if (open) for (const other of sheets) if (other !== sheet) setSheet(other, false);
      sheet.classList.toggle('open', open);
      sheet.inert = !open;
      openerOf(sheet)?.setAttribute('aria-expanded', String(open));
      page.dispatchEvent(new CustomEvent(`${sheet.dataset.sheet}:${open ? 'open' : 'close'}`));
    };
    for (const sheet of sheets) {
      openerOf(sheet)?.addEventListener('click', () => setSheet(sheet, !sheet.classList.contains('open')));
      sheet.querySelector('.ts-sheet-close')?.addEventListener('click', () => setSheet(sheet, false));
      sheet.addEventListener('click', (e) => { if (e.target === sheet) setSheet(sheet, false); });
    }
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') for (const sheet of sheets) setSheet(sheet, false);
    });

    if (wrap.dataset.mode === 'video') {
      // ---- Pre-exported video -------------------------------------------
      const v = wrap.querySelector('.ts-video') as HTMLVideoElement;
      const from = Number(wrap.dataset.from);
      const span = Number(wrap.dataset.span); // how many years

      // Playback speed. Re-applied on load as well as now: some browsers reset
      // the rate when the media is (re)loaded, and a clip that quietly returns
      // to 1x is the kind of thing that is only noticed much later.
      // The reader's multiplier is on top of the frontmatter's pace.
      const speed = Number(wrap.dataset.speed);
      const applySpeed = () => {
        v.playbackRate = (speed > 0 && Number.isFinite(speed) ? speed : 1) * tune.mult;
      };
      applySpeed();
      v.addEventListener('loadedmetadata', applySpeed);

      // A page left on its last year is wound back once it is wholly off
      // screen, so arriving never shows the year the last visit ended on. A
      // sliver rather than zero: the page beside the one on screen shares an
      // edge with the viewport, which counts as intersecting at zero.
      new IntersectionObserver(
        (e) => {
          if (!e[0].isIntersecting && v.currentTime) v.currentTime = 0;
        },
        { threshold: 0.02 },
      ).observe(wrap);
      // Decoded now, not when first scrolled to, so no picture paints late.
      for (const img of wrap.querySelectorAll<HTMLImageElement>('img')) img.decode().catch(() => {});

      // ---- The settings --------------------------------------------------
      // The land cover is faded rather than the satellite, so at full it is
      // exactly the clip as designed, and the dim, rings and words over it
      // are untouched either way.
      const coverLayer = wrap.querySelector<HTMLElement>('.ts-cover');
      const speedBtn = page.querySelector<HTMLButtonElement>('.ts-speed');
      const fade = page.querySelector<HTMLElement>('.ts-fade');
      const fadeBtn = fade?.querySelector<HTMLButtonElement>('.ts-fade-btn');
      const fadePop = fade?.querySelector<HTMLElement>('.ts-fade-pop');
      const fadeTrack = fade?.querySelector<HTMLElement>('.ts-fade-track');
      const applyTune = () => {
        applySpeed();
        if (speedBtn) {
          speedBtn.textContent = `${tune.mult}×`;
          speedBtn.setAttribute('aria-label', `Playback speed, ${tune.mult} times`);
          speedBtn.toggleAttribute('data-off', tune.mult !== 1);
        }
        // Only with a satellite to fade to: without one it would fade to black.
        if (fade && fadePop) {
          if (coverLayer) coverLayer.style.opacity = String(tune.cover);
          const pc = Math.round(tune.cover * 100);
          fadePop.style.setProperty('--fill', `${pc}%`);
          fadePop.setAttribute('aria-valuenow', String(pc));
          fadePop.setAttribute('aria-valuetext', `${pc}%`);
          fade.toggleAttribute('data-off', pc !== 100);
        }
      };
      tuners.push(applyTune);
      applyTune();

      // Each tap steps on a notch, and round.
      const SPEEDS = [1, 1.5, 2, 0.5];
      speedBtn?.addEventListener('click', () => {
        const at = SPEEDS.indexOf(tune.mult);
        setTune({ mult: SPEEDS[(at + 1) % SPEEDS.length] });
      });

      // The opacity slider opens out of its button and folds away 1.2 seconds
      // after it was last touched -- never while a finger is still on it.
      if (fade && fadeBtn && fadePop && fadeTrack) {
        const IDLE = 1200;
        let idle: number | undefined;
        let dragging = false;
        const setFade = (open: boolean) => {
          if (fade.hasAttribute('data-open') === open) return;
          fade.toggleAttribute('data-open', open);
          fadeBtn.setAttribute('aria-expanded', String(open));
          fadePop.tabIndex = open ? 0 : -1;
          clearTimeout(idle);
          page.dispatchEvent(new CustomEvent(open ? 'tune:open' : 'tune:close'));
        };
        const touched = () => {
          clearTimeout(idle);
          if (!dragging) idle = window.setTimeout(() => setFade(false), IDLE);
        };
        fadeBtn.addEventListener('click', () => {
          const open = !fade.hasAttribute('data-open');
          setFade(open);
          if (open) touched();
        });
        // Top of the track is all land cover, the foot all satellite.
        const coverAt = (y: number) => {
          const r = fadeTrack.getBoundingClientRect();
          return Math.min(1, Math.max(0, (r.bottom - y) / r.height));
        };
        fadePop.addEventListener('pointerdown', (e) => {
          dragging = true;
          clearTimeout(idle);
          fadePop.setPointerCapture(e.pointerId);
          setTune({ cover: coverAt(e.clientY) });
        });
        fadePop.addEventListener('pointermove', (e) => {
          if (dragging) setTune({ cover: coverAt(e.clientY) });
        });
        const letGo = () => {
          if (!dragging) return;
          dragging = false;
          touched();
        };
        fadePop.addEventListener('pointerup', letGo);
        fadePop.addEventListener('pointercancel', letGo);
        fadePop.addEventListener('keydown', (e) => {
          const step = { ArrowUp: 0.05, ArrowRight: 0.05, ArrowDown: -0.05, ArrowLeft: -0.05, Home: -1, End: 1 }[e.key];
          if (step === undefined) return;
          e.preventDefault();
          setTune({ cover: Math.min(1, Math.max(0, tune.cover + step)) });
          touched();
        });
        addEventListener('keydown', (e) => { if (e.key === 'Escape') setFade(false); });
        // Folded away when the page is left, so it is not found open on return.
        new IntersectionObserver((e) => { if (!e[0].isIntersecting) setFade(false); }, { threshold: 0.6 }).observe(wrap);
      }

      // How long the clip is, by whatever the media will admit to.
      //
      // Everything here is a fraction of the clip's length, so a `duration` of
      // NaN or Infinity does not merely skew the slider -- it pins it. Safari
      // can report exactly that for a while, and for longer when the bytes are
      // arriving as ranged responses out of the service worker cache, which is
      // this panel's normal path on a revisit. What is seekable is the honest
      // second answer, and 0 means "not known yet" rather than a bad number.
      const clipLength = () => {
        if (v.duration && isFinite(v.duration)) return v.duration;
        const s = v.seekable;
        if (s && s.length) {
          const end = s.end(s.length - 1);
          if (end && isFinite(end)) return end;
        }
        // What the file itself says, measured at build time. Last, because the
        // media is the authority whenever it will answer -- but a browser that
        // answers neither of the above would otherwise freeze the year, the
        // slider and every callout, and the length is not a mystery: it is in
        // the frontmatter.
        const told = Number(wrap.dataset.dur);
        return Number.isFinite(told) && told > 0 ? told : 0;
      };

      // Which year the picture is showing, as an index from the first, and
      // where in the clip a year begins.
      //
      // By default every year owns an equal share of the clip. With `changes`
      // -- the times of the first and last change, read off the export -- the
      // changes are evenly spaced between those two instead, which is what an
      // edit with a dissolve centred on each boundary produces: the first and
      // last years get half a share, and an equal split would run the readout
      // most of a year behind the picture at either end.
      const changes = (wrap.dataset.changes ?? '').split(',').map(Number);
      const hasChanges = changes.length === 2 && changes.every(Number.isFinite) && span > 2;
      const step = hasChanges ? (changes[1] - changes[0]) / (span - 2) : 0;
      const indexAt = (t: number) => {
        const d = clipLength();
        if (!d) return span - 1;
        const i = hasChanges
          ? t < changes[0] ? 0 : Math.floor((t - changes[0]) / step + 1e-6) + 1
          : Math.floor((t / d) * span);
        return Math.min(span - 1, Math.max(0, i));
      };
      const startOf = (year: number) => {
        const i = year - from;
        if (i <= 0) return 0;
        return hasChanges ? changes[0] + (i - 1) * step : (i / span) * clipLength();
      };
      const yearAt = (t: number) => from + indexAt(t);

      // Everywhere the year is written: the pill in the corner of the picture,
      // and the badge on any ring that is open. The badge counts with the clip
      // rather than stating the year its callout was written for -- the ring is
      // where the eye already is, so that is where the year has to be to be
      // read in the same glance as the thing it is about.
      // Every odometer on this panel: the pill in the corner and the badge on
      // each ring. They are set together, so they cannot drift apart.
      const odometers = Array.from(page.querySelectorAll<HTMLElement>('[data-odo]'));

      // Each column is two sets of 0-9. A digit that must fall -- 9 to 0, or a
      // whole year going back to 1985 on the loop -- is sent to the same digit
      // in the second set instead, so it carries on upwards. When it gets
      // there the column is dropped back one set with the transition off: the
      // same digit in the same place, so nothing visibly happens, and the next
      // change has room to roll up again.
      const normalise = (col: HTMLElement) => {
        const strip = col.firstElementChild as HTMLElement | null;
        const at = Number(col.style.getPropertyValue('--n'));
        if (!strip || !(at >= 10)) return;
        strip.style.transition = 'none';
        col.style.setProperty('--n', String(at - 10));
        void strip.offsetHeight; // flush, or the line below animates the drop
        strip.style.transition = '';
      };
      for (const odo of odometers) {
        for (const col of odo.querySelectorAll<HTMLElement>('.odo-d')) {
          col.firstElementChild?.addEventListener('transitionend', () => normalise(col));
        }
      }

      const rollTo = (odo: HTMLElement, year: string) => {
        const said = odo.querySelector('[data-odo-text]');
        if (said) said.textContent = year;
        const columns = odo.querySelectorAll<HTMLElement>('.odo-d');
        columns.forEach((col, i) => {
          const want = Number(year[i] ?? 0);
          // Still in the second set: a year lasts about a third of a second
          // and a roll a little longer, so a roll is often cut short by the
          // next one -- and a cut-short transition never ends, so the drop back
          // above never came. Done here instead, or this column would be sent
          // from 10 back down to 1 and visibly roll backwards.
          if (Number(col.style.getPropertyValue('--n')) >= 10) normalise(col);
          const at = Number(col.style.getPropertyValue('--n')) || 0;
          const showing = at % 10;
          if (want === showing) return;
          // Up to it if it is above, and up and round to it if it is below.
          col.style.setProperty('--n', String(want >= showing ? want : want + 10));
        });
      };
      let yearShown = '';
      const paintYear = (year: string) => {
        if (year === yearShown) return; // a write per frame, otherwise
        yearShown = year;
        for (const odo of odometers) rollTo(odo, year);
      };

      const sync = () => {
        if (!clipLength()) return;
        paintYear(String(yearAt(v.currentTime)));
      };

      /** Seconds this playthrough holds on its last frame before moving on. */
      const endPause = () => Number(allPins[0]?.dataset.endPause) || 0;
      /** Seconds its callout stops the clip for. */
      const calloutPause = () => Number(allPins[0]?.dataset.pause) || 0;

      // ---- Story clock ---------------------------------------------------
      // How far through the page, for the story bar to fill its segment with.
      //
      // Measured in the reader's seconds, not the clip's: the page is the clip
      // at its playback speed, plus the callout's stop, plus the hold at the
      // end, and the segment runs across all of it at one steady pace -- as a
      // story's bar does -- rather than stalling for the stop and then jumping.
      // Derived from the state of the page each frame rather than counted up,
      // so a pause simply shows where things now are.
      let pauseFrom = 0; // when the callout's stop began, while it is on
      let pauseSpent = 0; // seconds of it already sat through
      let holdFrom = 0; // when the end hold began, while it is on
      let holdStart = 0; // the fill it began from
      const storyAt = () => {
        const d = clipLength();
        if (!d) return 0;
        const rate = v.playbackRate || 1;
        const total = d / rate + calloutPause() + endPause();
        const stopped = pauseFrom ? Math.min(calloutPause(), (performance.now() - pauseFrom) / 1000) : 0;
        const p = (v.currentTime / rate + pauseSpent + stopped) / total;
        return Math.min(1, Math.max(0, p));
      };
      const fillAt = () => {
        if (!holdFrom) return storyAt();
        // The hold runs out whatever is left, so the segment is full at the
        // moment the next page arrives -- even when a stop was cut short.
        const k = endPause() > 0 ? Math.min(1, (performance.now() - holdFrom) / 1000 / endPause()) : 1;
        return holdStart + (1 - holdStart) * k;
      };
      let told = -1;
      let storyRaf = 0;
      const tellProgress = () => {
        const p = fillAt();
        if (Math.abs(p - told) < 0.0005) return;
        told = p;
        page.dispatchEvent(new CustomEvent('story:progress', { bubbles: true, detail: p }));
      };
      const startStory = () => {
        if (storyRaf) return;
        const step = () => {
          tellProgress();
          storyRaf = requestAnimationFrame(step);
        };
        storyRaf = requestAnimationFrame(step);
      };
      const stopStory = () => {
        if (storyRaf) cancelAnimationFrame(storyRaf);
        storyRaf = 0;
      };
      /** Back to the top of the page's clock: nothing sat through yet. */
      const resetStory = () => {
        pauseFrom = 0;
        pauseSpent = 0;
        holdFrom = 0;
        told = -1;
      };

      // `timeupdate` is the wrong clock to roll the year with: browsers fire it
      // on their own schedule -- a few times a second at best, and coarser on a
      // throttled phone -- and at three years a second that skips years. A
      // frame clock while playing, stopped the moment it is not needed.
      let clock = 0;
      const startClock = () => {
        if (clock) return;
        const step = () => {
          sync();
          clock = requestAnimationFrame(step);
        };
        clock = requestAnimationFrame(step);
      };
      const stopClock = () => {
        if (clock) cancelAnimationFrame(clock);
        clock = 0;
      };

      v.addEventListener('loadedmetadata', () => {
        // Deliberately no seek here. Opening on the last year used to make the
        // panel show the state people expect before they press anything -- but
        // the clip is played from the start the moment the panel is reached, so
        // that seek was only ever visible for an instant, and it cost a jump to
        // the far end of the file. Over a weak connection the wait for data at
        // the end blocks the seek back to the start and the play that follows:
        // the clock sits at the last year and nothing moves. The poster is the first frame, so there is a real
        // picture to look at either way.
        sync();
        showCallouts(v.currentTime);
      });

      // Waiting for data, said plainly. `waiting` and `playing` are the events
      // that bracket a stall; `canplay` covers the first fill of the buffer.
      const spinner = page.querySelector<HTMLElement>('.ts-loading');
      const waiting = (on: boolean) => { if (spinner) spinner.hidden = !on; };
      waiting(true);
      v.addEventListener('waiting', () => waiting(true));
      v.addEventListener('stalled', () => waiting(true));
      v.addEventListener('playing', () => waiting(false));
      v.addEventListener('canplay', () => waiting(false));
      // Paused by a callout is not waiting for anything.
      v.addEventListener('pause', () => waiting(false));

      // A play refused or abandoned mid-stall leaves the panel stopped on a
      // poster with no way to know it should have started, so it is tried again
      // as soon as there is enough data to run.
      v.addEventListener('canplay', () => {
        // Not over a callout's stop or the end hold, which are pauses on
        // purpose, and not over one by hand.
        if (!inView || userPaused || !v.paused || v.ended || resumeTimer !== null) return;
        v.play().catch(() => {});
      });
      let inView = false;
      let userPaused = false;
      v.addEventListener('timeupdate', () => {
        sync();
        showCallouts(v.currentTime);
      });
      // Whatever the length was worth at load, these are where it improves.
      v.addEventListener('durationchange', sync);
      v.addEventListener('canplay', sync);
      v.addEventListener('progress', sync);
      v.addEventListener('seeked', () => {
        sync();
        // A seek moves the clock too, so the callouts are settled here rather
        // than only on the next timeupdate.
        showCallouts(v.currentTime);
      });
      v.addEventListener('play', startClock);
      v.addEventListener('pause', () => { stopClock(); sync(); });
      // The end of a playthrough is handled here rather than by the element:
      // it holds for `endPause`, then hands over to the next page. `loop`
      // stays on the markup for the case where this script never arrives.
      v.loop = false;
      let ending = false;
      v.addEventListener('ended', async () => {
        stopClock();
        if (ending) return;
        ending = true;
        try {
          // Whatever the clip ended on, still marked: the ring, the words and
          // the dim are what the hold exists to be looked at with.
          holdStart = storyAt();
          holdFrom = performance.now();
          const wait = endPause();
          if (wait > 0) await new Promise((r) => setTimeout(r, wait * 1000));
          // Not while the key or the opacity slider is open: the reader is
          // in the middle of it. The slider picks this up again as it folds.
          if (userPaused || tuning || !inView || !holdFrom) return;
          advance();
        } finally {
          ending = false;
        }
      });
      // The next playthrough, if there is one. After the last, the page
      // stays on its final frame -- the rest of the deck is not a story
      // that runs by itself, so the series does not carry on into it.
      const advance = () => {
        const next = page.dataset.next ? document.querySelector<HTMLElement>(page.dataset.next) : null;
        if (next?.classList.contains('ts-panel')) next.scrollIntoView({ behavior: 'smooth' });
      };

      // The opacity slider leaves the clip running, since that is how it is
      // judged -- but a playthrough that ends under it waits for it to fold
      // rather than turning the page out from under the reader.
      let tuning = false;
      page.addEventListener('tune:open', () => { tuning = true; });
      page.addEventListener('tune:close', () => {
        tuning = false;
        if (v.ended && inView && !ending) advance();
      });

      // Held while the key is open, and let go when it closes -- unless it was
      // already standing still for a reason of its own (the end of the clip).
      let heldForKey = false;
      page.addEventListener('key:open', () => {
        heldForKey = !v.ended;
        userPaused = true;
        clearResume();
        v.pause();
      });
      // An animal's page covers this one: held the same way, and let go when
      // it closes -- only if this is the page on screen.
      let heldForAnimal = false;
      document.addEventListener('animal:open', () => {
        if (!inView) return;
        heldForAnimal = true;
        page.dispatchEvent(new CustomEvent('key:open'));
      });
      document.addEventListener('animal:close', () => {
        if (!heldForAnimal) return;
        heldForAnimal = false;
        page.dispatchEvent(new CustomEvent('key:close'));
      });
      page.addEventListener('key:close', () => {
        userPaused = false;
        if (heldForKey && inView) v.play().catch(() => {});
        heldForKey = false;
      });

      // ---- Callouts ------------------------------------------------------
      // Positions are fractions of the FRAME, but the frame is cropped to fill
      // its element, so the pin layer is laid over the whole painted frame --
      // parts of it off screen -- rather than the element box. Otherwise every
      // pin drifts by however much of the frame the crop has taken away.
      const pinLayer = wrap.querySelector<HTMLElement>('.pins');
      const probe = wrap.querySelector<HTMLElement>('.pin-probe');
      // Only the real one: the authoring ring wears the same class so that it
      // looks like what it is placing. A page carries one callout -- its
      // playthrough -- so this is a list of one or none.
      const allPins = pinLayer
        ? Array.from(pinLayer.querySelectorAll<HTMLElement>('.pin[data-year]'))
        : [];

      const paintedRect = () => {
        const box = v.getBoundingClientRect();
        const ar = v.videoWidth / v.videoHeight;
        if (!ar || !isFinite(ar)) return { x: 0, y: 0, w: box.width, h: box.height };
        // object-fit: cover -- scaled until it covers the box, then centred.
        const boxAr = box.width / box.height;
        const w = boxAr > ar ? box.width : box.height * ar;
        const h = boxAr > ar ? box.width / ar : box.height;
        return { x: (box.width - w) / 2, y: (box.height - h) / 2, w, h };
      };

      const layout = () => {
        if (!pinLayer) return;
        const r = paintedRect();
        pinLayer.style.left = `${r.x}px`;
        pinLayer.style.top = `${r.y}px`;
        pinLayer.style.width = `${r.w}px`;
        pinLayer.style.height = `${r.h}px`;
        for (const pin of allPins) {
          pin.style.left = `${Number(pin.dataset.x) * 100}%`;
          pin.style.top = `${Number(pin.dataset.y) * 100}%`;
          // Both sizes are fractions of the painted WIDTH, resolved here into
          // pixels: a percentage would resolve against the layer's height for
          // one axis and its width for the other, so equal values would not
          // come out equal and a circle would go oval on a frame that is not
          // square.
          pin.style.setProperty('--w', `${Number(pin.dataset.sx) * r.w}px`);
          pin.style.setProperty('--h', `${Number(pin.dataset.sy) * r.w}px`);
        }
        // The picture has just changed size, so every label's overrun has too.
        allPins.forEach((pin, i) => nudgeLabel(pin, allLabels[i]));
        // ...and so has the drawn size of whatever the dim is aimed at. Aimed
        // rather than re-lit, so a dim that has already had its time is not
        // brought back by a turn of the phone.
        if (litPin) aimSpot(litPin);
        showCallouts(v.currentTime);
      };

      const allLabels = allPins.map((pin) => pin.querySelector<HTMLElement>('.pin-label'));
      const spot = wrap.querySelector<HTMLElement>('.pin-spot');

      /** Aim the dim at a pin, or let it go if there is nothing open. */
      const FEATHER = 26; // px of soft edge around the hole
      const aimSpot = (pin: HTMLElement | null) => {
        if (!spot) return;
        // Nothing marked, so nothing to pick out: no dim.
        if (pin?.dataset.type === 'none') pin = null;
        const layer = pinLayer?.getBoundingClientRect();
        if (pin && layer) {
          // The hole, in the picture's own pixels.
          const w = parseFloat(pin.style.getPropertyValue('--w')) || 40;
          const h = parseFloat(pin.style.getPropertyValue('--h')) || 40;
          const cx = Number(pin.dataset.x) * layer.width;
          const cy = Number(pin.dataset.y) * layer.height;
          // A mask is opaque where the dim should show and transparent where
          // the picture should come through.
          const mask =
            pin.dataset.type === 'box'
              ? // Two soft-edged bands, one across and one down. Masks are
                // unioned by default, so the only place both are transparent --
                // and the only place the picture shows -- is where they cross.
                // Their overlapping ramps round the corners for free.
                [
                  `linear-gradient(to right, #000 ${cx - w / 2 - FEATHER}px, #0000 ${cx - w / 2}px,` +
                    ` #0000 ${cx + w / 2}px, #000 ${cx + w / 2 + FEATHER}px)`,
                  `linear-gradient(to bottom, #000 ${cy - h / 2 - FEATHER}px, #0000 ${cy - h / 2}px,` +
                    ` #0000 ${cy + h / 2}px, #000 ${cy + h / 2 + FEATHER}px)`,
                ].join(', ')
              : // Clear to the marker's own edge, then up to full dim across
                // the feather. Two radii, so an ellipse comes out elliptical.
                `radial-gradient(${w / 2 + FEATHER}px ${h / 2 + FEATHER}px at ${cx}px ${cy}px,` +
                ` #0000 0, #0000 ${(w / 2 / (w / 2 + FEATHER)) * 100}%, #000 100%)`;
          spot.style.webkitMaskImage = mask;
          spot.style.maskImage = mask;
        }
        spot.classList.toggle('on', Boolean(pin));
      };

      // The dim has its own clock, in real seconds, because the thing it is
      // timed against is a person looking rather than a year passing -- and
      // because a ring set to stay for the whole run would otherwise hold the
      // picture down with it.
      let litPin: HTMLElement | null = null;
      let dimTimer: number | null = null;
      const clearDim = () => {
        if (dimTimer !== null) clearTimeout(dimTimer);
        dimTimer = null;
      };
      const spotlight = (pin: HTMLElement | null) => {
        if (pin === litPin) return; // already said
        litPin = pin;
        clearDim();
        aimSpot(pin);
        if (!pin) return;
        const secs = Number(pin.dataset.dim);
        // 0, or nothing sensible, means for as long as the ring is up, which is
        // what the ring going out will take care of.
        if (!(secs > 0)) return;
        dimTimer = window.setTimeout(() => {
          dimTimer = null;
          aimSpot(null);
        }, secs * 1000);
      };

      /**
       * Keep a label on the picture.
       *
       * It is centred on its ring, which is fine in the middle of the frame and
       * not at the edges -- a callout near the right-hand side would hang half
       * its words off the picture. This measures how far it overruns and hands
       * the shortfall back as `--nudge`, so it slides in just enough while the
       * ring stays exactly where it is. Measured against what is on screen,
       * since the frame itself runs off both sides.
       */
      const nudgeLabel = (pin: HTMLElement, label: HTMLElement | null) => {
        if (!label || !pinLayer) return;
        label.style.setProperty('--nudge', '0px');
        const bounds = wrap.getBoundingClientRect();
        const box = label.getBoundingClientRect();
        const pad = 8;
        let shift = 0;
        if (box.left < bounds.left + pad) shift = bounds.left + pad - box.left;
        else if (box.right > bounds.right - pad) shift = bounds.right - pad - box.right;
        if (shift) label.style.setProperty('--nudge', `${Math.round(shift)}px`);
      };

      // A callout opens on its own year and stays for `hold` seconds of
      // playback, so its window is measured in clip time rather than in years:
      // the frontmatter says how long there is to read it, not how many years
      // it covers. `startOf` knows where each year begins in the clip.
      // Two windows from the same starting year: one for the ring on the frame,
      // one for the words beside it.
      //
      // A hold of 0 is the rest of the run rather than no time at all: the page
      // ends with the clip, and the next playthrough is the next page, so
      // "until the end" needs no closing time of its own. Nothing is lost by spending the value
      // this way -- a duration of nothing draws something nobody ever sees.
      const windowFor = (pin: HTMLElement) => {
        const start = startOf(Number(pin.dataset.year));
        const until = (seconds: number) => (seconds > 0 ? start + seconds : Infinity);
        const hold = Number(pin.dataset.hold);
        const message = Number(pin.dataset.message);
        return {
          start,
          ring: until(hold),
          words: until(Number.isFinite(message) ? message : hold),
        };
      };

      // A callout carrying `pause` stops the clip when it opens, so there is
      // time to look at what it circles before the years move on.
      //
      // Honoured once per play: the pause has to end by playing, which puts the
      // clock right back inside the same callout's window, and without this it
      // would catch again immediately and never advance. The set is cleared
      // when the clip restarts or the panel is left, so a second time pauses
      // again.
      const honoured = new Set<number>();
      let resumeTimer: number | null = null;
      // The stop is banked into the story clock when it ends, however it ends.
      const bankPause = () => {
        if (!pauseFrom) return;
        pauseSpent += Math.min(calloutPause(), (performance.now() - pauseFrom) / 1000);
        pauseFrom = 0;
      };
      const clearResume = () => {
        if (resumeTimer !== null) clearTimeout(resumeTimer);
        resumeTimer = null;
        bankPause();
      };
      const pauseFor = (seconds: number) => {
        clearResume();
        v.pause();
        pauseFrom = performance.now();
        resumeTimer = window.setTimeout(() => {
          resumeTimer = null;
          bankPause();
          // Not if they took over in the meantime: the key being open outranks us.
          if (userPaused) return;
          v.play().catch(() => {});
        }, seconds * 1000);
      };

      const showCallouts = (t: number) => {
        // No duration yet means no year mapping yet; leaving them closed beats
        // flashing every callout at once while the metadata is still coming.
        if (!clipLength()) return;
        let lit: HTMLElement | null = null;
        for (let i = 0; i < allPins.length; i++) {
          const pin = allPins[i];
          const w = windowFor(pin);
          const mine = t >= w.start;
          const ringOn = mine && t < w.ring;
          const wordsOn = mine && t < w.words;
          const wasWords = pin.classList.contains('words');
          pin.classList.toggle('on', ringOn);
          pin.classList.toggle('words', wordsOn);
          // Measured as it opens, when the picture is at its current size and
          // the label holds the text it is about to show.
          if (wordsOn && !wasWords) nudgeLabel(pin, allLabels[i]);
          if (ringOn) lit = pin;
          // Only while it is genuinely playing, so a seek that lands inside a
          // callout does not leave the clip stopped there.
          const wait = Number(pin.dataset.pause) || 0;
          if ((ringOn || wordsOn) && wait > 0 && !honoured.has(i) && !v.paused) {
            honoured.add(i);
            pauseFor(wait);
          }
        }
        // The dim follows the ring rather than the words: it is there to say
        // where to look, and once the ring has gone there is nothing to look at.
        spotlight(lit);
      };

      layout();
      addEventListener('resize', layout, { passive: true });
      addEventListener('orientationchange', () => setTimeout(layout, 120));
      v.addEventListener('loadedmetadata', layout);

      // One switch for the authoring aids, so there is a single thing to
      // remember on site: ?config turns on everything this panel can show you.
      // The narrower flags stay, for when only one of them is wanted.
      const flags = new URLSearchParams(location.search);
      const config = flags.has('config');

      // Diagnostic: what the clip is actually doing, because the things that go
      // wrong here go wrong on a particular phone and not on a desk.
      if (probe && (flags.has('diag') || config)) {
        probe.hidden = false;
        probe.classList.add('diag');
        const tell = () => {
          const d = clipLength();
          probe.textContent =
            `dur ${v.duration?.toFixed?.(2) ?? '-'} use ${d ? d.toFixed(2) : 'NONE'} ` +
            `t ${v.currentTime.toFixed(2)} rs ${v.readyState} ` +
            `${v.paused ? 'paused' : 'playing'} yr ${yearAt(v.currentTime)}`;
        };
        setInterval(tell, 250);
        tell();
      }

      // Authoring aid: the frame becomes a coordinate picker, so a callout is
      // placed by tapping what it should point at rather than guessing numbers.
      // A tap stops the clip where it is, so the snippet carries the year on
      // screen; and the picture stops moving the deck on, since a tap on its
      // sides would otherwise turn the page instead of placing anything.
      const ghost = wrap.querySelector<HTMLElement>('.pin-ghost');
      const pickOut = page.querySelector<HTMLElement>('.pin-pick-out');
      if (pickOut && (flags.has('pin') || config)) {
        pickOut.hidden = false;
        pickOut.textContent = 'tap the picture to place a callout';

        // Copying, two ways. The clipboard API is only there in a secure
        // context, and a phone on the laptop's address over plain http is not
        // one -- so the old select-and-copy route is kept as the fallback.
        let lastSnippet = '';
        const copy = async (text: string) => {
          try {
            await navigator.clipboard.writeText(text);
            return true;
          } catch {
            const area = document.createElement('textarea');
            area.value = text;
            area.setAttribute('readonly', '');
            area.style.cssText = 'position:fixed;top:0;left:0;opacity:0;';
            document.body.appendChild(area);
            area.focus();
            area.setSelectionRange(0, text.length);
            const ok = document.execCommand('copy');
            area.remove();
            return ok;
          }
        };
        // Tapping the readout copies the last placement's whole block.
        let shown = '';
        pickOut.addEventListener('click', async () => {
          if (!lastSnippet) return;
          const ok = await copy(lastSnippet);
          pickOut.textContent = ok ? 'copied' : 'could not copy';
          setTimeout(() => (pickOut.textContent = shown), 900);
        });
        v.style.cursor = 'crosshair';
        wrap.setAttribute('data-no-tap', '');
        v.addEventListener('click', (ev) => {
          userPaused = true;
          clearResume();
          v.pause();
          const box = v.getBoundingClientRect();
          const r = paintedRect();
          const x = (ev.clientX - box.left - r.x) / r.w;
          const y = (ev.clientY - box.top - r.y) / r.h;
          if (x < 0 || x > 1 || y < 0 || y > 1) {
            pickOut.textContent = 'outside the picture';
            return;
          }
          // A ring where the tap landed, at the radius the snippet carries, so
          // the size is chosen by eye rather than by reloading to check it.
          if (ghost) {
            ghost.hidden = false;
            ghost.style.left = `${x * 100}%`;
            ghost.style.top = `${y * 100}%`;
            ghost.style.setProperty('--w', `${0.1 * r.w}px`);
            ghost.style.setProperty('--h', `${0.1 * r.w}px`);
          }
          const snippet =
            `- year: ${yearAt(v.currentTime)}\n` +
            `  x: ${x.toFixed(3)}\n` +
            `  y: ${y.toFixed(3)}\n` +
            `  markerType: circle\n` +
            `  sizeX: 0.1\n` +
            `  sizeY: 0.1\n` +
            `  place: below\n` +
            `  title: Untitled\n` +
            `  pause: 2\n` +
            `  hold: 3\n` +
            `  messageHold: 5\n` +
            `  body: `;
          // One line on screen, so it covers as little of the picture as the
          // ring does; the clipboard still gets the whole block.
          shown = `${yearAt(v.currentTime)}  x ${x.toFixed(3)}  y ${y.toFixed(3)}  · tap to copy`;
          pickOut.textContent = shown;
          lastSnippet = snippet;
          copy(snippet);
        });
      }

      // Arriving sets the clip back to the earliest year and plays it: each
      // page is a story, and a story runs as soon as it is on screen. Muted
      // inline video is allowed to start without a gesture.
      new IntersectionObserver(
        (e) => {
          inView = e[0].isIntersecting;
          if (!e[0].isIntersecting) {
            clearResume();
            stopStory();
            spotlight(null);
            honoured.clear();
            v.pause(); // which stops the frame clock with it
            userPaused = false;
            return;
          }
          v.currentTime = 0;
          honoured.clear();
          resetStory();
          showCallouts(0);
          startStory();
          // The next playthrough is the likely next thing on screen, so it
          // starts fetching now rather than when it is reached.
          const next = page.dataset.next ? document.querySelector(page.dataset.next) : null;
          const nextClip = next?.querySelector<HTMLVideoElement>('.ts-video');
          if (nextClip && nextClip.preload !== 'auto') nextClip.preload = 'auto';
          v.play().catch(() => {});
        },
        { threshold: 0.6 },
      ).observe(wrap);
    } else {
      // ---- Image sequence ------------------------------------------------
      // Every frame is already in the DOM, so a change is an opacity swap with
      // no decode stall. Runs through from the first year on arrival.
      const frames = Array.from(wrap.querySelectorAll<HTMLImageElement>('.ts-frame'));
      let current = 0;
      const show = (i: number) => {
        if (i === current) return;
        frames[current].style.opacity = '0';
        frames[i].style.opacity = '1';
        current = i;
        if (yearOut) yearOut.textContent = frames[i].dataset.year!;
      };

      let timer: number | null = null;
      const stop = () => {
        if (timer !== null) clearInterval(timer);
        timer = null;
      };
      const start = () => {
        stop();
        show(0);
        timer = window.setInterval(() => {
          if (current + 1 >= frames.length) return stop();
          show(current + 1);
        }, 620);
      };
      // Leaving the panel should not leave a timer running behind it.
      new IntersectionObserver((e) => (e[0].isIntersecting ? start() : stop()), { threshold: 0.6 }).observe(wrap);
    }
  }
  }
</script>
