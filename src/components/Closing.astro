---
import { asset, wallTiles } from '../lib/paths';
import AnimalButton from './AnimalButton.astro';

interface Props {
  prev?: string;
  /** The panel's own words, from the location file. */
  copy: { eyebrow: string; title: string; body: string; note: string; action: string; install: string };
  wall?: { dir: string; full?: string; ext: string; dates: string[] };
}
const { prev, copy, wall } = Astro.props;

// Three columns, dealt round-robin so neighbouring dates never end up stacked
// on top of each other. Each column repeats its own tiles once: the scroll is a
// translate of exactly half the strip, so the second copy is underneath the
// first at the moment it wraps and the seam never shows.
const COLUMNS = 3;
const tiles = wall ? wallTiles(wall) : [];
const columns = Array.from({ length: COLUMNS }, (_, c) => tiles.filter((_, i) => i % COLUMNS === c));
const stamp = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('en-CA', { year: 'numeric', month: 'short' });
// Noon, so a date never slides into the day before in a western timezone.
const longStamp = (iso: string) =>
  new Date(`${iso}T12:00:00`).toLocaleDateString('en-CA', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
// What the player runs through: every photograph, oldest first.
const playlist = [...tiles]
  .sort((a, b) => a.date.localeCompare(b.date))
  .map((t) => ({ src: asset(t.full), date: longStamp(t.date), short: stamp(t.date) }));
---
<section class="panel closing" id="onward" aria-label="Take this with you">
  <div class="panel-stage closing-stage">
    {tiles.length > 0 && (
      <div class="wall" aria-hidden="true">
        {columns.map((column, c) => (
          <div class={`wall-col wall-col-${c}`}>
            {[...column, ...column].map((tile) => (
              <figure class="wall-tile">
                <!-- Not lazy: the browser decides what is "near the viewport" from a
                     box that is being animated continuously, and gets it badly
                     wrong here -- one column loaded a single tile and drifted
                     the rest past as blanks. Low priority instead, so they
                     queue behind the panorama and the clip but do arrive. -->
                <img src={asset(tile.src)} alt="" fetchpriority="low" decoding="async" />
                <figcaption>{stamp(tile.date)}</figcaption>
              </figure>
            ))}
          </div>
        ))}
      </div>
    )}

    <!-- The opening page turned upside down: the photographs at full
         strength, and a dark fade from the top that the words sit in. -->
    <div class="closing-shade" aria-hidden="true"></div>

    <div class="closing-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
      <p>{copy.body}</p>
      <p class="closing-dim">{copy.note}</p>
      <div class="closing-actions">
        <!-- A button, not a link, purely so that it is the same kind of thing as
             the one beside it: a link and a button are measured by different
             rules -- the engine's, not this sheet's -- and two pills side by
             side at different heights is the one thing this row must not do.
             The address it goes to still lives in the markup. -->
        <button class="chip closing-more" id="closing-more" type="button" data-href={asset('/map/')}>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M12 21s7-5.6 7-11a7 7 0 10-14 0c0 5.4 7 11 7 11z" /><circle cx="12" cy="10" r="2.5" />
          </svg>
          {copy.action}
        </button>
        <!-- Hidden until the script has decided this device can be offered
             anything: already installed, and there is nothing to offer. -->
        <button class="chip closing-install" id="closing-install" type="button" hidden>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="4" y="4" width="16" height="16" rx="3.5" />
            <path d="M12 8.5v7M8.5 12h7" />
          </svg>
          {copy.install}
        </button>
      </div>
    </div>

    <!-- iOS never fires the install prompt: adding to the home screen is a
         thing the person does through the browser's own share sheet, so all
         this panel can do is say where it is. -->
    <div class="howto" id="howto" role="dialog" aria-modal="true" aria-labelledby="howto-title">
      <div class="howto-card">
        <h3 id="howto-title">Add this to your home screen</h3>
        <p class="howto-lede">Adding to your home screen makes this experience behave like an app.</p>
        <!-- Filled by the script: which button to look for, and what it is
             called, differ by browser -- and pointing at the wrong icon is
             worse than not pointing at all. -->
        <ol class="howto-steps" id="howto-steps"></ol>
        <!-- Only shown when the steps above are a guess rather than a match. -->
        <p class="howto-dim" id="howto-dim" hidden>
          If you cannot see it, look for <b>Install</b> or <b>Add to Home Screen</b> in your browser's menu.
        </p>
        <button class="chip howto-close" id="howto-close" type="button">Got it</button>
      </div>
    </div>

    <AnimalButton animal="raven" />

    <!-- The page's controls, in a column in the far corner as on every other
         page: the photographs, then back to the camera. Nothing onwards --
         this is the end, and the way back is an offer to add to it. -->
    <div class="closing-side" data-no-tap>
      <!-- Tall, with its name up the side: the one thing on this page that is
           not obvious from an icon alone. -->
      {tiles.length > 0 && (
        <button class="step wall-btn" id="wall-btn" type="button" aria-pressed="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="3" y="3" width="7.5" height="7.5" rx="1.5" />
            <rect x="13.5" y="3" width="7.5" height="7.5" rx="1.5" />
            <rect x="3" y="13.5" width="7.5" height="7.5" rx="1.5" />
            <rect x="13.5" y="13.5" width="7.5" height="7.5" rx="1.5" />
          </svg>
          <span class="wall-btn-label">Gallery</span>
        </button>
      )}
      <!-- Back to the start of this post, the view. -->
      <a class="step" href="#view" aria-label="Back to the start">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round" aria-hidden="true"><path d="M4 10.5L12 4l8 6.5V19a1 1 0 01-1 1h-4.5v-5.5h-5V20H5a1 1 0 01-1-1z" /></svg>
      </a>
      {prev && (
        <a class="step" href={prev} aria-label="Go back and add a photograph">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M3 8.5A2.5 2.5 0 015.5 6h2L9 4h6l1.5 2h2A2.5 2.5 0 0121 8.5v9A2.5 2.5 0 0118.5 20h-13A2.5 2.5 0 013 17.5z" />
            <circle cx="12" cy="13" r="3.4" />
          </svg>
        </a>
      )}
    </div>
  </div>

  <!-- Full screen and in date order: the wall behind the copy is a texture,
       this is the record itself, big enough to actually look at. Laid out as
       a page of its own -- title pill top left under the story bar, back in
       the corner where the arrows are -- and it takes every tap, so one on a
       photograph cannot turn the deck behind it. -->
  {tiles.length > 0 && (
    <div class="gallery" id="gallery" role="dialog" aria-modal="true" aria-label="Gallery" data-no-tap data-shots={JSON.stringify(playlist)}>
      <p class="gallery-title" id="gallery-title"><b>Gallery</b><span> · {tiles.length}</span></p>
      <!-- The photographs played back in order, oldest first: one view, over
           and over, so run together they are a timelapse of the place. -->
      <div class="player" id="player">
        <img class="player-img" alt="" aria-hidden="true" />
        <img class="player-img" alt="" aria-hidden="true" />
        <!-- The date of the photograph, directly under it. -->
        <p class="player-date" id="player-date" aria-live="polite"></p>
        <!-- Under that: one tick per photograph, dragged along to
             run through them by hand. -->
        <div class="scrub" id="scrub">
          <div
            class="scrub-bar"
            id="scrub-bar"
            role="slider"
            tabindex="0"
            aria-label="Photograph"
            aria-valuemin="1"
            aria-valuemax={playlist.length}
            aria-valuenow="1"
          >
            <span class="scrub-track" aria-hidden="true">
              <i class="scrub-fill"></i>
              {playlist.map((_, i) => (
                <span class="scrub-tick" style={`left:${playlist.length > 1 ? (i / (playlist.length - 1)) * 100 : 0}%`}></span>
              ))}
              <b class="scrub-knob"></b>
            </span>
          </div>
          <div class="scrub-ends" aria-hidden="true">
            <span>{playlist[0]?.short}</span><span>{playlist.at(-1)?.short}</span>
          </div>
        </div>
      </div>
      <AnimalButton animal="raven" />
      <div class="closing-side gallery-side">
        <button class="step gallery-play" id="gallery-play" type="button" aria-label="Play the photographs in order" aria-pressed="false">
          <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.2v13.6a.8.8 0 001.2.7l10.6-6.8a.8.8 0 000-1.4L9.2 4.5a.8.8 0 00-1.2.7z" /></svg>
          <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5" width="3.8" height="14" rx="1" /><rect x="13.7" y="5" width="3.8" height="14" rx="1" /></svg>
        </button>
        <button class="step gallery-close" id="gallery-close" type="button" aria-label="Back">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
      </div>
      <div class="gallery-scroll" id="gallery-scroll">
        {tiles.map((tile, i) => (
          <figure class="shot">
            <!-- The address waits in data-src until the gallery is first
                 opened: hidden by visibility, it is still laid out, and the
                 browser counted every photograph as near enough to fetch --
                 on page load, alongside the panorama. -->
            <img
              data-src={asset(tile.full)}
              alt={`This view on ${longStamp(tile.date)}`}
              loading={i < 2 ? 'eager' : 'lazy'}
              decoding="async"
            />
            <figcaption>{longStamp(tile.date)}</figcaption>
          </figure>
        ))}
        <p class="gallery-end">The next one could be yours.</p>
      </div>
    </div>
  )}
</section>

<style>
  /* No rail under this stage, so the arrow row clears the foot itself. */
  .closing { --nav-safe: var(--foot); }

  /* The words at the top, under the story bar, on the photographs. */
  .closing-stage {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: calc(var(--safe-t) + 3.4rem) 1.4rem 5.2rem;
  }

  /* ---- The wall ---------------------------------------------------------
     Photographs taken from this same post on other days, drifting upwards
     behind the words: the argument the copy is making, shown rather than
     stated. Columns run at different speeds because three strips in lockstep
     read as one sliding sheet. */
  .wall {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    gap: 0.5rem;
    padding: 0 0.5rem;
    overflow: hidden;
    /* Nearly full strength, as the view is on the opening page: the shade
       below does the holding back, and only where the words are. */
    opacity: 0.9;
  }
  /* The opening page's dim, run the other way: dark enough at the top to hold
     the words on its own, easing off through the middle so the photographs
     come through clear at the foot. */
  .closing-shade {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    /* The foot's fade is the deck's own, shared with every page. */
    background: linear-gradient(
      to bottom,
      rgb(13, 18, 16) 0%,
      rgba(6, 10, 9, 0.9) 44%,
      rgba(6, 10, 9, 0.6) 60%,
      rgba(6, 10, 9, 0.16) 78%,
      rgba(6, 10, 9, 0) 92%
    );
  }
  .wall-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    /* Starts above the top edge: at rest the first tile would otherwise sit on
       the seam rather than in the frame. */
    animation: wall-drift linear infinite;
    will-change: transform;
  }
  /* Same tile shape throughout -- these are one view photographed again and
     again, and varying the crops would invent a difference. What breaks the
     grid is the offset: each column starts part of a tile higher than the one
     beside it, so the rows never line up across the wall. */
  .wall-col-0 { animation-duration: 64s; margin-top: -2.4rem; }
  .wall-col-1 { animation-duration: 44s; margin-top: -5.1rem; }
  .wall-col-2 { animation-duration: 82s; margin-top: -0.9rem; }
  /* Exactly half the strip: the duplicate half has taken its place by then. */
  @keyframes wall-drift {
    from { transform: translateY(0); }
    to { transform: translateY(calc(-50% - 0.25rem)); }
  }

  /* The layout's blanket reduced-motion rule shortens every duration to
     0.01ms, which for an infinite animation means it loops flat out rather
     than stopping. Three columns of photographs is the wrong place to leave
     that running, so this one is switched off outright and the wall simply
     stands still. */
  @media (prefers-reduced-motion: reduce) {
    .wall-col { animation: none; }
  }

  /* The column in the corner: the same place, gap and buttons as the other
     pages', so they read as one design. */
  .closing-side {
    position: absolute;
    z-index: 4;
    right: 0.9rem;
    bottom: calc(1rem + var(--nav-safe, 0px));
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .closing-side .step svg { width: 20px; height: 20px; }
  /* A tall pill: the icon at the top, the word running up beneath it. */
  .closing-side .wall-btn {
    height: auto;
    padding: 0.8rem 0 0.9rem;
    border-radius: 23px;
    grid-auto-flow: row;
    gap: 0.55rem;
    justify-items: center;
  }
  .wall-btn-label {
    writing-mode: vertical-rl;
    /* Read bottom to top, the way a spine is. */
    transform: rotate(180deg);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Fixed rather than absolute: the panel clips its overflow and the deck
     scrolls sideways, so the only way to be genuinely full screen is to leave
     both behind. Under the story bar and its shade, which are later in the
     page at the same level: it is a page of the story while it is open. */
  .gallery {
    position: fixed;
    inset: 0;
    z-index: 5;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    /* Closed, and faded rather than switched: this covers the whole screen,
       and appearing in one frame reads as the page having changed underneath
       you rather than something having opened on top of it.
       Visibility rather than display, because it is what can be transitioned
       while still taking the panel out of the tab order and away from a screen
       reader -- and it steps to visible at the start of the fade in and holds
       until the end of the fade out, which is exactly the timing wanted. */
    opacity: 0;
    visibility: hidden;
    transform: scale(1.012);
    /* Visibility is switched, never interpolated: given a duration, its
       computed value stays `hidden` for the length of the fade in, which leaves
       the panel unfocusable exactly while it is arriving -- so the close button
       cannot be focused and a keyboard is left behind the overlay. Instead it
       flips at once on the way in (0s, below) and is held back to the end of
       the fade on the way out by a delay, so nothing vanishes mid-fade. */
    transition: opacity 0.26s ease, transform 0.26s ease, visibility 0s linear 0.26s;
  }
  .gallery.on {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity 0.26s ease, transform 0.26s ease, visibility 0s;
  }
  /* The same pill as a time series page's title, in the same place. */
  .gallery-title {
    position: absolute;
    z-index: 2;
    top: calc(var(--safe-t) + 1.9rem);
    left: 0.9rem;
    margin: 0;
    padding: 0.28em 0.75em;
    border-radius: 999px;
    background: rgba(13, 18, 16, 0.66);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.9rem;
    line-height: 1.2;
  }
  .gallery-title b { font-weight: 600; }
  .gallery-title span { color: var(--ink-dim); font-variant-numeric: tabular-nums; }
  /* ---- The player ---------------------------------------------------------
     Over the list, the whole screen, each photograph whole rather than
     cropped: they are the same view, and cropping them differently from the
     list would make the timelapse jump. Two images, crossfaded. */
  .player {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--bg);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0s linear 0.3s;
  }
  .gallery[data-playing] .player {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease, visibility 0s;
  }
  /* Full width and centred, at its own shape, edge to edge with no
     feathering: the photograph is the record, so all of it shows. */
  .player-img {
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    transform: translateY(-50%);
    opacity: 0;
    transition: opacity 0.55s ease;
  }
  /* The incoming photograph fades in over the outgoing one, which stays
     fully in underneath: fading both at once would let the page show
     through halfway, a dip to dark between every pair. */
  .player-img.top { z-index: 1; }
  .player-img.under { transition: none; }
  /* Just under the photograph, whatever its shape: --ph is its drawn height,
     set by the script once it has loaded. */
  .scrub {
    position: absolute;
    z-index: 2;
    left: 1.4rem;
    right: 1.4rem;
    /* Under the date, which is under the photograph. */
    top: calc(50% + var(--ph, 75vw) / 2 + 3.4rem);
  }
  .scrub-bar {
    padding: 0.7rem 0;
    /* A drag along it is the scrubber's, not a swipe of anything else. */
    touch-action: none;
    cursor: pointer;
    outline: none;
  }
  .scrub-track {
    position: relative;
    display: block;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.18);
  }
  .scrub-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: var(--pos, 0%);
    border-radius: 2px;
    background: var(--accent);
  }
  .scrub-tick {
    position: absolute;
    top: 50%;
    width: 2px;
    height: 8px;
    margin: -4px 0 0 -1px;
    border-radius: 1px;
    background: rgba(255, 255, 255, 0.28);
  }
  .scrub-knob {
    position: absolute;
    top: 50%;
    left: var(--pos, 0%);
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
  }
  .scrub-bar:focus-visible .scrub-knob { box-shadow: 0 0 0 3px var(--accent); }
  .scrub-ends {
    display: flex;
    justify-content: space-between;
    font-size: 0.7rem;
    color: var(--ink-dim);
    font-variant-numeric: tabular-nums;
  }
  /* Dragging runs through them faster than a crossfade can keep up with. */
  .gallery[data-scrubbing] .player-img { transition-duration: 0.12s; }

  /* The foot's fade is for the list scrolling under it; the slideshow has
     its own dark bands and no edge to hide. */
  .gallery[data-playing]::after { display: none; }
  /* The title's pill, centred just under the photograph. A fixed width, wide
     enough for the longest date and count, so it does not change size -- and
     jostle -- as the photographs go by. */
  .player-date {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: calc(50% + var(--ph, 75vw) / 2 + 0.9rem);
    width: 15.5rem;
    margin: 0 0 0 -7.75rem;
    padding: 0.28em 0.75em;
    border-radius: 999px;
    background: rgba(13, 18, 16, 0.66);
    border: 1px solid rgba(255, 255, 255, 0.14);
    font-size: 0.9rem;
    line-height: 1.2;
    text-align: center;
    white-space: nowrap;
  }
  /* Written by the script, so it carries no scope of its own. */
  .player-date :global(span) {
    margin-left: 0.5em;
    color: var(--ink-dim);
    font-variant-numeric: tabular-nums;
  }
  .gallery-play .icon-pause,
  .gallery-play[aria-pressed='true'] .icon-play { display: none; }
  .gallery-play[aria-pressed='true'] .icon-pause { display: block; }
  .gallery-play[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); }

  /* Fixed to the screen, not the panel: the gallery has left the panel. */
  .gallery-side { z-index: 2; bottom: calc(1rem + var(--foot)); }
  /* The gallery sits over the deck's own fade at the foot, so it carries its
     own, under its close button. */
  .gallery::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(var(--foot) + 8rem);
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to top,
      rgb(13, 18, 16) 0,
      rgba(13, 18, 16, 0.6) calc(var(--foot) + 1.8rem),
      rgba(13, 18, 16, 0.22) calc(var(--foot) + 4.4rem),
      rgba(13, 18, 16, 0) 100%
    );
  }

  .gallery-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    /* Its own scroll, with nothing handed back to the deck behind it. */
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    /* Clear of the pill at the top and the button at the foot at either end
       of the scroll, and under both in between. */
    padding: calc(var(--safe-t) + 4.4rem) 1.15rem calc(5rem + var(--foot));
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .shot { margin: 0; }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    background: var(--bg-lift);
    /* The shape the aligned set was exported at, so none of it is cropped. */
    aspect-ratio: 6081 / 3969;
    object-fit: cover;
  }
  .shot figcaption {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: var(--ink-dim);
    font-variant-numeric: tabular-nums;
  }
  .gallery-end {
    margin: 0.4rem 0 0;
    text-align: center;
    font-size: 0.85rem;
    color: var(--ink-dim);
  }

  .wall-tile { position: relative; margin: 0; flex: none; }
  .wall-tile img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }
  .wall-tile figcaption {
    position: absolute;
    left: 0.3rem;
    bottom: 0.3rem;
    padding: 0.15em 0.45em;
    border-radius: 5px;
    background: rgba(6, 10, 9, 0.66);
    font-size: 0.56rem;
    letter-spacing: 0.04em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  /* Two ways onwards, the same size as each other: neither is the lesser
     offer. Stacked on a phone, where side by side would squeeze both labels
     onto two lines, and side by side once there is width for it. */
  .closing-actions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }
  /* A stated height, not an inherited one. These two are a link and a button,
     and how tall each comes out from its padding and line box is decided partly
     by the engine -- Safari measures a button by its own rules. Two pills side
     by side at slightly different heights is the kind of thing that cannot be
     unseen, so the height is taken out of the browser's hands. 44px is also a
     proper target for a thumb. */
  .closing-actions > * {
    justify-content: center;
    min-height: 44px;
    padding-top: 0;
    padding-bottom: 0;
  }
  @media (min-width: 26rem) {
    .closing-actions { flex-direction: row; }
    .closing-actions > * { flex: 1 1 0; }
  }

  /* The how-to, for browsers that cannot be prompted. Same fade and the same
     visibility timing as the gallery: switched on the way in so it can take
     focus at once, held to the end of the fade on the way out. */
  .howto {
    position: fixed;
    inset: 0;
    z-index: 11;
    display: grid;
    place-items: center;
    padding: 1.2rem;
    background: rgba(6, 10, 9, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.26s ease, visibility 0s linear 0.26s;
  }
  .howto.on {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.26s ease, visibility 0s;
  }
  .howto-card {
    width: min(23rem, 100%);
    padding: 1.3rem 1.3rem 1.1rem;
    border-radius: 18px;
    background: var(--bg-lift);
    border: 1px solid var(--line);
  }
  .howto-card h3 { font-size: 1.02rem; margin-bottom: 0.3rem; }
  /* Why anyone would bother, before the steps for doing it. */
  .howto-lede {
    margin: 0 0 1rem;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--ink-dim);
  }
  .howto-steps {
    list-style: none;
    margin: 0 0 0.9rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  /* The steps are written by the script, so they carry no scope of their own --
     hence :global, anchored to the list, which does. Without it these rules
     match nothing and the icons come out the size of the card. */
  .howto-steps :global(li) {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.86rem;
    line-height: 1.45;
  }
  /* One flex item, not one per word: a flex container makes an item of every
     text node, so an emphasised word in the middle of a sentence gets its own
     line and the sentence comes apart. */
  .howto-steps :global(li > span:last-child) { flex: 1; min-width: 0; }
  .howto-steps :global(b) { font-weight: 600; }
  /* The glyph is the thing being looked for, so it is shown at about the size
     it appears in the browser's own bar rather than as a bullet. */
  .howto-steps :global(.howto-icon) {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.07);
    color: var(--accent);
  }
  .howto-steps :global(.howto-icon svg) { width: 19px; height: 19px; }
  .howto-dim {
    margin: 0 0 1rem;
    font-size: 0.76rem;
    line-height: 1.45;
    color: var(--ink-dim);
  }
  .howto-close { width: 100%; justify-content: center; }

  /* Straight on the shade, no card, set as the opening page's words are. */
  .closing-copy {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 30rem;
  }
  .closing-copy h2 { font-size: clamp(2.1rem, 8.5vw, 3rem); line-height: 1.08; margin: 0.4rem 0 0.8rem; }
  .closing-copy p { margin: 0 0 1rem; font-size: 1.02rem; line-height: 1.55; }
  .closing-dim { color: var(--ink-dim); font-size: 0.9rem; }
  /* No margin of its own: it used to be the only thing under the paragraph and
     wanted a little air, but it now shares a row that carries the spacing --
     and a margin on one of two pills is what makes them look different heights.
  */

  @media (orientation: landscape) and (max-height: 520px) {
    .closing-stage { align-items: flex-start; overflow-y: auto; }
    .closing-copy h2 { font-size: 1.4rem; }
    .closing-copy p { font-size: 0.9rem; margin-bottom: 0.7rem; }
  }
</style>

<script>
  const btn = document.getElementById('wall-btn') as HTMLButtonElement | null;
  const gallery = document.getElementById('gallery');
  const scroll = document.getElementById('gallery-scroll');
  const close = document.getElementById('gallery-close');

  if (btn && gallery && scroll && close) {
    const isOpen = () => gallery.classList.contains('on');

    const open = () => {
      gallery.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
        img.src = img.dataset.src!;
        img.removeAttribute('data-src');
      });
      // Always from the beginning: it is a sequence, and dropping someone
      // wherever they last left off loses the point of it being in order. Set
      // before it is shown, so the jump to the top is never seen.
      scroll.scrollTop = 0;
      gallery.classList.add('on');
      btn.setAttribute('aria-pressed', 'true');
      // Focus cannot land on something the browser still considers hidden, and
      // the class alone does not settle that until styles are recalculated --
      // so this reads a layout property to force that, then focuses. Waiting a
      // frame instead is not enough: the callback can run before the recalc.
      void gallery.offsetWidth;
      close.focus();
    };
    // ---- The player ------------------------------------------------------
    // Runs through the photographs oldest to newest, each held for a moment
    // and crossfaded into the next. Stops on the newest; play again starts
    // from the oldest. Paused by the same button.
    const shots: { src: string; date: string; short: string }[] = JSON.parse(gallery.dataset.shots ?? '[]');
    const player = document.getElementById('player')!;
    const scrubBar = document.getElementById('scrub-bar');
    const playBtn = document.getElementById('gallery-play') as HTMLButtonElement | null;
    const imgs = Array.from(gallery.querySelectorAll<HTMLImageElement>('.player-img'));
    const dateOut = document.getElementById('player-date')!;
    const HOLD = 1400; // ms on each photograph, from when it is fully in
    let at = -1; // which photograph is showing
    let front = 0; // which of the two images it is in
    let playing = false;
    let run = 0; // bumped on every start and stop, so a stale step bows out
    let timer: number | undefined;
    const active = () => gallery.hasAttribute('data-playing');

    const setPlaying = (on: boolean) => {
      playing = on;
      playBtn?.setAttribute('aria-pressed', String(on));
      playBtn?.setAttribute('aria-label', on ? 'Pause' : 'Play the photographs in order');
    };
    // Loaded and decoded before it is faded in, so a slow photograph holds the
    // last one rather than fading to nothing.
    const show = async (i: number, mine: number) => {
      const back = imgs[1 - front];
      back.src = shots[i].src;
      try { await back.decode(); } catch {}
      if (mine !== run) return false;
      const was = imgs[front];
      // The old one drops under without a fade of its own; the new one fades
      // in on top, and only once it is fully in is the old one let go.
      was.classList.remove('top');
      back.classList.remove('under');
      back.classList.add('top');
      back.style.opacity = '1';
      window.setTimeout(() => {
        if (was !== back && !was.classList.contains('top')) {
          was.classList.add('under');
          was.style.opacity = '0';
        }
      }, 600);
      front = 1 - front;
      at = i;
      // The scrubber follows, and sits just under the photograph's drawn
      // height -- which is its width times its shape, whatever that is.
      const pc = shots.length > 1 ? (i / (shots.length - 1)) * 100 : 0;
      scrubBar?.style.setProperty('--pos', `${pc}%`);
      scrubBar?.setAttribute('aria-valuenow', String(i + 1));
      scrubBar?.setAttribute('aria-valuetext', shots[i].date);
      placeScrub(back);
      dateOut.innerHTML = `${shots[i].date}<span>${i + 1} / ${shots.length}</span>`;
      // The next one fetched while this one is looked at.
      if (shots[i + 1]) new Image().src = shots[i + 1].src;
      return true;
    };
    const placeScrub = (img: HTMLImageElement) => {
      if (!img.naturalWidth) return;
      const h = Math.min(player.clientHeight, (player.clientWidth * img.naturalHeight) / img.naturalWidth);
      player.style.setProperty('--ph', `${h}px`);
    };
    addEventListener('resize', () => placeScrub(imgs[front]), { passive: true });
    const step = async (mine: number) => {
      if (mine !== run || !playing) return;
      if (at + 1 >= shots.length) { setPlaying(false); return; }
      if (!(await show(at + 1, mine))) return;
      timer = window.setTimeout(() => step(mine), HOLD);
    };
    const play = () => {
      clearTimeout(timer);
      const mine = ++run;
      // From the top when it is not already up, or has run to the end.
      if (!active() || at >= shots.length - 1) {
        at = -1;
        for (const img of imgs) { img.classList.remove('top'); img.classList.add('under'); img.style.opacity = '0'; }
        gallery.setAttribute('data-playing', '');
      }
      setPlaying(true);
      step(mine);
    };
    const pause = () => {
      run++;
      clearTimeout(timer);
      setPlaying(false);
    };
    const stopPlayer = () => {
      pause();
      gallery.removeAttribute('data-playing');
      at = -1;
    };
    playBtn?.addEventListener('click', () => (playing ? pause() : play()));

    // ---- The scrubber ----------------------------------------------------
    // Takes over from the player: a touch pauses it, and dragging shows the
    // photograph under the finger. Play carries on from wherever it is left.
    if (scrubBar) {
      const track = scrubBar.querySelector<HTMLElement>('.scrub-track')!;
      let dragging = false;
      const indexAt = (x: number) => {
        const r = track.getBoundingClientRect();
        const f = Math.min(1, Math.max(0, (x - r.left) / r.width));
        return Math.round(f * (shots.length - 1));
      };
      const goTo = (i: number) => {
        if (i === at) return;
        show(i, ++run);
      };
      scrubBar.addEventListener('pointerdown', (e) => {
        dragging = true;
        pause();
        gallery.setAttribute('data-scrubbing', '');
        scrubBar.setPointerCapture(e.pointerId);
        goTo(indexAt(e.clientX));
      });
      scrubBar.addEventListener('pointermove', (e) => {
        if (dragging) goTo(indexAt(e.clientX));
      });
      const letGo = () => {
        dragging = false;
        gallery.removeAttribute('data-scrubbing');
      };
      scrubBar.addEventListener('pointerup', letGo);
      scrubBar.addEventListener('pointercancel', letGo);
      scrubBar.addEventListener('keydown', (e) => {
        const to = { ArrowRight: at + 1, ArrowUp: at + 1, ArrowLeft: at - 1, ArrowDown: at - 1, Home: 0, End: shots.length - 1 }[e.key];
        if (to === undefined) return;
        e.preventDefault();
        pause();
        goTo(Math.min(shots.length - 1, Math.max(0, to)));
      });
    }

    const shut = (refocus = true) => {
      stopPlayer();
      gallery.classList.remove('on');
      btn.setAttribute('aria-pressed', 'false');
      if (refocus) btn.focus();
    };
    // The story bar stays over the gallery and still moves the deck, so going
    // to another page by it closes the gallery rather than leaving it laid
    // over that page.
    const panel = document.getElementById('onward');
    if (panel) {
      new IntersectionObserver((e) => {
        if (!e[0].isIntersecting && isOpen()) shut(false);
      }, { threshold: 0.4 }).observe(panel);
    }

    btn.addEventListener('click', open);
    // Back steps out of the player first, then out of the gallery.
    const back = () => (active() ? stopPlayer() : shut());
    close.addEventListener('click', back);
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) back();
    });
  }

  // The map of the corridor, reached by hand now that this is a button.
  const more = document.getElementById('closing-more') as HTMLButtonElement | null;
  more?.addEventListener('click', () => {
    const to = more.dataset.href;
    if (to) location.href = to;
  });

  // ---- Add to home screen ------------------------------------------------
  // Two devices, two entirely different gestures. Android hands the page an
  // event it can hold and fire on a tap, which is a one-press install. iOS
  // never fires it: adding to the home screen is done through Safari's own
  // share sheet, and a page is not allowed to open that -- so all this can do
  // is say where it is and what it is called.
  const install = document.getElementById('closing-install') as HTMLButtonElement | null;
  const howto = document.getElementById('howto');
  const howtoClose = document.getElementById('howto-close');

  if (install && howto && howtoClose) {
    // Already installed: there is nothing to offer, and the button would be a
    // dead end rather than an invitation.
    const installed =
      matchMedia('(display-mode: standalone)').matches ||
      (navigator as any).standalone === true;
    install.hidden = installed;

    // ---- Which browser, and therefore which button ------------------------
    // Sniffing is usually the wrong answer, but here the question really is
    // "what does the button look like on the thing in your hand": a share
    // glyph, three dots across, three dots down. There is no capability to
    // test for, and pointing at the wrong icon is worse than pointing at none.
    const ua = navigator.userAgent;
    const iOS =
      /iPad|iPhone|iPod/.test(ua) ||
      // iPadOS calls itself a Mac, and is only told apart by having a screen
      // you can touch.
      (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
    // Every browser on iOS is Safari underneath, but they wear their own menus,
    // and the route to the same iOS share sheet differs in each.
    const iOSChrome = iOS && /CriOS/.test(ua);
    const iOSBurger = iOS && /EdgiOS|FxiOS|OPiOS/.test(ua);
    const android = /Android/.test(ua);

    const STROKE = (d: string) =>
      `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">${d}</svg>`;
    const FILLED = (d: string) => `<svg viewBox="0 0 24 24" fill="currentColor">${d}</svg>`;
    const GLYPH = {
      share: STROKE('<path d="M12 15V4m0 0L8.5 7.5M12 4l3.5 3.5"/><path d="M6 12.5V19a1.5 1.5 0 001.5 1.5h9A1.5 1.5 0 0018 19v-6.5"/>'),
      dotsAcross: FILLED('<circle cx="5.5" cy="12" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="18.5" cy="12" r="1.7"/>'),
      burger: STROKE('<path d="M4 7h16M4 12h16M4 17h16"/>'),
      dotsDown: FILLED('<circle cx="12" cy="5.5" r="1.7"/><circle cx="12" cy="12" r="1.7"/><circle cx="12" cy="18.5" r="1.7"/>'),
      scroll: STROKE('<path d="M12 4v13m0 0l-4-4m4 4l4-4"/>'),
      add: STROKE('<rect x="4" y="4" width="16" height="16" rx="3.5"/><path d="M12 8.5v7M8.5 12h7"/>'),
      window: STROKE('<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 9h18"/>'),
    };

    // The last step is the same wherever you started: the iOS share sheet, with
    // the one entry a long way down it.
    const SCROLL_AND_ADD: [string, string] = [
      GLYPH.add,
      'Scroll down and choose <b>Add to Home Screen</b>.',
    ];
    const steps: Array<[string, string]> = iOSChrome
      ? [
          [GLYPH.share, 'Tap the <b>share</b> icon next to the address bar.'],
          [GLYPH.dotsAcross, 'Tap <b>More</b>, the three dots.'],
          SCROLL_AND_ADD,
        ]
      : iOSBurger
        ? [
            [GLYPH.burger, "Tap the <b>menu</b> in your browser's bar."],
            [GLYPH.share, 'Choose <b>Share</b>.'],
            SCROLL_AND_ADD,
          ]
        : iOS
          ? [
              // Safari's own route, as of the current iOS: the share sheet is
              // behind the More button rather than in the toolbar itself.
              [GLYPH.dotsAcross, 'Tap the <b>three dots</b> in the bar at the bottom of the screen.'],
              [GLYPH.share, 'Choose <b>Share</b>.'],
              SCROLL_AND_ADD,
            ]
          : android
            ? [
                [GLYPH.dotsDown, 'Tap the <b>three dots</b>, top right.'],
                [GLYPH.add, 'Choose <b>Install</b> or <b>Add to Home screen</b>.'],
              ]
            : [
                [GLYPH.window, 'Look for the <b>install</b> icon at the end of the address bar.'],
                [GLYPH.add, 'Or open the browser menu and choose <b>Install</b>.'],
              ];

    const list = document.getElementById('howto-steps')!;
    list.innerHTML = steps
      .map(([icon, text]) => `<li><span class="howto-icon" aria-hidden="true">${icon}</span><span>${text}</span></li>`)
      .join('');
    // The fallback line is for the case where the steps above are a guess: on a
    // desktop the menus vary far more than they do on a phone.
    const dim = document.getElementById('howto-dim');
    if (dim && !iOS && !android) dim.hidden = false;

    const showHowto = () => {
      howto.classList.add('on');
      // The class alone does not settle visibility until styles recalculate,
      // and focus cannot land on something still considered hidden.
      void howto.offsetWidth;
      (howtoClose as HTMLButtonElement).focus();
    };
    const hideHowto = () => {
      howto.classList.remove('on');
      install.focus();
    };

    install.addEventListener('click', async () => {
      const prompt = (window as any).__installPrompt;
      if (prompt) {
        prompt.prompt();
        try {
          const { outcome } = await prompt.userChoice;
          // It is spent either way -- the browser will not let the same one be
          // shown twice -- so it is dropped, and the button goes if they took
          // it and stays if they did not.
          (window as any).__installPrompt = null;
          if (outcome === 'accepted') install.hidden = true;
        } catch {
          (window as any).__installPrompt = null;
        }
        return;
      }
      showHowto();
    });

    howtoClose.addEventListener('click', hideHowto);
    howto.addEventListener('click', (e) => {
      // The backdrop, not the card.
      if (e.target === howto) hideHowto();
    });
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && howto.classList.contains('on')) hideHowto();
    });
    addEventListener('ecoscapes:installed', () => {
      install.hidden = true;
      hideHowto();
    });
  }
</script>
