---
import AnimalButton from './AnimalButton.astro';

interface Props {
  prompt: string;
  shareTo: string;
  title: string;
  prev?: string;
  next?: string;
}
const { prompt, shareTo, title, prev, next } = Astro.props;
---
<section class="panel" id="add" aria-label="Add your photograph" data-share-to={shareTo} data-title={title} data-next={next}>
  <div class="panel-stage cap-stage">
    <div class="cap-empty" id="cap-empty">
      <!-- What to do, drawn rather than described: the phone goes into the
           holder on the post, and then it takes the picture. The holder is the
           whole point of the post -- it is what makes every photograph from
           here line up with every other one. -->
      <svg class="cap-guide" viewBox="0 0 200 170" aria-hidden="true">
        <path class="g-ground" d="M44 150H156" />
        <path class="g-post" d="M100 150V82" />
        <!-- Held on its long edge, the way the view is framed, and resting on
             the holder's arms rather than sitting on its floor. -->
        <g class="g-phone">
          <rect x="76" y="52" width="48" height="24" rx="4" />
          <circle class="g-lens" cx="86" cy="64" r="2.8" />
          <circle class="g-flash" cx="86" cy="64" r="2.8" />
        </g>
        <!-- Drawn after the phone so its arms close over it. -->
        <path class="g-cradle" d="M70 60v16a6 6 0 006 6h48a6 6 0 006-6V60" />
      </svg>
      <div class="cap-copy">
        <p class="eyebrow">Add to the record</p>
        <h2>Take the shot</h2>
        <p class="cap-prompt">{prompt}</p>
      </div>
      <!-- The whole camera integration, for now: the OS camera, no permissions
           plumbing, works on iOS and Android. A label for the hidden input, so
           the button is the input as far as the phone is concerned. Big and in
           the middle, a shutter: it is the one thing this page asks for. -->
      <label class="cap-go" id="cap-go" for="cap-input" aria-label="Open the camera">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M3 8.5A2.5 2.5 0 015.5 6h2L9 4h6l1.5 2h2A2.5 2.5 0 0121 8.5v9A2.5 2.5 0 0118.5 20h-13A2.5 2.5 0 013 17.5z" />
          <circle cx="12" cy="13" r="3.4" />
        </svg>
      </label>
      {next && <p class="cap-skip-note">Not today? The arrow carries on without one.</p>}
      <input type="file" id="cap-input" accept="image/*" capture="environment" hidden />
    </div>

    <div class="cap-result" id="cap-result" hidden>
      <img id="cap-preview" alt="The photograph you just took" />
      <!-- Sending, over the photograph being sent. Nothing leaves the phone
           yet; see the script. -->
      <div class="cap-upload" id="cap-upload" hidden>
        <div class="cap-upload-card">
          <svg class="cap-tick" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
            <path d="M5 13l4.5 4.5L19 8" />
          </svg>
          <p class="cap-upload-said" id="cap-upload-said">Sending…</p>
          <div class="cap-bar"><i id="cap-bar-fill"></i></div>
        </div>
      </div>
    </div>

    <!-- What to do with a photograph before sending it, along the foot beside
         the column once there is one: neither is the greater offer, and the
         caption is only ever an offer -- the arrow sends with or without it. -->
    <div class="cap-actions" id="cap-actions" data-no-tap hidden>
      <button class="chip cap-retake" id="cap-retake" type="button">Retake</button>
      <button class="chip cap-caption" id="cap-caption" type="button">Add caption</button>
    </div>

    <AnimalButton animal="raven" />

    <!-- The page's controls, in a column in the far corner as on the time
         series: back, then on. The bottom one is whichever the page is asking
         for -- carry on without a photograph, or send the one taken. -->
    <div class="cap-side" data-no-tap>
      {prev && (
        <a class="step" href={prev} aria-label="Previous section">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </a>
      )}
      {next && (
        <a class="step" id="cap-skip" href={next} aria-label="Carry on without a photograph">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </a>
      )}
      <button class="step cap-send" id="cap-send" type="button" aria-label={`Send your photograph to ${shareTo}`} hidden>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <path d="M12 19V5m0 0l-6 6m6-6l6 6" />
        </svg>
      </button>
    </div>

    <!-- Asked for once the photograph is taken and the send button tapped: a
         line about the place, in your words, travelling with the picture. The
         prompt rotates so it reads as an invitation rather than a form field,
         and stops the moment it is being answered. -->
    <div class="cap-sheet" id="cap-sheet" hidden>
      <label class="sr-only" for="cap-note">Say something about this place</label>
      <textarea id="cap-note" rows="2" maxlength="280" placeholder="What did you see?"></textarea>
      <div class="cap-sheet-row">
        <button class="chip" id="cap-cancel" type="button">Cancel</button>
        <button class="chip cap-primary" id="cap-confirm" type="button">Done</button>
      </div>
    </div>
  </div>
</section>

<style>
  .cap-stage { display: grid; place-items: center; padding: 1.4rem 1.4rem calc(4.6rem + var(--foot)); }
  /* No rail under this stage, so the arrow row clears the foot itself. */
  #add { --nav-safe: var(--foot); }
  .cap-empty {
    display: flex; flex-direction: column; align-items: center; gap: 1.15rem;
    text-align: center; max-width: 24rem;
  }
  .cap-guide {
    width: min(58vw, 12.5rem); height: auto; fill: none;
    stroke: var(--line); stroke-width: 2; stroke-linecap: round;
  }
  .g-phone rect { stroke: var(--ink-dim); }
  .g-cradle, .g-lens { stroke: var(--accent); }
  .g-flash { stroke: var(--accent); }

  /* The post and its holder draw themselves in once, on arrival. */
  .g-ground, .g-post, .g-cradle {
    stroke-dasharray: 130;
    stroke-dashoffset: 130;
    animation: cap-draw 0.9s ease-out forwards;
  }
  .g-post { animation-delay: 0.15s; }
  .g-cradle { animation-delay: 0.4s; }
  @keyframes cap-draw { to { stroke-dashoffset: 0; } }

  /* Then the phone goes in, and the shutter goes off, over and over: this is
     the instruction, so it repeats rather than playing once and stopping. */
  .g-phone {
    transform-box: view-box;
    animation: cap-place 4.6s ease-in-out 0.9s infinite;
  }
  @keyframes cap-place {
    0%, 8% { transform: translateY(-26px); opacity: 0; }
    30%, 100% { transform: translateY(0); opacity: 1; }
  }
  .g-flash {
    transform-box: view-box;
    transform-origin: 86px 64px;
    opacity: 0;
    animation: cap-flash 4.6s ease-out 0.9s infinite;
  }
  @keyframes cap-flash {
    0%, 46% { opacity: 0; transform: scale(1); }
    56% { opacity: 0.85; transform: scale(2.6); }
    72%, 100% { opacity: 0; transform: scale(4.2); }
  }
  .cap-copy h2 { font-size: 1.55rem; margin: 0.3rem 0 0.5rem; }
  .cap-prompt { margin: 0; font-size: 0.9rem; color: var(--ink-dim); line-height: 1.5; }
  /* The shutter: a ring round a filled disc, in the accent, like the button
     on a camera -- read as "take a picture" before the icon is. */
  .cap-go {
    width: 76px;
    height: 76px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: #08110c;
    box-shadow: 0 0 0 4px var(--bg), 0 0 0 6px rgba(127, 209, 166, 0.55);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.15s ease, box-shadow 0.2s ease;
  }
  .cap-go svg { width: 32px; height: 32px; }
  .cap-go:hover { box-shadow: 0 0 0 4px var(--bg), 0 0 0 6px var(--accent); }
  .cap-go:active { transform: scale(0.94); }
  .cap-skip-note { margin: -0.2rem 0 0; font-size: 0.78rem; color: var(--ink-dim); }

  /* The column in the corner: the same place, gap and buttons as the time
     series', so the pages read as one design. */
  .cap-side {
    position: absolute;
    z-index: 4;
    right: 0.9rem;
    bottom: calc(1rem + var(--nav-safe, 0px));
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .cap-side .step svg { width: 20px; height: 20px; }

  .cap-result { position: absolute; inset: 0; }
  #cap-preview { width: 100%; height: 100%; object-fit: cover; }

  /* The send, made visible. It covers the photograph rather than sitting beside
     it: the picture is the thing going away, and watching it go is the whole
     point of a progress bar that has nothing real to report. */
  .cap-upload {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    background: rgba(6, 10, 9, 0.55);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .cap-upload-card {
    width: min(17rem, 78%);
    padding: 1.1rem 1.2rem;
    border-radius: 16px;
    background: rgba(13, 18, 16, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.14);
    text-align: center;
  }
  .cap-upload-said { margin: 0; font-size: 0.85rem; font-weight: 500; }
  /* Arrives at the end, and takes the bar's place rather than joining it. */
  .cap-tick {
    width: 30px;
    height: 30px;
    margin-bottom: 0.35rem;
    color: var(--accent);
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.2, 1.4, 0.4, 1);
  }
  .cap-upload[data-done] .cap-tick { opacity: 1; transform: none; }
  .cap-upload[data-done] .cap-bar { opacity: 0; }
  .cap-bar {
    height: 3px;
    margin-top: 0.8rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.16);
    overflow: hidden;
    transition: opacity 0.3s ease;
  }
  .cap-bar i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 3px;
    background: var(--accent);
  }

  /* One long pill along the foot, level with the bottom button of the column
     and stopping short of it. */
  .cap-actions {
    position: absolute;
    z-index: 4;
    /* Between the Raven's pill in the near corner and the column in the far. */
    left: calc(0.9rem + 46px + 0.6rem);
    right: calc(0.9rem + 46px + 0.6rem);
    bottom: calc(1rem + var(--nav-safe, 0px));
    height: 46px;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: rgba(13, 18, 16, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .cap-actions[hidden] { display: none; }
  /* Inside the pill, so no backing of their own. Half the row each, so the
     pair reads as one control rather than as a button with an afterthought. */
  .cap-actions .chip {
    flex: 1 1 0;
    min-width: 0;
    justify-content: center;
    padding: 0.5em 0.4em;
    background: none;
    border-color: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .cap-actions .chip:hover:not(:disabled) { border-color: transparent; color: var(--accent); }
  /* Throwing the photograph away, which is the one thing here you cannot undo. */
  .cap-retake { color: var(--danger); }
  .cap-actions .cap-retake:hover:not(:disabled) { color: var(--danger); }
  .cap-primary { color: var(--accent); font-weight: 600; }
  .cap-send { color: var(--accent); border-color: rgba(127, 209, 166, 0.55); }
  .cap-side [hidden] { display: none; }

  .cap-sheet {
    position: absolute;
    z-index: 5;
    left: 0.9rem;
    right: 0.9rem;
    bottom: calc(4.4rem + var(--nav-safe, 0px));
    padding: 0.8rem;
    border-radius: 16px;
    background: rgba(8, 13, 11, 0.86);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    /* Driven from the visual viewport when the keyboard opens. */
    transition: transform 0.22s ease-out;
  }
  #cap-note {
    width: 100%;
    resize: none;
    font: inherit;
    /* 16px exactly, and never in rem: iOS zooms the page in on focusing any
       field whose text is smaller than this, and the panel is a fixed-size
       deck that has no business being zoomed. */
    font-size: 16px;
    line-height: 1.4;
    color: var(--ink);
    background: none;
    border: none;
    padding: 0;
    outline: none;
  }
  #cap-note::placeholder { color: var(--ink-dim); transition: opacity 0.35s; }
  #cap-note[data-swapping]::placeholder { opacity: 0; }
  .cap-sheet-row { display: flex; justify-content: flex-end; gap: 0.5rem; }
  .sr-only {
    position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap;
  }

  @media (orientation: landscape) and (max-height: 520px) {
    .cap-guide { width: 11rem; }
    .cap-copy h2 { font-size: 1.25rem; }
  }
</style>

<script>
  const section = document.getElementById('add');
  if (section) {
    const input = document.getElementById('cap-input') as HTMLInputElement;
    const empty = document.getElementById('cap-empty')!;
    const result = document.getElementById('cap-result')!;
    const actions = document.getElementById('cap-actions')!;
    const send = document.getElementById('cap-send') as HTMLButtonElement;
    const skip = document.getElementById('cap-skip');
    const onward = section.dataset.next;
    const sheet = document.getElementById('cap-sheet')!;
    const note = document.getElementById('cap-note') as HTMLTextAreaElement;
    const preview = document.getElementById('cap-preview') as HTMLImageElement;
    const shareTo = section.dataset.shareTo!;
    let file: File | null = null;
    let url: string | null = null;

    // ---- The prompt ------------------------------------------------------
    // Asking "add a message" gets you nothing; asking something in particular
    // gets you a sentence. They rotate because a single question starts to read
    // as a label, and because a different one may be the one you can answer.
    const PROMPTS = [
      'What did you see?',
      'How does this place make you feel?',
      'What is your connection to this landscape?',
      'What has changed since you were last here?',
      'What would you want someone to notice here?',
    ];
    const ROTATE_MS = 4200;
    let promptAt = Math.floor(Math.random() * PROMPTS.length);
    let rotator: number | undefined;

    const showPrompt = () => { note.placeholder = PROMPTS[promptAt % PROMPTS.length]; };

    const stopRotating = () => {
      clearInterval(rotator);
      rotator = undefined;
      note.removeAttribute('data-swapping');
    };

    // Rotating under someone who is reading or typing is just noise, so it runs
    // only while the field is empty and unfocused.
    const startRotating = () => {
      stopRotating();
      rotator = window.setInterval(() => {
        if (note.value || document.activeElement === note) return;
        note.setAttribute('data-swapping', '');
        setTimeout(() => {
          promptAt += 1;
          showPrompt();
          note.removeAttribute('data-swapping');
        }, 350);
      }, ROTATE_MS);
    };

    note.addEventListener('focus', stopRotating);
    note.addEventListener('input', stopRotating);

    // The deck is a fixed, unscrollable viewport, so the browser cannot scroll
    // the field into view the way it would on an ordinary page -- the keyboard
    // simply covers it. The visual viewport reports how much of the window the
    // keyboard is taking, and the sheet rides up by exactly that.
    const vv = window.visualViewport;
    const GAP = 8; // breathing room between the sheet and the keyboard
    const lift = () => {
      if (!vv) return;
      const covered = Math.max(0, innerHeight - vv.height - vv.offsetTop);
      if (!covered) { sheet.style.transform = ''; return; }
      // Only far enough to clear it. The sheet already sits above the nav row,
      // so riding the keyboard's full height would leave it stranded halfway up
      // the photograph with a gap underneath.
      sheet.style.transform = '';
      const restingGap = innerHeight - sheet.getBoundingClientRect().bottom;
      const rise = Math.max(0, covered - restingGap + GAP);
      sheet.style.transform = rise ? `translateY(-${Math.round(rise)}px)` : '';
    };
    const drop = () => { sheet.style.transform = ''; };
    if (vv) {
      // `scroll` as well as `resize`: iOS shifts the visual viewport around as
      // the keyboard animates, and only the pair of them tracks it throughout.
      vv.addEventListener('resize', lift);
      vv.addEventListener('scroll', lift);
    }
    note.addEventListener('focus', lift);
    note.addEventListener('blur', drop);

    // ---- The sheet -------------------------------------------------------
    const openSheet = () => {
      promptAt = Math.floor(Math.random() * PROMPTS.length);
      showPrompt();
      sheet.hidden = false;
      // Deliberately not focused: focusing would stop the rotation before it
      // showed anything, and would throw the keyboard over the photograph
      // before there is a word to type. Tapping the field does both.
      startRotating();
    };
    const closeSheet = () => {
      stopRotating();
      note.blur();
      drop();
      sheet.hidden = true;
    };

    const reset = () => {
      if (url) URL.revokeObjectURL(url);
      url = null; file = null; input.value = '';
      result.hidden = true; empty.hidden = false;
      actions.hidden = true;
      send.hidden = true;
      if (skip) skip.hidden = false;
      note.value = '';
      closeSheet();
      caption.textContent = 'Add caption';
    };

    input.addEventListener('change', () => {
      file = input.files?.[0] ?? null;
      if (!file) return;
      url = URL.createObjectURL(file);
      preview.src = url;
      empty.hidden = true; result.hidden = false;
      actions.hidden = false;
      send.hidden = false;
      if (skip) skip.hidden = true;
    });

    // The photograph is away, so the panel has nothing left to ask for.
    const moveOn = () => {
      if (!onward) return;
      document.querySelector(onward)?.scrollIntoView({ behavior: 'smooth' });
    };

    document.getElementById('cap-retake')!.addEventListener('click', reset);

    // The caption button owns the sheet now: writing something is a step of its
    // own that can be skipped, rather than a gate on the way to sending.
    const caption = document.getElementById('cap-caption')!;
    const labelCaption = () => {
      caption.textContent = note.value.trim() ? 'Edit caption' : 'Add caption';
    };
    caption.addEventListener('click', () => (sheet.hidden ? openSheet() : closeSheet()));
    // Cancel throws the words away; Done keeps them and closes. Neither sends:
    // that is the arrow's job, whether or not this was ever opened.
    document.getElementById('cap-cancel')!.addEventListener('click', () => {
      note.value = '';
      labelCaption();
      closeSheet();
    });

    // ---- Sending ---------------------------------------------------------
    // A staged send, over the photograph: a bar that fills, then a tick. It is
    // a performance -- nothing leaves the phone. There is no backend on a
    // static host, and the point of the panel today is the gesture: take the
    // shot, say something, hand it over, move on.
    //
    // This is the seam. When there is somewhere to send to, the wait below
    // becomes the request, `said` and the file become its body, and the two
    // states this already has -- working, then done -- become its resolution.
    const upload = document.getElementById('cap-upload')!;
    const uploadSaid = document.getElementById('cap-upload-said')!;
    const barFill = document.getElementById('cap-bar-fill')!;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const fakeSend = async () => {
      upload.hidden = false;
      upload.removeAttribute('data-done');
      uploadSaid.textContent = `Sending to ${shareTo}…`;
      // From a standing start each time, and animated rather than set, so the
      // bar is seen to move rather than found already moved.
      barFill.style.transition = 'none';
      barFill.style.width = '0%';
      void barFill.offsetWidth;
      barFill.style.transition = 'width 1.5s cubic-bezier(0.3, 0.8, 0.3, 1)';
      barFill.style.width = '100%';
      await wait(1600);
      upload.setAttribute('data-done', '');
      uploadSaid.textContent = 'Sent. Thank you.';
      await wait(900);
    };

    document.getElementById('cap-confirm')!.addEventListener('click', () => {
      labelCaption();
      closeSheet();
    });

    send.addEventListener('click', async () => {
      if (!file) return;
      const said = note.value.trim();
      closeSheet();
      await fakeSend();
      // No line in the rail: the panel is left immediately, so anything written
      // there is cleared by the reset below before it could be read. The
      // overlay is the confirmation. When there is a real endpoint, the rail is
      // where a failure belongs -- that is the case which has to stay put.
      void said;
      moveOn();
      // Cleared behind the deck, once the panel is no longer the one on screen,
      // so coming back to it asks for a photograph rather than showing the last
      // one already sent.
      setTimeout(() => {
        upload.hidden = true;
        reset();
      }, 700);
    });
  }
</script>
