---
import { asset } from '../lib/paths';

interface Props { title: string; description?: string }
const { title, description = 'Scan the post. See the place, then see it change.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={asset('/manifest.webmanifest')} />
    <meta name="theme-color" content="#0d1210" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="EcoScapes" />
  </head>
  <body>
    <!-- Caught here, inline and early, because the browser offers this once and
         early: by the time a panel's own module script runs, the event has
         usually already been and gone. Holding onto it is what lets the last
         panel offer the install on a tap instead of hoping the browser asks. -->
    <script is:inline>
      window.__installPrompt = null;
      addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        window.__installPrompt = e;
        dispatchEvent(new Event('ecoscapes:installable'));
      });
      addEventListener('appinstalled', () => {
        window.__installPrompt = null;
        dispatchEvent(new Event('ecoscapes:installed'));
      });
    </script>
    <slot />
    <script>
      // Progressive enhancement only: every view works without the worker.
      //
      // Never in dev. Media is cache-first, so a worker would keep serving the
      // old copy of any asset that is regenerated -- a re-rendered hero, a new
      // panorama -- and the change would simply not appear. Phone testing goes
      // through an HTTPS tunnel, which is a secure context, so this cannot be
      // left to the localhost check alone. Offline behaviour is tested against
      // `npm run preview`.
      // And in dev, clear out any worker a built copy left on this address --
      // `npm run preview` on the same port, say. It would go on serving its
      // cached media over the files being edited.
      if (import.meta.env.DEV && 'serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((regs) => regs.forEach((r) => r.unregister()));
        caches?.keys().then((keys) => keys.forEach((k) => caches.delete(k)));
      }
      if (!import.meta.env.DEV && 'serviceWorker' in navigator) {
        const base = import.meta.env.BASE_URL;
        addEventListener('load', async () => {
          try {
            await navigator.serviceWorker.register(`${base.replace(/\/$/, '')}/sw.js`, { scope: base });
            const reg = await navigator.serviceWorker.ready;

            // On a first visit the CSS and JS are already in flight before the
            // worker controls the page, so its fetch handler never sees them and
            // they would be missing offline. The page knows exactly what it
            // loaded, so it tells the worker rather than the worker guessing at
            // build-hashed filenames.
            const seen = new Set();
            const report = (entries) => {
              const urls = [];
              for (const entry of entries) {
                const url = new URL(entry.name, location.href);
                if (url.origin !== location.origin) continue;
                if (!url.pathname.includes('/_astro/')) continue; // media has its own cache
                if (seen.has(url.href)) continue;
                seen.add(url.href);
                urls.push(url.href);
              }
              if (urls.length) reg.active?.postMessage({ type: 'cache-page', assets: urls });
            };

            reg.active?.postMessage({ type: 'cache-page', assets: [location.href] });
            // `buffered` replays what loaded before this ran; the observer then
            // picks up lazily imported chunks as they arrive.
            new PerformanceObserver((list) => report(list.getEntries()))
              .observe({ type: 'resource', buffered: true });
          } catch {
            /* no worker: the site still works, it just will not work offline */
          }
        });
      }
    </script>
    <style is:global>
      :root {
        --ink: #eef2ee;
        --ink-dim: #9aa79f;
        --bg: #0d1210;
        --bg-lift: #161d1a;
        --line: #2a3531;
        --accent: #7fd1a6;
        /* Undoing something, rather than doing it: throwing away a photograph. */
        --danger: #ef8b8b;
        --safe-t: env(safe-area-inset-top, 0px);
        --safe-b: env(safe-area-inset-bottom, 0px);
        /* Whatever the dynamic viewport leaves out. In a browser that is the
           toolbar at the foot of the screen, which is what this is for; it is
           not meaningful when installed (there it is the status bar, at the
           top), and the standalone rules at the end of this sheet override
           everything that reads it. */
        --chrome: calc(100lvh - 100dvh);
        /* What a panel keeps clear at its foot. Safari reports the home
           indicator in safe-area-inset-bottom even while its own toolbar sits
           on that strip, and a panel sized to 100dvh already stops above the
           toolbar -- honouring the inset as well insets it twice and leaves a
           dead band. Subtracting the chrome takes it back to 0 whenever
           something else already covers it. */
        --foot: max(0px, calc(var(--safe-b) - var(--chrome)));
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      /* Beats any component's own display rule. */
      [hidden] { display: none !important; }
      /* Sized in the same units as the deck: a body measured any other way ends
         at a different line and its background shows as a band under the foot
         of every panel. */
      html, body { margin: 0; height: 100dvh; overflow: hidden; }
      body {
        background: var(--bg);
        color: var(--ink);
        font: 400 16px/1.5 ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
        overscroll-behavior: none;
      }
      h1, h2, h3 { font-weight: 600; letter-spacing: -0.015em; margin: 0; }
      a { color: inherit; }
      button { font: inherit; color: inherit; }
      .eyebrow {
        font-size: 0.7rem; letter-spacing: 0.16em; text-transform: uppercase;
        color: var(--ink-dim); margin: 0;
      }
      /* Shared control chrome for the buttons that float over each experience. */
      .chip {
        /* Off, or Safari measures a <button> by its own rules -- its line-height
           and intrinsic metrics rather than the ones set here -- and the same
           chip comes out taller as a button than as a link sitting beside it.
           The line-height is stated for the same reason: not left to whatever
           each element type inherits. */
        appearance: none; -webkit-appearance: none;
        line-height: 1.25;
        display: inline-flex; align-items: center; gap: 0.5em;
        padding: 0.62em 1.05em; border-radius: 999px;
        /* A chip is a button whether or not it happens to be a link, and a
           button is not underlined. .step has always said so; this never did,
           so the one link wearing this class carried an underline. */
        text-decoration: none;
        border: 1px solid var(--line); background: rgba(13, 18, 16, 0.72);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        font-size: 0.82rem; font-weight: 500; cursor: pointer;
        transition: border-color 0.18s, background 0.18s, opacity 0.18s;
      }
      .chip:hover:not(:disabled) { border-color: var(--accent); }
      .chip:disabled { opacity: 0.45; cursor: default; }
      .chip[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); }
      /* The round buttons at either end of a panel's control row. Shared rather
         than owned by PanelNav, because a panel can put its own button in that
         corner through the nav's end slot, and scoped styles do not reach
         slotted markup. */
      .step {
        /* Same reason as .chip: these are links on some panels and buttons on
           others, and they sit in the same row. */
        appearance: none; -webkit-appearance: none;
        line-height: 1.25;
        pointer-events: auto; flex: none;
        width: 46px; height: 46px;
        display: grid; place-items: center;
        border-radius: 50%; color: var(--ink); text-decoration: none;
        background: rgba(13, 18, 16, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
        cursor: pointer;
        transition: border-color 0.18s, background 0.18s;
      }
      .step:hover:not(:disabled) { border-color: var(--accent); }
      /* The browser's own focus ring is a blue that belongs to nothing here,
         and it turns up after a tap as well as a key -- on a button focused by
         the script, or one just pressed. Off for pointers; for a keyboard, the
         same idea in the accent. And no grey flash on a tap on iOS. */
      .step, .chip { -webkit-tap-highlight-color: transparent; }
      .step:focus, .chip:focus { outline: none; }
      .step:focus-visible, .chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .step:disabled { opacity: 0.45; cursor: default; }
      .step svg { width: 20px; height: 20px; }
      /* A step that says what it does in a word rather than a picture (3D). */
      .step-text { font-size: 0.8rem; font-weight: 600; letter-spacing: 0.03em; }
      .step[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); }
      /* The tilt slider (src/lib/terrain.ts): a pill that slides out to the
         left from behind the 3D button while 3D is on. Only with a mouse and
         room for it; a touch screen tilts with two fingers. */
      .tilt-wrap { position: relative; }
      .tilt { display: none; }
      @media (hover: hover) and (pointer: fine) and (min-width: 48rem) {
        .tilt {
          position: absolute; z-index: -1;
          top: 0; right: 23px; height: 46px;
          display: flex; align-items: center; gap: 0.6rem;
          width: 0; padding: 0; overflow: hidden;
          border-radius: 23px 0 0 23px;
          background: rgba(13, 18, 16, 0.72);
          border: 1px solid rgba(255, 255, 255, 0.2); border-right: 0;
          backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
          font-size: 0.72rem; letter-spacing: 0.04em; color: var(--ink-dim);
          white-space: nowrap;
          opacity: 0; pointer-events: none;
          transition: width 0.26s ease, padding 0.26s ease, opacity 0.18s;
        }
        .tilt.open {
          width: 12.5rem; padding: 0 calc(23px + 0.9rem) 0 1rem;
          opacity: 1; pointer-events: auto;
        }
        .tilt input { flex: 1; min-width: 0; margin: 0; accent-color: var(--accent); cursor: pointer; }
      }
      /* Whichever ends exist keep their own corner, with no placeholder element
         for a missing one. */
      .step-prev { margin-right: auto; }
      .step-next { margin-left: auto; }
      /* The deck: one full-viewport panel per experience, snapped vertically.
         100dvh rather than 100vh so the panels do not sit under the mobile
         browser's collapsing toolbar. */
      .deck {
        height: 100dvh; display: flex;
        overflow-x: scroll; overflow-y: hidden; scroll-snap-type: x mandatory;
        scroll-behavior: smooth; scrollbar-width: none;
        overscroll-behavior-x: contain;
      }
      .deck::-webkit-scrollbar { display: none; }
      .panel {
        flex: 0 0 100%; width: 100%;
        position: relative; height: 100dvh; scroll-snap-align: start;
        scroll-snap-stop: always; display: flex; flex-direction: column; overflow: hidden;
      }
      /* Experiences fill the panel; the rail below stays outside the canvas so a
         one-finger drag on the panorama pans it while the rail still scrolls. */
      .panel-stage { position: relative; flex: 1; min-height: 0; }
      .panel-rail {
        flex: none; padding: 0.9rem 1.15rem calc(0.9rem + var(--foot));
        border-top: 1px solid var(--line); background: var(--bg);
        display: flex; flex-direction: column; align-items: center;
        text-align: center; gap: 0.25rem;
      }
      .panel-rail h2 { font-size: 0.95rem; letter-spacing: 0.01em; }
      .panel-rail p {
        margin: 0; font-size: 0.83rem; line-height: 1.45;
        color: var(--ink-dim); max-width: 32rem;
      }
      /* Status lines the scripts write into: empty until there is something to
         say, so they take no room in the rail until then. */
      .panel-rail .rail-note { font-size: 0.75rem; }
      .panel-rail .rail-note:empty { display: none; }

      /* Phone landscape is short: give the media panels the rail's height back.
         The captions it carries are secondary, and both experiences are
         self-describing once they fill the screen. */
      @media (orientation: landscape) and (max-height: 520px) {
        #view .panel-rail { display: none; }
        /* Without the rail underneath it, the stage now reaches the foot of the
           screen, so the arrow row is what has to clear the home indicator. */
        #view { --nav-safe: var(--foot); }
      }

      /* Installed, the dynamic viewport stops below the status bar -- measured
         on an iPhone: screen 932, lvh 932, dvh 873, and the page still starts
         at the top of the screen, so a panel sized to dvh ends 59px short and
         leaves a black chin. The large viewport is the whole screen, which is
         what a standalone app should fill; --foot then keeps the controls off
         the home indicator, which nothing else is covering here.

         This has to come after the rules it overrides: same specificity, so
         source order decides, and sitting above them it silently lost.

         In a browser the dynamic viewport is exactly right and none of this
         applies. */
      @media (display-mode: standalone), (display-mode: fullscreen) {
        :root { --foot: var(--safe-b); }
        html, body, .deck, .panel { height: 100lvh; }
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
      }
    </style>
  </body>
</html>
