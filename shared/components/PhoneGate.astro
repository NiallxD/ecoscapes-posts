---
import { asset } from '../lib/paths';

/** On a phone, in place of a page built for a bigger screen: what it is, a
 *  way to send yourself the link for later, and the map to look at now.
 *  iPads and computers never see this. The page hides its own content under
 *  the same test (PHONE in shared/lib/phone.ts, which a script checks before
 *  loading anything heavy); the gate shows itself.
 *
 *  Anything in the slot goes under the email button: the Data Sandbox puts
 *  its "see this map as a picture" there. */
interface Props {
  /** The page's name, over the heading and in the email's subject. */
  name: string;
  /** Why it needs a bigger screen, in a sentence or two. */
  text: string;
}
const { name, text } = Astro.props;
---
<section class="phone-gate" aria-labelledby="gate-title">
  <img class="gate-logo" src={asset('/img/ecoscapes-logo-white.png')} alt="EcoScapes" width="800" height="184" />
  <p class="eyebrow">{name}</p>
  <h1 id="gate-title">This one needs a bigger screen</h1>
  <p>{text}</p>
  <a class="gate-btn gate-main" id="gate-mail" href="mailto:" data-name={name}>Email me the link</a>
  <slot />
  <a class="gate-btn" href={asset('/map/')}>Open the map</a>
  <a class="gate-home" href={asset('/')}>All the posts</a>
  <!-- The email's address filled in here, on its own: the page's main
       script may have a whole map library to load first, and the button must
       work whether or not that ever runs. -->
  <script is:inline>
    (function () {
      var a = document.getElementById('gate-mail');
      var name = 'EcoScapes ' + a.dataset.name;
      a.href =
        'mailto:?subject=' + encodeURIComponent(name) +
        '&body=' + encodeURIComponent('Open the ' + name + ' on a computer or tablet:\n\n' + location.href + '\n');
    })();
  </script>
</section>

<style>
  /* A phone, upright or on its side: a touch screen under 600px either way.
     The same test as PHONE in shared/lib/phone.ts. */
  .phone-gate { display: none; }
  @media (pointer: coarse) and (max-width: 599px), (pointer: coarse) and (max-height: 599px) {
    .phone-gate {
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 0.9rem;
      max-width: 26rem;
      margin: 0 auto;
      padding: calc(var(--safe-t, 0px) + 2rem) 1.5rem 2rem;
      background: var(--bg);
    }
  }
  .gate-logo { width: 11rem; height: auto; margin-bottom: 1rem; }
  .phone-gate .eyebrow { margin: 0; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .phone-gate h1 { margin: 0; font-size: 1.6rem; line-height: 1.2; }
  .phone-gate p { margin: 0; line-height: 1.55; color: var(--ink-dim); }
  /* Global: a page's own buttons in the slot, and on its phone screens, wear
     them too. */
  :global(.gate-btn) {
    display: block;
    padding: 0.85rem 1rem;
    border-radius: 12px;
    border: 1px solid var(--line);
    color: var(--ink);
    text-align: center;
    text-decoration: none;
    font-weight: 600;
  }
  :global(.gate-btn:disabled) { opacity: 0.5; }
  :global(button.gate-btn) { width: 100%; appearance: none; background: none; font: inherit; cursor: pointer; }
  .gate-main { margin-top: 0.6rem; border-color: var(--accent); background: var(--accent); color: #0d1210; }
  .gate-home { align-self: center; margin-top: 0.4rem; font-size: 0.85rem; color: var(--ink-dim); }
</style>
