</style>

<script>
  import * as maplibregl from 'maplibre-gl';
  import workerUrl from 'maplibre-gl/dist/maplibre-gl-worker.mjs?worker&url';
  import { Protocol } from 'pmtiles';
  import { studyStyle } from '../shared/lib/study-style';
  import { addRelief, addSky, tilting } from '../shared/lib/terrain';
  import { PHONE } from '../shared/lib/phone';
  import { ScoreLayer } from '../dst/lib/score-layer';
  import { paletteById, rgb } from '../dst/lib/palettes';
  import { encodeSaved } from '../dst/lib/share';
  import { Wheel, type WheelGoal } from './lib/wheel';
  import { TABS, goalOf, readPlace, stepBy, writePlace, type Place, type Tab } from './lib/path';
  import { modelFor, type MapLayer } from './lib/recipe';
  import { GoalRing, type RingPlace } from './lib/goal-ring';
  import type { Frameworks, MapDef, Target, Tool } from './lib/content';

  type LngLat = [number, number];
  type Config = {
    bounds: [LngLat, LngLat];
    limit: [LngLat, LngLat];
    basemap: string;
    terrain: string;
    glyphs: string;
    sandbox: string;
    explore: string;
    frameworks: Frameworks;
    targets: Target[];
    maps: Record<string, MapDef>;
    tools: Record<string, Tool>;
    covers: Record<string, { src: string; thumb: string }>;
    mapLayers: MapLayer[];
    icons: Record<string, string>;
  };

  // A phone gets the gate instead, and nothing past here runs.
  if (!matchMedia(PHONE).matches) start();

  function start() {
    const mapEl = document.getElementById('map')!;
    const cfg: Config = JSON.parse(mapEl.dataset.config!);
    const page = document.getElementById('cycle')!;
    const column = document.getElementById('column')!;
    const words = document.getElementById('words')!;
    const card = document.getElementById('card')!;
    const panel = document.getElementById('panel')!;
    const tablist = document.getElementById('tabs')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const abs = (p: string) => (/^https?:/.test(p) ? p : location.origin + p);
    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

    const goalsList = cfg.frameworks.goals;
    const goalIds = goalsList.map((g) => g.id);
    const byId = new Map(cfg.targets.map((t) => [t.id, t]));
    const sdgs = new Map(cfg.frameworks.sdgs.map((s) => [s.n, s]));
    const layers = new Map(cfg.mapLayers.map((l) => [l.id, l]));
    const plan = goalIds.map((g) => cfg.targets.filter((t) => t.goal === g).map((t) => t.id));
    const extras = cfg.targets.filter((t) => t.supplementary).map((t) => t.id);
    const goalOfTarget = (t: Target) => (t.goal ? goalsList[goalIds.indexOf(t.goal)] : null);
    const colourOf = (t: Target) => goalOfTarget(t)?.colour ?? cfg.frameworks.supplementaryColour;
    /** White or near-black on a colour, whichever reads better. */
    const inkOn = (hex: string) => {
      const lin = (i: number) => {
        const c = parseInt(hex.slice(i, i + 2), 16) / 255;
        return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
      };
      const L = 0.2126 * lin(1) + 0.7152 * lin(3) + 0.0722 * lin(5);
      return 1.05 / (L + 0.05) >= (L + 0.05) / 0.05 ? '#ffffff' : '#0d1210';
    };
    /** The Canada 2030 target numbers a target works toward: "14, 21 & 22"
     *  is three. */
    const numsOf = (t: Target) => t.levels.national.target?.match(/\d+/g) ?? [];
    /** "Target 3", or "Targets 14, 21 & 22". */
    const targetWord = (n: string) => (/[,&]/.test(n) ? `Targets ${n}` : `Target ${n}`);
    /** A target's circle: its Canada target's number, or its own label. */
    const chipOf = (t: Target) => t.chip ?? numsOf(t)[0] ?? '•';
    const mapsOf = (t: Target) => t.actions.flatMap((a) => ('map' in a ? [a.map] : []));
    const toolsOf = (t: Target) => t.actions.flatMap((a) => ('tool' in a ? [a.tool] : []));

    // ---- Where you are -------------------------------------------------------
    let place: Place = readPlace(plan, goalIds, extras, location.search);
    /** The ring chosen on the Align tab. */
    type Level = 'regional' | 'national' | 'global';
    let level: Level = 'regional';
    /** Drawn again only to change the ring chosen: no growing in again. */
    let still = false;

    const wheelGoals: WheelGoal[] = goalsList.map((g, i) => ({
      code: g.id,
      name: g.name,
      colour: g.colour,
      ink: inkOn(g.colour),
      targets: plan[i].map((id) => {
        const t = byId.get(id)!;
        return { id, chip: chipOf(t), name: t.name, ink: inkOn(g.colour), icon: t.icon && cfg.icons[t.icon] };
      }),
    }));
    const wheel = new Wheel(document.getElementById('wheel') as unknown as SVGSVGElement, wheelGoals, {
      goal: (i) => go({ ...place, goal: i, target: null, map: null }),
      target: (id) => pick(id),
      move: (dir) => go(stepBy(plan, place, dir)),
      scroll: (e) => onScroll(e, true),
    });
    /** A target, from anywhere: its own goal, the tab kept. */
    function pick(id: string) {
      const g = goalOf(plan, id);
      go({ ...place, goal: g >= 0 ? g : place.goal, target: id, map: null });
    }

    /** Anywhere but home, unless `home` says so: a move made from home
     *  (spreading it) leaves it. */
    function go(next: Place, home = false) {
      next = { ...next, home };
      const moved = next.goal !== place.goal || next.target !== place.target || home !== !!place.home;
      const retab = !moved && next.tab !== place.tab;
      place = next;
      wheel.show(place.goal, place.target && goalOf(plan, place.target) >= 0 ? place.target : null, TABS.indexOf(place.tab) + 1);
      history.replaceState(null, '', writePlace(place, goalIds));
      showMap();
      // A new goal or target fades the words out and in; a new tab, only the
      // tab's own content; a new map, nothing.
      if (reduce.matches || !(moved || retab)) {
        if (!swapping) fill();
        return;
      }
      if (retab) markTabs();
      swap(moved ? words : panel);
    }

    // Out, then the new words, then in: never two sets at once. The fade is
    // done here, a frame at a time, not as a CSS transition: Safari runs a
    // transition on its own and can start it late while the page is busy,
    // so the words were swapped while the old ones still showed and the two
    // faded across each other. Set here, the opacity on screen is the one
    // set, and the words change only after a frame has been drawn with none
    // showing. A move made while a swap is under way joins it: the swap
    // shows wherever you've got to by then.
    const SWAP_OUT = 150, SWAP_IN = 190;
    let swapping = false;
    const fading = new Set<HTMLElement>();
    const frame = () => new Promise<number>((r) => requestAnimationFrame(r));
    async function fadeEls(to: number, ms: number) {
      const els = [...fading];
      const from = els.map((e) => Number(e.style.opacity || 1));
      const t0 = await frame();
      for (;;) {
        const now = await frame();
        const x = Math.min(1, (now - t0) / ms);
        const k = x * (2 - x);
        els.forEach((e, i) => (e.style.opacity = String(from[i] + (to - from[i]) * k)));
        if (x >= 1) break;
      }
      // One more frame, so the last opacity has been drawn before going on.
      await frame();
    }
    async function swap(el: HTMLElement) {
      fading.add(el);
      if (swapping) return;
      swapping = true;
      await fadeEls(0, SWAP_OUT);
      fill();
      // Laid out and drawn at nothing before it comes up.
      await frame();
      await fadeEls(1, SWAP_IN);
      for (const f of fading) f.style.opacity = '';
      fading.clear();
      swapping = false;
    }

    // ---- The words -----------------------------------------------------------
    const tabs = [...tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const inline = (n: number) => {
      const s = sdgs.get(n)!;
      return `<span class="sdg-in" style="--s:${s.colour};--s-ink:${inkOn(s.colour)}"><b>${n}</b>${esc(s.name)}</span>`;
    };
    const goalDot = (t: Target) => `<i class="dot" style="--c:${colourOf(t)}"></i>`;
    /** One line naming what drives action on a target. */
    const drives = (t: Target) =>
      t.actions.map((a) => ('map' in a ? cfg.maps[a.map].title : cfg.tools[a.tool].name)).join(' · ');

    /** The chosen tab lit: straight away on a click, not when the words
     *  under it change, or the old one stays lit through the fade. */
    function markTabs() {
      for (const b of tabs) {
        const on = b.dataset.tab === place.tab;
        b.setAttribute('aria-selected', String(on));
        b.tabIndex = on ? 0 : -1;
      }
    }

    // ---- The goals as a ring ----------------------------------------------------
    // 40 years of change supports every goal: on its What tab the goals bar at
    // the foot bends into a ring in the space under the words, and back into
    // the bar on its other tabs (which fill that space) or anywhere else.
    const ring = new GoalRing(
      document.getElementById('goal-ring') as unknown as SVGSVGElement,
      document.getElementById('goal-nav')!,
      goalsList.map((g) => ({ code: g.id, name: g.name, colour: g.colour })),
      (i) => go({ ...place, goal: i, target: null, map: null }),
      reduce,
    );
    /** Where the ring fits: between the words' end and the foot, as wide as
     *  the disc allows there. Null where there isn't room for it. */
    function ringPlace(): RingPlace | null {
      const col = column.getBoundingClientRect();
      const last = panel.lastElementChild?.getBoundingClientRect();
      const foot = column.querySelector('.foot')!.getBoundingClientRect();
      const top = (last?.bottom ?? card.getBoundingClientRect().top) + 28;
      const bottom = foot.top - 10;
      // Room for the labels over it and two lines of words under it.
      const r = Math.min(104, (bottom - top - 22 - 64) / 2);
      if (r < 46) return null;
      const cy = top + 22 + r;
      const right = Math.min(col.right, wheel.edgeAt(cy));
      const half = (right - col.left) / 2;
      const rr = Math.min(r, half - 40);
      if (rr < 46) return null;
      return { cx: half, cy: cy - col.top - (r - rr), r: rr };
    }
    /** Two lines, as even as the names allow. */
    const twoLines = (names: string[]) => {
      let best = [names.join(' · ')];
      for (let k = 1; k < names.length; k++) {
        const a = names.slice(0, k).join(' · '), b = names.slice(k).join(' · ');
        if (Math.max(a.length, b.length) < Math.max(...best.map((x) => x.length))) best = [a, b];
      }
      return best;
    };
    function updateRing() {
      const t = place.target ? byId.get(place.target)! : null;
      const p = t?.supplementary && place.tab === 'what' ? ringPlace() : null;
      if (!t || !p) return ring.hide();
      const names = t.actions.map((a) => ('map' in a ? cfg.maps[a.map].title : cfg.tools[a.tool].name.replace(/^.*, on /, '')));
      ring.show(p, t.name, ['Through: ' + twoLines(names)[0], ...twoLines(names).slice(1)]);
    }

    function fill() {
      const t = place.target ? byId.get(place.target)! : null;
      const g = goalsList[place.goal];
      const eyebrow = document.getElementById('eyebrow')!;
      const title = document.getElementById('title')!;
      const lede = document.getElementById('lede')!;
      document.querySelectorAll<HTMLButtonElement>('#goal-nav button').forEach((b) =>
        b.setAttribute('aria-pressed', String(!t?.supplementary && Number(b.dataset.goal) === place.goal)),
      );
      document.querySelectorAll<HTMLButtonElement>('#extra button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.target === place.target)));
      document.getElementById('home')!.setAttribute('aria-pressed', String(!!place.home));

      if (place.home) {
        // Before the path: what the page is and how to get round it.
        const h = cfg.frameworks.home, first = goalsList[0];
        document.querySelectorAll<HTMLButtonElement>('#goal-nav button').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        eyebrow.textContent = h.eyebrow;
        title.textContent = h.title;
        lede.textContent = h.lede;
        tablist.hidden = true;
        panel.removeAttribute('role');
        panel.removeAttribute('aria-labelledby');
        panel.style.setProperty('--c', first.colour);
        panel.innerHTML = `
          <div class="home-body">${h.body.map((p) => `<p>${p}</p>`).join('')}</div>
          <button type="button" class="start" data-start style="--c:${first.colour}"><i></i>${esc(h.start)}: ${esc(first.id)} ${esc(first.name)} →</button>`;
        fit();
        catchScrolls(panel.children);
        updateRing();
        return;
      }

      if (!t) {
        // The goal itself: what it sets out to do, and its targets.
        eyebrow.innerHTML = `EcoScapes goal ${g.id}`;
        title.textContent = g.name;
        lede.textContent = g.statement;
        tablist.hidden = true;
        panel.removeAttribute('role');
        panel.removeAttribute('aria-labelledby');
        panel.style.setProperty('--c', g.colour);
        panel.innerHTML = `
          ${g.note ? `<p class="note">${esc(g.note)}</p>` : ''}
          <h3>Targets addressed</h3>
          <p class="small">Canada's 2030 Nature Strategy (and the Kunming-Montreal Global Biodiversity Framework)</p>
          <ul class="tlist">${plan[place.goal]
            .map((id) => {
              const x = byId.get(id)!;
              return `<li><button type="button" data-target="${id}" style="--c:${g.colour};--c-ink:${inkOn(g.colour)}">
                <span class="n">${esc(chipOf(x))}</span><span class="nm">${esc(x.name)}</span><span class="by">${esc(drives(x))}</span></button></li>`;
            })
            .join('')}</ul>
          ${g.footnote ? `<p class="footnote">*${esc(g.footnote)}</p>` : ''}`;
        fit();
        catchScrolls(panel.children);
        updateRing();
        return;
      }

      // Over the name: its goal, and the number it goes by -- Canada's
      // target, Canada's interpretation of the KMGBF one of the same number.
      // Under it, what it is in a line.
      const own = goalOfTarget(t);
      const na = t.levels.national.target;
      const numbers = na ? ` · Canada 2030 ${targetWord(na)}${t.half ? ` · ${esc(t.half)}` : ''} · KMGBF` : '';
      eyebrow.innerHTML = own
        ? `<button type="button" id="to-goal" style="--c:${own.colour}" title="${own.id}: ${esc(own.name)}. All its targets"><i></i>${own.id}</button>${numbers}`
        : `Supporting every goal${numbers}`;
      title.textContent = t.name;
      lede.textContent = t.short;
      tablist.hidden = false;
      markTabs();
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', `tab-${place.tab}`);
      panel.style.setProperty('--c', colourOf(t));

      if (place.tab === 'what') {
        // Where this target meets another, under another goal: the same
        // Canada target worked on twice.
        const mine = numsOf(t);
        const also = cfg.targets.filter((x) => x.id !== t.id && !x.supplementary && numsOf(x).some((n) => mine.includes(n)));
        panel.innerHTML = `
          <h3>What is the focus of this target?</h3>
          ${t.levels.national.target ? `<p>${esc(t.text)}</p>` : ''}
          <div class="act"><b>What it drives</b>${esc(t.act)}</div>
          <p class="small"><b>Who acts:</b> ${esc(t.who)}</p>
          ${
            also.length
              ? `<ul class="also">${mine
                  .map((n) => {
                    // Everyone working toward this Canada target, under
                    // whichever goal: EcoScapes split Target 1 in three.
                    const with_ = also.filter((x) => numsOf(x).includes(n));
                    if (!with_.length) return '';
                    return `<li>Also toward Canada Target ${n}: ${with_
                      .map((x) => `${goalDot(x)}<button type="button" data-target="${x.id}">${esc(x.name)}</button> (${esc(x.goal ?? '')})`)
                      .join(' · ')}</li>`;
                  })
                  .join('')}</ul>`
              : ''
          }`;
      } else if (place.tab === 'how') {
        const drawn = currentMap();
        const items = t.actions.map((a) => {
          if ('map' in a) {
            const m = cfg.maps[a.map];
            const others = cfg.targets.filter((x) => x.id !== t.id && mapsOf(x).includes(a.map));
            return `<li class="map${a.map === drawn ? ' on' : ''}" data-map="${a.map}">
              <button type="button" aria-pressed="${a.map === drawn}"><span class="kind">Map${a.map === drawn ? ' · on the map' : ''}</span>
              <span class="nm">${esc(m.title)}</span>${m.updating ? '<span class="tag">Being updated</span>' : ''}</button>
              ${a.map === drawn ? `<p>${esc(m.about)}</p>` : ''}
              ${others.length ? `<span class="used">Also used for ${others.map((x) => `${goalDot(x)}<button type="button" data-target="${x.id}">${esc(x.name)}</button>`).join(', ')}</span>` : ''}
            </li>`;
          }
          const tool = cfg.tools[a.tool];
          const name = tool.href
            ? `<a class="nm" href="${esc(tool.href)}" target="_blank" rel="noopener">${esc(tool.name)} ↗</a>`
            : `<span class="nm">${esc(tool.name)}</span>`;
          const cover = cfg.covers[a.tool];
          return cover
            ? `<li class="has-cover"><img class="thumb" src="${cover.thumb}" alt="" /><span class="kind">${tool.by ? esc(tool.by) : 'Document'}</span>${name}<p>${esc(tool.text)}</p></li>`
            : `<li><span class="kind">${tool.by ? esc(tool.by) : 'Tool'}</span>${name}<p>${esc(tool.text)}</p></li>`;
        });
        panel.innerHTML = `<h3>How is it being achieved?</h3><ul class="acts">${items.join('')}</ul>`;
      } else {
        const L = t.levels, gl = L.global, na = L.national;
        const own = goalOfTarget(t);
        const kg = (goal: string) => (goal === 'X' ? 'Goals A–D' : `Goal ${goal}`);
        // The bigger picture as half-rings, from the middle out: what drives
        // action at the core, then the regional, national and global levels,
        // each an arc round the last. Under them a note for each, in the same
        // order, in its ring's colour.
        const drives = t.actions.map((a) => ('map' in a ? cfg.maps[a.map].title : cfg.tools[a.tool].name));
        const RINGS: { id: Level; colour: string; name: string }[] = [
          { id: 'regional', colour: colourOf(t), name: 'Regional' },
          { id: 'national', colour: '#d8a78f', name: 'National' },
          { id: 'global', colour: '#8fb8d8', name: 'Global' },
        ];
        const C = 150, BANDS: [number, number][] = [[50, 86], [86, 117], [117, 148]];
        /** A note: its heading, its target, then a labelled line per fact. */
        const note = (id: string, colour: string, head: string, main: string, facts: [string, string][]) =>
          `<div class="lv-note" data-level="${id}" style="--lc:${colour}"><p class="lv-h"><i></i>${head}</p><p class="lv-main">${main}</p>` +
          facts.map(([k, v]) => `<p class="lv-small"><span class="k">${k}:</span> ${v}</p>`).join('') +
          `</div>`;
        const goalFact = (who: string, g: string) =>
          `<span title="${esc(cfg.frameworks.kmgbfGoals[g] ?? '')}">${g === 'X' ? 'A–D (runs through all four)' : g}</span>`;
        const headlineFact = gl.indicator ? `<span title="${esc(gl.indicator)}">${esc(gl.indicator.split(' ')[0])}</span>` : '';
        /** An SDG as its numbered square, the name on hover. */
        const sdgSq = (n: number) => {
          const x = sdgs.get(n)!;
          return `<b class="sdg-sq" style="--s:${x.colour};--s-ink:${inkOn(x.colour)}" title="SDG ${n}: ${esc(x.name)}">${n}</b>`;
        };
        const target = (who: string, n: string | null, text: string) => (n ? `<b>${who} ${targetWord(n)}</b> ${esc(text)}` : esc(text));
        panel.innerHTML = `
          <div class="bp-h"><h3>How does this target align with global frameworks?</h3>${cfg.frameworks.draft ? `<span class="draft">Draft · ${esc(cfg.frameworks.draft)}</span>` : ''}</div>
          <div class="bp">
            <svg class="levels" viewBox="0 0 300 158" aria-hidden="true">
              ${RINGS.map((x, k) => {
                const [r0, r1] = BANDS[k], rm = (r0 + r1) / 2, rt = rm - 4;
                return `<g class="lv" data-level="${x.id}" style="--lc:${x.colour};--k:${k}">
                  <path class="lv-band" d="M${C - rm} ${C}A${rm} ${rm} 0 0 1 ${C + rm} ${C}" stroke-width="${r1 - r0 - 3}" pathLength="1" />
                  <path id="lv-path-${k}" d="M${C - rt} ${C}A${rt} ${rt} 0 0 1 ${C + rt} ${C}" fill="none" />
                  <text class="lv-name"><textPath href="#lv-path-${k}" startOffset="50%" text-anchor="middle">${x.name}</textPath></text>
                </g>`;
              }).join('')}
              <g class="lv lv-core-g" data-level="core" style="--k:0">
                <path class="lv-core" d="M${C - 46} ${C}A46 46 0 0 1 ${C + 46} ${C}Z" />
                <text class="lv-core-t" x="${C}" y="${C - 14}" text-anchor="middle">${drives.length === 1 ? 'the map' : `${drives.length} ways`}</text>
              </g>
              <line class="lv-base" x1="0" y1="${C + 0.5}" x2="300" y2="${C + 0.5}" />
            </svg>
            <div class="lv-notes">
              ${note('core', 'var(--ink-dim)', 'In the middle', drives.map(esc).join(' · '), [])}
              ${note(
                'regional',
                colourOf(t),
                `Regional · ${own ? own.id : 'all goals'}`,
                `<b>${esc(t.name)}</b>${t.half ? ` <span class="half">(${esc(t.half)})</span>` : ''}`,
                [['ES Indicator', esc(L.regional.indicator)]],
              )}
              ${note(
                'national',
                '#d8a78f',
                'National · Canada 2030',
                target('Canada', na.target, na.text),
                // Both short: one line.
                [['Canada Goal', `${goalFact('Canada', na.goal)}${gl.indicator ? ' · <span class="k">Headline indicator:</span> same as KMGBF' : ''}`]],
              )}
              ${note(
                'global',
                '#8fb8d8',
                'Global · UN and KMGBF',
                target('KMGBF', gl.target, gl.text),
                [
                  ['KMGBF Goal', goalFact('KMGBF', gl.goal)],
                  ...(gl.indicator ? ([['Headline indicator', headlineFact]] as [string, string][]) : []),
                  ['SDG', gl.sdg.map(sdgSq).join(' · ')],
                ],
              )}
            </div>
          </div>`;
      }
      fit();
      catchScrolls([...panel.children, ...document.getElementById('eyebrow')!.children]);
      updateRing();
    }

    // Tabs: a click, or the arrow keys along them as a tablist has.
    tablist.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[role="tab"]');
      if (b) go({ ...place, tab: b.dataset.tab as Tab });
    });
    tablist.addEventListener('keydown', (e) => {
      // From the tab with the focus: the selected one, unless clicked away.
      const i = Math.max(0, tabs.indexOf(document.activeElement as HTMLButtonElement));
      const j = e.key === 'ArrowRight' ? i + 1 : e.key === 'ArrowLeft' ? i - 1 : e.key === 'Home' ? 0 : e.key === 'End' ? tabs.length - 1 : -2;
      if (j === -2) return;
      e.preventDefault();
      const b = tabs[(j + tabs.length) % tabs.length];
      go({ ...place, tab: b.dataset.tab as Tab });
      b.focus();
    });
    // Align: a note and its ring light up together.
    const lightLevel = (id: string | null) =>
      panel.querySelectorAll<Element>('.lv, .lv-note').forEach((e) => e.classList.toggle('on', (e as HTMLElement).dataset.level === id));
    panel.addEventListener('pointerover', (e) => {
      const hit = (e.target as Element).closest<HTMLElement>('.lv, .lv-note');
      lightLevel(hit?.dataset.level ?? null);
    });
    panel.addEventListener('pointerleave', () => lightLevel(null));

    // In the panel: a target (from the list, or where two meet), or a map.
    panel.addEventListener('click', (e) => {
      const el = e.target as Element;
      if (el.closest('[data-start]')) return go({ goal: 0, target: null, tab: 'what', map: null });
      const tb = el.closest<HTMLButtonElement>('button[data-target]');
      if (tb) return pick(tb.dataset.target!);
      const m = el.closest<HTMLElement>('[data-map]');
      if (m && el.closest('button')) go({ ...place, map: m.dataset.map! });
    });
    document.getElementById('eyebrow')!.addEventListener('click', (e) => {
      if ((e.target as Element).closest('#to-goal')) go({ ...place, target: null, map: null });
    });
    document.getElementById('home')!.addEventListener('click', () => go({ goal: 0, target: null, tab: 'what', map: null }, true));
    // The logo too: a link to the bare address, followed here without a
    // reload (a new tab or window still opens it).
    document.getElementById('logo-link')!.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
      e.preventDefault();
      go({ goal: 0, target: null, tab: 'what', map: null }, true);
    });
    document.getElementById('goal-nav')!.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[data-goal]');
      if (b) go({ ...place, goal: Number(b.dataset.goal), target: null, map: null });
    });
    // 40 years of change opens and closes like a toggle: a second click goes
    // back to wherever you were before it (or the goal, if the page opened
    // on it).
    let before: Place | null = null;
    document.getElementById('extra')!.addEventListener('click', (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>('[data-target]');
      if (!b) return;
      if (place.target === b.dataset.target) {
        const back = before ?? { ...place, target: null, tab: 'what' as Tab, map: null };
        before = null;
        return go(back, !!back.home);
      }
      if (!byId.get(place.target ?? '')?.supplementary) before = { ...place };
      // Opened on its What tab, where the goals turn into a ring.
      go({ ...place, target: b.dataset.target!, tab: 'what', map: null });
    });
    // A scroll over the disc (the words, the ring, the space between) walks
    // the path too, one step a flick. A trackpad goes on sending scrolls after
    // the fingers stop (the glide, a second or more), so after a step the rest
    // of that flick is ignored: until it has been quiet for a moment, or a new
    // flick starts. The glide only slows, so a scroll that speeds up again,
    // and stays up, once the glide has well slowed is fingers on the pad: a
    // new flick. Stays up, as a lone scroll can jump. Over the map, a scroll is the map's; in
    // a tab long enough to scroll, it scrolls until its end.
    let scrollAcc = 0, scrollBusyTill = 0, stepAt = 0, lastAt = 0, peak = 0;
    let speeds: number[] = [];
    const mean = (a: number[]) => a.reduce((x, y) => x + y, 0) / a.length;
    const handled = new WeakSet<Event>();
    /** One scroll: `ours` when it's known to be over the disc (from the
     *  words' own listeners, below), else checked here. */
    function onScroll(e: WheelEvent, ours = false) {
      if (handled.has(e)) return;
      const t = e.target as Element;
      if (!ours) {
        if (!t.closest('#column, #wheel')) return;
        if (!t.closest('.disc, .ring, #column')) return;
      }
      handled.add(e);
      const dy = Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
      if (card.classList.contains('scrolls') && card.contains(t)) {
        const atEnd = dy > 0 ? card.scrollTop + card.clientHeight >= card.scrollHeight - 1 : card.scrollTop <= 0;
        if (!atEnd) return;
      }
      e.preventDefault();
      // When the scroll happened, not when it's handled: after a step the
      // page is busy a moment, and the rest of the flick arrives late.
      const now = e.timeStamp;
      // Speed per millisecond, not per scroll: one scroll can carry several
      // frames' worth when the page was busy, but it covers their time too.
      const speed = Math.abs(dy) / Math.min(50, Math.max(8, now - lastAt));
      lastAt = now;
      if (now < scrollBusyTill) {
        peak = Math.max(peak, speed);
        speeds.push(speed);
        if (speeds.length > 9) speeds.shift();
        // The last three against the six before them.
        const recent = mean(speeds.slice(-3)), before = speeds.length === 9 ? mean(speeds.slice(0, 6)) : Infinity;
        const again = now - stepAt > 300 && before < peak * 0.6 && recent > before * 1.8 + 0.25 && Math.min(...speeds.slice(-3)) > before;
        if (!again) {
          // Still the same flick: wait for it to go quiet, never less.
          scrollBusyTill = Math.max(scrollBusyTill, now + 160);
          return;
        }
        scrollAcc = 0;
      }
      scrollAcc += dy;
      if (Math.abs(scrollAcc) < 40) return;
      go(stepBy(plan, place, scrollAcc > 0 ? 1 : -1));
      scrollAcc = 0;
      scrollBusyTill = now + 600;
      stepAt = now;
      peak = speed;
      speeds = [];
    }
    page.addEventListener('wheel', (e) => onScroll(e), { passive: false });
    /** A step swaps the words, and the ones under the pointer go. Browsers
     *  go on sending scrolls to the element last under the pointer until the
     *  mouse moves -- now out of the page, so the page never hears them and
     *  the scroll seems dead. Each block of words (and each arc of the ring)
     *  gets a listener of its own, which still hears them once it has gone. */
    const catchScrolls = (els: Iterable<Element>) => {
      for (const el of els) el.addEventListener('wheel', (e) => onScroll(e as WheelEvent, true), { passive: false });
    };

    // ↑ ↓ and ← → walk the path, back and on, anywhere but in a control
    // that takes the arrows itself: a slider, the tabs, the map.
    const STEP: Record<string, 1 | -1> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
    addEventListener('keydown', (e) => {
      const dir = STEP[e.key];
      if (!dir || e.metaKey || e.ctrlKey || e.altKey) return;
      const t = e.target as Element;
      if (t.closest('input, [role="tablist"], #map')) return;
      e.preventDefault();
      go(stepBy(plan, place, dir));
    });

    // ---- The column's shape ----------------------------------------------------
    /** Each block as wide as the disc allows where it sits on screen: full
     *  width across the middle, narrower towards the top and bottom. Measured
     *  in one pass and set in another, so the page lays out once; run twice,
     *  as a narrower block may be taller. */
    function fitOnce() {
      const blocks = [...column.querySelectorAll<HTMLElement>('.fit'), ...panel.querySelectorAll<HTMLElement>(':scope > *')];
      const box = card.getBoundingClientRect();
      const cy = innerHeight / 2;
      const widths = blocks.map((b) => {
        const r = b.getBoundingClientRect();
        let y0 = r.top, y1 = r.bottom;
        // Cut off at the card's foot: only as wide as that edge allows.
        if (card.contains(b)) (y0 = Math.min(Math.max(y0, box.top), box.bottom)), (y1 = Math.min(Math.max(y1, box.top), box.bottom));
        const y = Math.abs(y0 - cy) > Math.abs(y1 - cy) ? y0 : y1;
        return Math.max(180, wheel.edgeAt(y) - r.left);
      });
      blocks.forEach((b, i) => (b.style.maxWidth = `${Math.round(widths[i])}px`));
    }
    /** Whether the panel's last block ends inside the card. */
    const fits = () => {
      const last = panel.lastElementChild?.getBoundingClientRect();
      return !last || last.bottom <= card.getBoundingClientRect().bottom;
    };
    /** The column shaped to the curve, and a panel that still runs past the
     *  card's foot set a step smaller, down to about 12px text; one that
     *  still won't fit scrolls, as a last resort. */
    function fit() {
      let k = 1;
      card.classList.remove('scrolls');
      card.scrollTop = 0;
      panel.style.fontSize = '';
      fitOnce();
      fitOnce();
      while (!fits() && k > 0.86) {
        k -= 0.035;
        panel.style.fontSize = `${16 * k}px`;
        fitOnce();
        fitOnce();
      }
      card.classList.toggle('scrolls', !fits());
    }
    function layout() {
      wheel.build();
      column.style.width = `${Math.round(Math.max(280, Math.min(640, wheel.edgeAt(innerHeight / 2) - 40)))}px`;
      page.style.setProperty('--reach', `${wheel.reach}px`);
      page.style.setProperty('--mid', `${(wheel.reach + innerWidth) / 2}px`);
      fit();
      placeNav();
    }
    /** The links beside the logo, centred in the gap between it and the
     *  targets' circles on the track at their height. */
    function placeNav() {
      const top = document.getElementById('top')!;
      const nav = top.querySelector<HTMLElement>('.site-nav')!;
      const logo = top.querySelector('.logo')!.getBoundingClientRect();
      const box = top.getBoundingClientRect();
      const n = nav.getBoundingClientRect();
      const mid = (logo.right + wheel.trackAt(n.top + n.height / 2)) / 2;
      nav.style.left = `${Math.round(Math.max(logo.right + 12, mid - n.width / 2) - box.left)}px`;
    }
    document.fonts?.ready.then(placeNav);
    // Scrolled, as a last resort on a short screen: the blocks keep to the
    // curve where they now sit.
    let scrollFrame = 0;
    card.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(scrollFrame);
        scrollFrame = requestAnimationFrame(fitOnce);
      },
      { passive: true },
    );
    let resizing = 0;
    addEventListener('resize', () => {
      clearTimeout(resizing);
      resizing = window.setTimeout(() => {
        layout();
        const p = ring.shown ? ringPlace() : null;
        if (p) ring.place(p);
        wheel.show(place.goal, place.target && goalOf(plan, place.target) >= 0 ? place.target : null, TABS.indexOf(place.tab) + 1);
      }, 80);
    });

    // ---- The map ---------------------------------------------------------------
    maplibregl.setWorkerUrl(workerUrl);
    maplibregl.addProtocol('pmtiles', new Protocol().tile);
    const [[w, s], [e, n]] = cfg.limit;
    const ROOM: [LngLat, LngLat] = [[w - (e - w), s - (n - s)], [e + (e - w), n + (n - s)]];
    // Where the maps open: Squamish in the middle of the part of the map
    // right of the ring, with Howe Sound below it and the Squamish valley
    // above.
    const SQUAMISH: [LngLat, LngLat] = [[-123.72, 49.35], [-122.59, 50.05]];
    const framing = () => ({ top: 30, bottom: 30, left: wheel.reach + 30, right: 30 });
    layout();
    const map = new maplibregl.Map({
      container: mapEl,
      bounds: SQUAMISH,
      maxBounds: ROOM,
      fitBoundsOptions: { padding: framing() },
      maxZoom: 15,
      attributionControl: false,
      dragRotate: false,
      style: studyStyle({ basemap: abs(cfg.basemap), glyphs: abs(cfg.glyphs), limit: cfg.limit }),
    });
    map.addControl(new maplibregl.AttributionControl({ compact: true, customAttribution: 'TerrAdapt-Cascadia, Nature Squamish' }), 'bottom-right');
    map.once('load', () => mapEl.querySelector('.maplibregl-ctrl-attrib')?.classList.remove('maplibregl-compact-show'));
    const score = new ScoreLayer('score');
    map.on('load', () => {
      addRelief(map, abs(cfg.terrain));
      addSky(map);
      // Over the land, under the roads and the towns.
      const firstRoad = map.getStyle().layers.find((l) => l.id.startsWith('roads_tunnels'))?.id;
      try {
        map.addLayer(score, firstRoad);
      } catch {
        showNote('<strong>This needs a newer browser</strong>The maps are drawn with WebGL 2.');
      }
    });
    tilting(map, abs(cfg.terrain), document.getElementById('three-d')!, document.getElementById('tilt')!);
    document.getElementById('recentre')!.addEventListener('click', () =>
      map.fitBounds(SQUAMISH, { padding: framing(), pitch: map.getPitch(), bearing: 0, duration: reduce.matches ? 0 : 900 }),
    );
    const opacityIn = document.getElementById('opacity') as HTMLInputElement;
    opacityIn.addEventListener('input', () => {
      fadeRun++;
      shown = Number(opacityIn.value);
      score.setOpacity(shown);
    });

    // ---- Fading from one map to the next ----------------------------------------
    // One layer draws the map, so the change is a fade through the ground:
    // the old map out, the new model in its place, and the new map up once
    // its tiles in view are loaded -- never a half-drawn map fading in.
    /** How strongly the map is drawn right now. */
    let shown = Number(opacityIn.value);
    let fadeRun = 0;
    const OUT = 220, IN = 380, WAIT = 2500;
    function fadeOpacity(to: number, ms: number, run: number, done?: () => void) {
      // Nothing to fade (already there, or no time to do it in): straight
      // there. A zero-length fade would divide by nothing, and a frame's time
      // can come before t0, which left the fade -- and the new map waiting on
      // it -- never finishing.
      if (ms <= 0 || Math.abs(to - shown) < 0.005) {
        shown = to;
        score.setOpacity(shown);
        done?.();
        return;
      }
      const from = shown, t0 = performance.now();
      const frame = (now: number) => {
        if (run !== fadeRun) return;
        const x = Math.max(0, Math.min(1, (now - t0) / ms));
        shown = from + (to - from) * x * (2 - x);
        score.setOpacity(shown);
        if (x < 1) requestAnimationFrame(frame);
        else done?.();
      };
      requestAnimationFrame(frame);
    }
    /** Up once nothing in view is still to come, or after WAIT regardless. */
    function whenLoaded(run: number, go: () => void) {
      const t0 = performance.now();
      let frames = 0;
      const check = () => {
        if (run !== fadeRun) return;
        // A frame or two first, for the layer to see what the new model wants.
        if (++frames > 2 && (score.pending === 0 || performance.now() - t0 > WAIT)) return go();
        map.triggerRepaint();
        requestAnimationFrame(check);
      };
      requestAnimationFrame(check);
    }
    /** The map changed to whatever `apply` sets up, faded; `on` says whether
     *  there is a map to fade up afterwards. */
    function fadeTo(apply: () => void, on: boolean) {
      const run = ++fadeRun;
      if (reduce.matches || !map.loaded()) {
        apply();
        shown = on ? Number(opacityIn.value) : 0;
        score.setOpacity(shown);
        return;
      }
      fadeOpacity(0, shown > 0.01 ? OUT : 0, run, () => {
        apply();
        if (on) whenLoaded(run, () => fadeOpacity(Number(opacityIn.value), IN, run));
      });
    }

    const legend = document.getElementById('legend')!;
    const mapTitle = document.getElementById('map-title')!;
    const mapSrc = document.getElementById('map-src')!;
    const note = document.getElementById('map-note')!;
    const key = document.getElementById('key')!;
    const links = document.getElementById('links')!;
    function showNote(html: string | null) {
      note.hidden = !html;
      note.innerHTML = html ?? '';
      if (html !== null) hideDocs();
    }

    // ---- Documents, stacked ------------------------------------------------------
    const docsEl = document.getElementById('docs')!;
    const stackEl = document.getElementById('stack')!;
    /** The documents in the stack, front first. */
    let stack: string[] = [];
    const btnsEl = document.getElementById('doc-btns')!;
    /** A document to read, or a site to visit. */
    const isPdf = (href: string) => /\.pdf($|[?#])/i.test(href);
    const SHUFFLE = 650;
    const dimEl = document.getElementById('dim')!;
    function hideDocs() {
      docsEl.hidden = true;
      dimEl.classList.remove('on');
      stack = [];
    }
    /** Where each card sits: the front one square on, each behind it up,
     *  to the right, turned a little and darker. */
    const spot = (i: number) => `translate(${i * 16}%, ${-i * 7}%) rotate(${i * 5}deg) scale(${1 - i * 0.05})`;
    function placeCards() {
      stackEl.querySelectorAll<HTMLElement>('.doc').forEach((card) => {
        const i = stack.indexOf(card.dataset.doc!);
        card.style.transform = spot(i);
        card.style.zIndex = String(stack.length - i);
        card.style.filter = `brightness(${1 - i * 0.3})`;
        card.classList.toggle('front', i === 0);
        const tool = cfg.tools[card.dataset.doc!];
        // The front one opens the document, where it's online; one behind
        // comes forward.
        const img = `<img src="${cfg.covers[card.dataset.doc!].src}" alt="" />`;
        card.innerHTML =
          i === 0
            ? tool.href
              ? `<a href="${esc(tool.href)}" target="_blank" rel="noopener" aria-label="Open ${esc(tool.title ?? tool.name)}${isPdf(tool.href) ? ' (PDF)' : ''}" title="${esc(tool.name)}: ${isPdf(tool.href) ? 'open the PDF' : 'visit the website'}">${img}</a>`
              : `<div role="img" aria-label="${esc(tool.title ?? tool.name)}, not online yet" title="${esc(tool.name)}: not online yet">${img}</div>`
            : `<button type="button" aria-label="Bring ${esc(tool.name)} to the front" title="${esc(tool.name)}: bring forward"><img src="${cfg.covers[card.dataset.doc!].src}" alt="" /></button>`;
      });
      drawButtons();
    }
    /** Under the stack, floating: open the one in front, and bring the
     *  next one round. */
    function drawButtons() {
      const tool = cfg.tools[stack[0]];
      btnsEl.innerHTML =
        (tool.href
          ? `<a class="open" href="${esc(tool.href)}" target="_blank" rel="noopener">${isPdf(tool.href) ? 'Read the PDF' : 'Visit the website'} ↗</a>`
          : '<span class="soon">Not online yet</span>') +
        (stack.length > 1 ? `<button type="button" class="next" id="doc-next">Next document (${stack.length})</button>` : '');
    }
    btnsEl.addEventListener('click', (e) => {
      if ((e.target as Element).closest('#doc-next') && stack.length > 1) {
        bringForward(stack[1]);
        document.getElementById('doc-next')?.focus();
      }
    });
    /** The documents shown, `docs[0]` in front. The same documents already
     *  showing are shuffled rather than drawn again. */
    function showDocs(docs: string[]) {
      docsEl.hidden = false;
      dimEl.classList.add('on');
      const same = stack.length === docs.length && docs.every((d) => stack.includes(d));
      if (same) return bringForward(docs[0]);
      stack = docs;
      stackEl.innerHTML = docs.map((d) => `<figure class="doc" data-doc="${d}"></figure>`).join('');
      catchScrolls(stackEl.children);
      placeCards();
    }
    /** One card to the front: it lifts out to the left, over the rest, and
     *  settles on top as the others move back a place. */
    function bringForward(id: string) {
      const from = stack.indexOf(id);
      if (from <= 0) return placeCards();
      stack = [id, ...stack.filter((d) => d !== id)];
      const card = stackEl.querySelector<HTMLElement>(`.doc[data-doc="${id}"]`)!;
      if (reduce.matches || !card.animate) return placeCards();
      card.style.transition = 'none';
      const lift = card.animate(
        [
          { transform: spot(from), filter: `brightness(${1 - from * 0.3})` },
          { transform: 'translate(-58%, -6%) rotate(-8deg) scale(1.02)', filter: 'brightness(1)', offset: 0.45 },
          { transform: spot(0), filter: 'brightness(1)' },
        ],
        { duration: SHUFFLE, easing: 'cubic-bezier(0.3, 0.7, 0.2, 1)' },
      );
      // Over the others once it is clear of them.
      setTimeout(() => (card.style.zIndex = String(stack.length + 1)), SHUFFLE * 0.4);
      placeCards();
      card.style.transform = spot(0);
      // Still behind them as it starts to lift.
      card.style.zIndex = String(stack.length - from);
      lift.onfinish = () => {
        card.style.transition = '';
        card.style.zIndex = String(stack.length);
      };
    }
    stackEl.addEventListener('click', (e) => {
      const b = (e.target as Element).closest('button');
      const card = b?.closest<HTMLElement>('.doc');
      if (card) bringForward(card.dataset.doc!);
    });
    /** The map to draw for where you are: the one chosen, or a target's first
     *  that can be drawn; for a goal, the first drawable map among its
     *  targets. Null where the work is carried by people and tools. */
    function currentMap(): string | null {
      const drawable = (id: string) => !cfg.maps[id].updating;
      if (place.target) {
        const ids = mapsOf(byId.get(place.target)!);
        if (place.map && ids.includes(place.map)) return place.map;
        return ids.find(drawable) ?? ids[0] ?? null;
      }
      return plan[place.goal].flatMap((id) => mapsOf(byId.get(id)!)).find(drawable) ?? null;
    }
    let linkRun = 0;
    /** What the map shows now, so a new tab on the same map doesn't fade it. */
    let drawnFor = '';
    function showMap() {
      if (place.home) {
        // Home: the landscape on its own.
        if (drawnFor === 'home') return;
        drawnFor = 'home';
        ++linkRun;
        links.innerHTML = '';
        fadeTo(() => score.setModel([], 'mean'), false);
        legend.hidden = true;
        showNote(null);
        hideDocs();
        return;
      }
      const id = currentMap();
      const t = place.target ? byId.get(place.target)! : null;
      const g = goalsList[place.goal];
      const key_ = id ?? `note:${place.target ?? g.id}`;
      if (key_ === drawnFor) return;
      drawnFor = key_;
      const me = ++linkRun;
      links.innerHTML = '';
      const m = id ? cfg.maps[id] : null;
      if (!m || m.updating) {
        fadeTo(() => score.setModel([], 'mean'), false);
        legend.hidden = true;
        if (m) return showNote(`<span class="nt-h">Map being updated</span><strong>${esc(m.title)}</strong>${esc(m.about)}`);
        // No map, and nothing missing: the work is carried by people and
        // tools. Where some are documents, the documents, stacked, with this
        // target's own in front; otherwise a list of what carries it.
        const tools = [...new Set((t ? [t] : plan[place.goal].map((x) => byId.get(x)!)).flatMap(toolsOf))];
        const around = t?.goal ? plan[place.goal].map((x) => byId.get(x)!) : t ? [t] : plan[place.goal].map((x) => byId.get(x)!);
        const docs = [...new Set([...tools, ...around.flatMap(toolsOf)])].filter((x) => cfg.covers[x]);
        if (docs.length) {
          showNote(null);
          return showDocs(docs);
        }
        return showNote(
          `<span class="nt-h">People and tools</span><strong>${esc(t ? t.name : `${g.id} · ${g.name}`)}</strong>` +
            `${t ? 'Carried by' : 'This goal works through'}:<ul>${tools.map((x) => `<li>${esc(cfg.tools[x].name)}</li>`).join('')}</ul>`,
        );
      }
      showNote(null);
      hideDocs();
      legend.hidden = false;
      const model = modelFor(m, layers, cfg.frameworks.posterKey);
      const stops = model.bivariate ? null : paletteById(m.palette ?? null).stops;
      fadeTo(() => {
        score.setModel(model.criteria, 'mean');
        score.setBivariate(model.bivariate);
        if (stops) score.setPalette(stops);
      }, true);
      mapTitle.textContent = m.title;
      mapSrc.textContent = [m.source, `Data Sandbox model${m.version ? `, ${m.version}` : ''}`].filter(Boolean).join(' · ');
      if (model.bivariate) {
        const k = cfg.frameworks.posterKey;
        let cells = '';
        for (let row = 2; row >= 0; row--) for (let col = 0; col < 3; col++) cells += `<i style="background:${k[row * 3 + col]}"></i>`;
        key.innerHTML = `<div class="bi"><div class="grid" aria-hidden="true">${cells}</div><div class="axes"><span>Up: <b>${esc(m.axes![1])}</b></span><span>Across: <b>${esc(m.axes![0])}</b></span></div></div>`;
      } else {
        key.innerHTML = `<div class="ramp" style="background:linear-gradient(90deg, ${stops!.map(rgb).join(', ')})"></div><div class="ends"><span>${esc(m.ends![0])}</span><span>${esc(m.ends![1])}</span></div>`;
      }
      // The same model, opened in the Sandbox. The link is made as the model
      // is deflated: a moment, and a newer map wins.
      encodeSaved(model.saved).then((hash) => {
        if (me !== linkRun) return;
        links.innerHTML =
          `<a href="${esc(cfg.sandbox)}#${hash}" target="_blank" rel="noopener">Test it in the Sandbox</a>` +
          `<a href="${esc(cfg.explore)}" target="_blank" rel="noopener">See it on the ground</a>`;
      });
    }

    // Nothing here scrolls but the card, when it must. A browser still
    // scrolls a page to show something focused off its edge (a chip at the
    // top of the ring); put it back.
    for (const box of [page, document.documentElement, document.body])
      box.addEventListener('scroll', () => (box.scrollTop || box.scrollLeft ? box.scrollTo(0, 0) : null), { passive: true });
    addEventListener('scroll', () => (scrollX || scrollY) && scrollTo(0, 0), { passive: true });

    // Straight onto the place the address asked for: home, unless it says.
    go(place, !!place.home);
  }
</script>
