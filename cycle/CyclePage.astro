---
import { getEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import 'maplibre-gl/dist/maplibre-gl.css';
import Shell from '../shared/layouts/Shell.astro';
import PhoneGate from '../shared/components/PhoneGate.astro';
import { asset, tile } from '../shared/lib/paths';
import { readCycle } from './lib/content';

/** What EcoScapes is doing, how, and how it connects to the bigger picture:
 *  a wheel of the four EcoScapes goals (ES.1–ES.4), each with its targets,
 *  and for each target what it is, the maps and tools that drive action on
 *  it, and the ladder up through Canada 2030 to the global framework. Maps
 *  are drawn live by the Data Sandbox's own scoring, so the two never
 *  disagree. The words are all in cycle/content/, checked at build
 *  (lib/content.ts). A computer or tablet only for now: a phone gets the
 *  gate. Not linked from anywhere yet, and kept out of search engines. */
const entry = await getEntry('ecoscapes', 'sea-to-sky');
if (!entry) throw new Error('map/content/sea-to-sky.md is missing');
const { data } = entry;
const cycle = readCycle();

// Documents' covers (content/docs/), each at the size it's shown and as a
// small thumbnail for the How tab.
const docImages = import.meta.glob<ImageMetadata>('./content/docs/*.{png,jpg,jpeg,webp}', { eager: true, import: 'default' });
const covers: Record<string, { src: string; thumb: string }> = {};
for (const [id, tool] of Object.entries(cycle.tools)) {
  if (!tool.cover) continue;
  const meta = docImages[`./content/docs/${tool.cover}`];
  if (!meta) throw new Error(`cycle/content/tools.json: ${id}'s cover "${tool.cover}" isn't in cycle/content/docs/`);
  covers[id] = {
    src: (await getImage({ src: meta, width: Math.min(760, meta.width), format: 'webp', quality: 82 })).src,
    thumb: (await getImage({ src: meta, width: 96, format: 'webp', quality: 80 })).src,
  };
}

const config = {
  bounds: data.bounds,
  limit: data.limit,
  basemap: tile(data.basemap),
  terrain: tile('/tiles/terrain.pmtiles'),
  glyphs: asset('/tiles/fonts/{fontstack}/{range}.pbf'),
  sandbox: asset('/ecoscapes-dst/'),
  explore: asset('/map/'),
  covers,
  ...cycle,
};
---
<Shell title="EcoScapes Goals" description="What EcoScapes is doing toward 30×30, how, and how it fits the bigger picture: four goals, their targets, and the maps and tools behind each." noindex gate>
  <PhoneGate name="Goals" text="The EcoScapes Goals page is designed for a computer or a tablet. Send yourself the link and open it there, or take a look at our map explorer on your phone now." />

  <main class="cycle" id="cycle">
    <div class="map" id="map" data-config={JSON.stringify(config)}></div>

    <!-- Where there's no map to draw: how the work is carried instead, in
         the middle of the map showing. -->
    <div class="map-note" id="map-note" hidden></div>
    <!-- Where the work is a document: the map darkened, and the documents
         stacked over it, to open. -->
    <div class="dim" id="dim"></div>
    <div class="docs" id="docs" hidden>
      <div class="stack" id="stack"></div>
      <div class="doc-btns" id="doc-btns"></div>
    </div>

    <!-- The map's legend, top right, as on the Data Sandbox: what the map is,
         its key and strength, and where to take it next. -->
    <details class="legend" id="legend" open hidden>
      <summary><h2>Legend</h2><svg class="sum-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg></summary>
      <h3 class="lg-title" id="map-title"></h3>
      <p class="lg-src" id="map-src"></p>
      <div class="lg-key" id="key"></div>
      <label class="lg-strength">Strength <input id="opacity" type="range" min="0.2" max="1" step="0.05" value="0.85" /></label>
      <div class="lg-links" id="links"></div>
    </details>

    <!-- Down the right, as on the other maps. -->
    <div class="map-side">
      <!-- Flat, or the map laid over the ground's own shape, with the tilt
           sliding out of the button while 3D is on. -->
      <div class="tilt-wrap">
        <label class="tilt" id="tilt" aria-hidden="true">
          <span>Tilt</span>
          <input type="range" min="0" max="80" step="1" value="60" tabindex="-1" aria-label="Tilt" />
        </label>
        <button class="step" id="three-d" type="button" aria-pressed="false" aria-label="3D view" title="3D view"><span class="step-text">3D</span></button>
      </div>
      <button class="step" id="recentre" type="button" aria-label="Back to Squamish" title="Back to Squamish">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9V5a1 1 0 011-1h4M15 4h4a1 1 0 011 1v4M20 15v4a1 1 0 01-1 1h-4M9 20H5a1 1 0 01-1-1v-4" /><circle cx="12" cy="12" r="2.2" />
        </svg>
      </button>
    </div>

    <!-- The disc, its ring of goals and the buttons on it (lib/wheel.ts). -->
    <svg class="wheel" id="wheel" role="group" aria-label="The four EcoScapes goals and their targets"></svg>

    <!-- Inside the disc: a goal and its targets, or one target and its tabs;
         at the foot, all four goals and what supports them. -->
    <div class="column" id="column">
      <!-- Out of the words, which fade on every change: the logo stays, and
           beside it the way to the rest of EcoScapes. -->
      <div class="top" id="top">
        <a class="logo-link" id="logo-link" href={asset('/ecoscapes/')} title="About this page"><img class="logo" src={asset('/img/ecoscapes-logo-white.png')} alt="EcoScapes goals: about this page" width="800" height="184" /></a>
        <nav class="site-nav" aria-label="EcoScapes">
          <a href="https://ecoscapes.naturesquamish.ca">EcoScapes</a>
          <a href={asset('/map/')}>Explore</a>
          <a href={asset('/ecoscapes-dst/')}>Sandbox</a>
        </nav>
      </div>
      <div class="words" id="words">
        <div class="eyebrow fit" id="eyebrow"></div>
        <h1 class="fit" id="title"></h1>
        <p class="lede fit" id="lede"></p>
        <div class="card" id="card">
          <div class="tabs fit" role="tablist" aria-label="About this target" id="tabs">
            <button type="button" role="tab" id="tab-what" data-tab="what" aria-controls="panel" title="What this target is about">Focus</button>
            <button type="button" role="tab" id="tab-how" data-tab="how" aria-controls="panel" title="The maps and tools that deliver it">Achieve</button>
            <button type="button" role="tab" id="tab-bigger" data-tab="bigger" aria-controls="panel" title="How it lines up with Canada 2030 and the global framework">Align</button>
          </div>
          <div class="tabpane" id="panel" tabindex="0"></div>
        </div>
      </div>
      <!-- The goals bar as a ring, for what supports every goal (lib/goal-ring.ts). -->
      <svg class="goal-ring" id="goal-ring" aria-label="The four goals this supports"></svg>
      <div class="foot fit">
        <h2>EcoScapes goals</h2>
        <div class="goal-nav" id="goal-nav">
          {cycle.frameworks.goals.map((g, i) => <button type="button" data-goal={i} style={`--c:${g.colour}`} title={`${g.id}: ${g.name}`}><i></i>{g.id}</button>)}
        </div>
        <div class="extra" id="extra">
          {cycle.targets.filter((t) => t.supplementary).map((t) => (
            <button type="button" data-target={t.id}>{t.name}<span>All goals</span></button>
          ))}
          <button type="button" class="home" id="home" aria-label="About this page" title="About this page">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 11l8-6.5 8 6.5M6.5 9.5V19h11V9.5" /><path d="M10 19v-5h4v5" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </main>
</Shell>

<style>
  /* Dressed as the Data Sandbox and the map are: their cards, their small
     capital headings, their buttons, and the accent for what is chosen. */
  .cycle {
    position: relative; height: 100dvh;
    /* Clipped, not only hidden: a chip or goal focused part-way off screen
       would otherwise scroll the whole page aside to show it. */
    overflow: clip;
    /* The disc: the site's own dark at 95%, so the map only just shows
       through. */
    --disc: rgba(13, 18, 16, 0.95);
    --card: rgba(13, 18, 16, 0.9);
    --reach: 42vw;
    --mid: 71vw;
  }
  /* A phone, upright or on its side: the gate instead. The same test is in
     the script, which then stops before the map. */
  @media (pointer: coarse) and (max-width: 599px), (pointer: coarse) and (max-height: 599px) {
    .cycle { display: none; }
  }
  .map { position: absolute; inset: 0; background: var(--bg); }
  .map :global(.maplibregl-ctrl-bottom-right) { right: calc(0.9rem - 10px); }

  /* ---- The legend, top right --------------------------------------------- */
  .legend {
    position: absolute; z-index: 4; right: 0.9rem; top: calc(var(--safe-t) + 1rem); width: 19rem;
    padding: 0.8rem 0.95rem 0.85rem; border-radius: 14px; border: 1px solid var(--line);
    background: var(--card); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  .legend summary { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; list-style: none; cursor: pointer; }
  .legend summary::-webkit-details-marker { display: none; }
  .legend h2 { margin: 0; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-dim); }
  .sum-chev { flex: none; width: 14px; height: 14px; color: var(--ink-dim); transition: transform 0.15s; }
  .legend summary:hover h2, .legend summary:hover .sum-chev { color: var(--ink); }
  .legend[open] .sum-chev { transform: rotate(180deg); }
  .legend[open] summary { margin-bottom: 0.55rem; }
  .legend summary:focus { outline: none; }
  .legend summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
  .lg-title { margin: 0; font-size: 0.95rem; line-height: 1.3; }
  .lg-src { margin: 0.15rem 0 0.7rem; font-size: 0.72rem; line-height: 1.4; color: var(--ink-dim); }
  .lg-key :global(.ramp) { display: block; height: 10px; border-radius: 5px; }
  .lg-key :global(.ends) { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.25rem; font-size: 0.7rem; color: var(--ink-dim); }
  .lg-key :global(.bi) { display: flex; align-items: center; gap: 0.8rem; }
  .lg-key :global(.grid) { display: grid; grid-template-columns: repeat(3, 1.6rem); grid-auto-rows: 1.1rem; gap: 2px; }
  .lg-key :global(.grid i) { border-radius: 3px; }
  .lg-key :global(.axes) { display: grid; gap: 0.3rem; font-size: 0.72rem; color: var(--ink-dim); }
  .lg-key :global(.axes b) { font-weight: 600; color: var(--ink); }
  .lg-strength { display: grid; gap: 0.3rem; margin-top: 0.8rem; font-size: 0.72rem; color: var(--ink-dim); }
  .lg-strength input { width: 100%; margin: 0; accent-color: var(--accent); }
  .lg-links { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; margin-top: 0.8rem; }
  .lg-links:empty { display: none; }
  .lg-links :global(a) {
    padding: 0.5rem 0.6rem; border-radius: 10px; border: 1px solid var(--line); background: var(--bg-lift);
    font-size: 0.78rem; line-height: 1.25; text-align: center; text-decoration: none;
  }
  .lg-links :global(a:hover) { border-color: var(--accent); color: var(--accent); }
  .lg-links :global(a:focus) { outline: none; }
  .lg-links :global(a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Where there's no map to draw, in the middle of the map showing. */
  .map-note {
    position: absolute; z-index: 1; top: 50%; left: var(--mid); transform: translate(-50%, -50%);
    width: min(22rem, calc(100vw - var(--reach) - 4rem)); padding: 1rem 1.1rem; border-radius: 14px;
    border: 1px solid var(--line); background: var(--card); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    font-size: 0.88rem; line-height: 1.5; color: var(--ink-dim); pointer-events: none;
  }
  .map-note :global(.nt-h) { display: block; margin-bottom: 0.3rem; font-size: 0.68rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); }
  .map-note :global(strong) { display: block; margin-bottom: 0.35rem; font-size: 1rem; color: var(--ink); }
  .map-note :global(ul) { margin: 0.5rem 0 0; padding: 0; list-style: none; display: grid; gap: 0.25rem; }
  .map-note :global(li) { display: flex; gap: 0.5rem; align-items: baseline; color: var(--ink); font-size: 0.85rem; }
  .map-note :global(li::before) { content: ''; flex: none; width: 7px; height: 7px; border-radius: 50%; border: 1.5px solid var(--accent); transform: translateY(-1px); }

  /* Documents, stacked where the map would be: the one in front to open,
     the ones behind to bring forward. */
  .docs {
    position: absolute; z-index: 1; gap: 1.1rem; top: 50%; left: var(--mid); transform: translate(-50%, -50%);
    display: flex; flex-direction: column; align-items: center; gap: 1.4rem;
  }
  /* The map dimmed under the documents, so they're what you look at. */
  .dim {
    position: absolute; z-index: 1; inset: 0; background: rgba(5, 8, 7, 0.62);
    opacity: 0; pointer-events: none; transition: opacity 0.35s;
  }
  .dim.on { opacity: 1; }
  .stack {
    --w: min(28rem, 33vw, calc((100dvh - 11rem) * 0.774));
    position: relative; width: var(--w); aspect-ratio: 1 / 1.29;
    /* Room for the ones behind, which sit up and to the right. */
    margin: 1.6rem 3.4rem 0 0;
  }
  .stack :global(.doc) {
    position: absolute; inset: 0; margin: 0; border-radius: 4px; overflow: hidden;
    background: var(--bg-lift); box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.08);
    transform-origin: 50% 100%;
    transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.55s;
  }
  .stack :global(.doc img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .stack :global(.doc a), .stack :global(.doc button) { display: block; width: 100%; height: 100%; padding: 0; border: 0; background: none; cursor: pointer; }
  .stack :global(.doc.front) { box-shadow: 0 24px 50px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.12); }
  .stack :global(.doc.front:hover) { box-shadow: 0 24px 50px rgba(0, 0, 0, 0.6), 0 0 0 2px var(--accent); }
  .stack :global(.doc:not(.front):hover) { filter: brightness(0.85) !important; }
  .stack :global(.doc a:focus), .stack :global(.doc button:focus) { outline: none; }
  .stack :global(.doc a:focus-visible), .stack :global(.doc button:focus-visible) { outline: 3px solid var(--accent); outline-offset: -3px; }

  /* Floating under the covers: the maps' buttons, on a dark glass. */
  .doc-btns { display: flex; justify-content: center; gap: 0.5rem; }
  .doc-btns :global(.open), .doc-btns :global(.next), .doc-btns :global(.soon) {
    appearance: none; padding: 0.6rem 1rem; border-radius: 999px; font: inherit; font-size: 0.85rem; font-weight: 600;
    text-decoration: none; backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  .doc-btns :global(.open) { border: 1px solid var(--accent); background: rgba(13, 18, 16, 0.85); color: var(--accent); }
  .doc-btns :global(.open:hover) { background: rgba(127, 209, 166, 0.16); }
  .doc-btns :global(.next) { border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(13, 18, 16, 0.85); color: var(--ink); cursor: pointer; }
  .doc-btns :global(.next:hover) { border-color: var(--accent); color: var(--accent); }
  .doc-btns :global(.soon) { border: 1px dashed var(--line); background: rgba(13, 18, 16, 0.85); color: var(--ink-dim); font-weight: 400; }
  .doc-btns :global(.open:focus), .doc-btns :global(.next:focus) { outline: none; }
  .doc-btns :global(.open:focus-visible), .doc-btns :global(.next:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Down the right, over the attribution. */
  .map-side {
    position: absolute; z-index: 4; right: 0.9rem; bottom: calc(1rem + 30px);
    display: flex; flex-direction: column; gap: 0.6rem;
  }

  /* ---- The disc and its ring of goals ------------------------------------ */
  .wheel { position: absolute; z-index: 2; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  /* The disc keeps its drags to itself: the map moves only where it shows. */
  .wheel :global(.disc) { fill: var(--disc); pointer-events: auto; }
  .wheel :global(.ring) { pointer-events: auto; cursor: grab; touch-action: none; }
  .wheel :global(.ring:active) { cursor: grabbing; }
  .wheel :global(.track) { fill: none; stroke: var(--line); stroke-dasharray: 2 7; }
  /* Each goal in its own colour: dimmed beside the one you're on. */
  .wheel :global(.seg) { cursor: pointer; outline: none; }
  .wheel :global(.seg path) { opacity: 0.35; transition: opacity 0.2s; }
  .wheel :global(.seg:hover path) { opacity: 0.6; }
  .wheel :global(.arc.on .seg path) { opacity: 1; stroke: var(--ink); stroke-width: 1.5; }
  .wheel :global(.seg:focus-visible path) { opacity: 1; stroke: var(--accent); stroke-width: 3; }
  /* The goal's targets' icons on its arc: darker than it, like a watermark. */
  .wheel :global(.seg-marks) { fill: #000; opacity: 0.04; pointer-events: none; transition: opacity 0.2s; }
  .wheel :global(.seg:hover .seg-marks) { opacity: 0.06; }
  .wheel :global(.arc.on .seg-marks) { opacity: 0.1; }
  /* ES.4's orange is the lightest, so the same black shows more on it. */
  .wheel :global(.seg[data-goal="3"] .seg-marks) { opacity: 0.025; }
  .wheel :global(.seg[data-goal="3"]:hover .seg-marks) { opacity: 0.04; }
  .wheel :global(.arc.on .seg[data-goal="3"] .seg-marks) { opacity: 0.06; }
  /* 25px: LABEL_SIZE in lib/wheel.ts. */
  .wheel :global(.seg-n) { fill: #fff; font-family: ui-rounded, 'SF Pro Rounded', 'Arial Rounded MT Bold', system-ui, sans-serif; font-size: 22px; font-weight: 700; letter-spacing: 0.08em; pointer-events: none; opacity: 0.7; }
  .wheel :global(.arc.on .seg-n) { opacity: 1; }
  .wheel :global(.chip) { cursor: pointer; outline: none; opacity: 0.35; transition: opacity 0.18s; }
  .wheel :global(.arc.on .chip), .wheel :global(.chip:hover), .wheel :global(.chip:focus-visible) { opacity: 1; }
  .wheel :global(.chip circle) { stroke: var(--bg); stroke-width: 3; }
  .wheel :global(.chip.sel circle) { stroke: var(--ink); }
  .wheel :global(.chip:focus-visible circle) { stroke: var(--accent); }
  /* The ring round a target: Focus, Achieve, Align, lit as you go. */
  .wheel :global(.prog-bg) { fill: none; stroke: var(--line); stroke-width: 2.5; stroke-linecap: round; }
  /* Drawn round from its start as it fills; when several fill at once, each
     after the one before (the delay is set in lib/wheel.ts). */
  .wheel :global(.prog) {
    fill: none; stroke: var(--gc, var(--accent)); stroke-width: 2.5; stroke-linecap: round;
    stroke-dasharray: 1 1; stroke-dashoffset: 1; transition: stroke-dashoffset 0.2s ease-in;
  }
  .wheel :global(.prog.done) { stroke-dashoffset: 0; transition: stroke-dashoffset 0.4s linear; }
  @media (prefers-reduced-motion: reduce) { .wheel :global(.prog), .wheel :global(.prog.done) { transition: none; } }
  .wheel :global(.chip text) { font-size: 11px; font-weight: 700; pointer-events: none; }
  /* Back and on: the maps' round buttons. */
  .wheel :global(.nav) { pointer-events: auto; cursor: pointer; outline: none; }
  .wheel :global(.nav-body) { fill: var(--bg-lift); stroke: rgba(255, 255, 255, 0.2); stroke-width: 1; transition: stroke 0.18s; }
  .wheel :global(.nav:hover .nav-body) { stroke: var(--accent); }
  .wheel :global(.nav:focus-visible .nav-body) { stroke: var(--accent); stroke-width: 2; }
  .wheel :global(.nav-arrow) { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .wheel :global(.nav:hover .nav-arrow) { stroke: var(--accent); }

  /* ---- Inside the disc --------------------------------------------------- */
  .column {
    position: absolute; z-index: 3; left: 40px; top: 28px; bottom: 28px; width: 34vw;
    display: flex; flex-direction: column; min-height: 0;
  }
  /* Faded out before new words go in, and back in after: by the script, a
     frame at a time (swap). */
  .words { flex: 1; min-height: 0; display: flex; flex-direction: column; }
  .top { flex: none; position: relative; }
  .logo { display: block; width: 8.5rem; height: auto; }
  .logo-link { display: inline-block; border-radius: 6px; cursor: pointer; }
  .logo-link img { cursor: pointer; -webkit-user-drag: none; user-select: none; }
  .logo-link:focus { outline: none; }
  .logo-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  /* Centred between the logo and the ring by the script (placeNav). */
  .site-nav { position: absolute; top: 50%; left: 10rem; transform: translateY(-50%); display: flex; align-items: center; font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; }
  .site-nav a { padding: 0.2rem 0.6rem; color: var(--ink-dim); text-decoration: none; white-space: nowrap; }
  .site-nav a + a { border-left: 1px solid var(--line); }
  .site-nav a:hover { color: var(--ink); }
  .site-nav a:focus { outline: none; }
  .site-nav a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 3px; }
  .eyebrow { margin: 1rem 0 0; font-size: 0.66rem; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--accent); }
  .eyebrow :global(button) {
    appearance: none; display: inline-flex; align-items: center; gap: 0.45em; padding: 0; border: 0; background: none;
    color: inherit; font: inherit; letter-spacing: inherit; text-transform: inherit; cursor: pointer;
  }
  .eyebrow :global(button:hover) { color: var(--ink); }
  .eyebrow :global(button:focus) { outline: none; }
  .eyebrow :global(button:focus-visible) { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }
  .eyebrow :global(i) { width: 8px; height: 8px; border-radius: 50%; background: var(--c); }
  .column h1 { margin: 0.3rem 0 0.35rem; font-size: 1.55rem; line-height: 1.2; }
  .lede { margin: 0 0 0.9rem; font-size: 0.88rem; line-height: 1.5; color: var(--ink-dim); }
  /* The tab's words fit or are cut back: the text steps down in size first
     (the script), and only a tab that still won't fit scrolls. */
  .card { flex: 1; min-height: 0; overflow: hidden; padding-top: 0.8rem; }
  .card.scrolls { overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  /* The tabs: the Sandbox's control in parts, the chosen part lifted. */
  .tabs {
