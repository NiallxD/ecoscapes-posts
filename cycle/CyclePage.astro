  /* ---- The goals as a ring (lib/goal-ring.ts) ----------------------------- */
  .goal-ring { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; z-index: 1; }
  .goal-ring :global(.gr-arc) { pointer-events: auto; cursor: pointer; outline: none; stroke-width: 5; stroke-linejoin: round; transition: filter 0.18s; }
  .foot.as-ring h2 { visibility: hidden; }
